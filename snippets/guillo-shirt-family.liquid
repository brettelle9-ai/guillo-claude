  elsif printed_handles contains product.handle
    echo printed_handles
  else
    echo 'siracusa-short-sleeve-slim-fit-shirt,guillo-fitted-vulcano-short-sleeve-shirt,turin-short-sleeve-shirt,guillo-rapallo-short-sleeve-shirt'
  endif
-%}
