{%- comment -%}
  ============================================================================
  GUILLO — Complete the look card (cart drawer)
  ----------------------------------------------------------------------------
  One card per garment family. Tapping it opens the options sheet inside the
  drawer (see the sheet markup in sections/guillo-cart-drawer.liquid), where
  the shopper picks a colour and a size and adds to the bag.

  A "family" is the product's Guillo Product Group (custom.product_group):
  every colourway is its own Shopify product, so the sheet's Colour row is
  the group's products, using the group's display names and custom images.
  A product with no group is a family of one, and the Colour row is hidden.

  Accepts:
    product : a Shopify product object (required)
    block   : optional section block (for per-product overrides)
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign group = product.metafields.custom.product_group.value
  assign family = product | sort: 'id'
  assign family_names = blank
  assign family_title = product.title
  if block and block.settings.custom_title != blank
    assign family_title = block.settings.custom_title
  endif
  if group != blank
    assign family = group.products.value
    assign family_names = group.display_names.value
    if group.group_title != blank and block.settings.custom_title == blank
      assign family_title = group.group_title
    endif
  endif

  # Always the product's own first image. The group's custom_images are the
  # PDP swatch crops, which are not the right shape for these cards.
  assign card_image = product.images.first | default: product.featured_image
  assign available_variants = product.variants | where: 'available', true
  assign first_available = available_variants.first
  assign size_label = product.options.first | default: 'Size'
-%}

<article
  class="gcart-card"
  data-gcart-upsell-card
  data-product-id="{{ product.id }}"
  {% if available_variants.size == 0 %}data-sold-out="true"{% endif %}
>
  <button type="button" class="gcart-card__media" data-gcart-pick tabindex="-1" aria-hidden="true">
    {%- if card_image != blank -%}
      {{
        card_image
        | image_url: width: 360
        | image_tag:
          loading: 'lazy',
          widths: '180, 360, 540',
          class: 'gcart-card__img',
          alt: family_title
      }}
    {%- else -%}
      <span class="gcart-card__placeholder">{{ product.title | truncate: 12 }}</span>
    {%- endif -%}
  </button>

  <div class="gcart-card__body">
    <h4 class="gcart-card__title">{{ family_title }}</h4>
    <p class="gcart-card__price">
      {%- if first_available.compare_at_price > first_available.price -%}
        <span class="gcart-card__price--sale">{{ first_available.price | money }}</span>
        <s class="gcart-card__price--was">{{ first_available.compare_at_price | money }}</s>
      {%- else -%}
        {{ first_available.price | money }}
      {%- endif -%}
    </p>
    <div class="gcart-card__row gcart-card__row--solo">
      <button type="button" class="gcart-card__add" data-gcart-pick aria-label="Choose options for {{ family_title | escape }}">
        <span>{% if family.size > 1 %}Select colour and size{% else %}Select size{% endif %}</span>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><path d="M5 8.5h14l-1 12H6z"/><path d="M9 8.5V7a3 3 0 0 1 6 0v1.5"/></svg>
      </button>
    </div>
  </div>

  {%- comment -%} Everything the sheet needs, prices already formatted for the market. {%- endcomment -%}
  <script type="application/json" data-gcart-family>
    {
      "title": {{ family_title | json }},
      "sizeLabel": {{ size_label | json }},
      "colours": [
        {%- for gp in family -%}
          {%- liquid
            assign gp_name = gp.title
            if family_names != blank and family_names[forloop.index0] != blank
              assign gp_name = family_names[forloop.index0]
            endif
            assign gp_first = gp.images.first | default: gp.featured_image
            assign gp_img = ''
            if gp_first != blank
              assign gp_img = gp_first | image_url: width: 600
            endif
            assign gp_avail = gp.variants | where: 'available', true
          -%}
          {
            "name": {{ gp_name | json }},
            "url": {{ gp.url | json }},
            "image": {{ gp_img | json }},
            "available": {% if gp_avail.size > 0 %}true{% else %}false{% endif %},
            "variants": [
              {%- for v in gp.variants -%}
                {
                  "id": {{ v.id }},
                  "title": {{ v.title | json }},
                  "available": {{ v.available }},
                  "price": {{ v.price | money | json }}
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</article>
