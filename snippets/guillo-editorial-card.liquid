{%- liquid
  assign card_image = media_override.settings.image | default: product.featured_image
  assign editorial_url = product.url
  assign is_interest = false
  assign is_preorder = false
  if product.template_suffix contains 'interest'
    assign is_interest = true
  elsif product.template_suffix contains 'pre-order' and product.handle != 'firenze-chevron-shirt'
    assign is_preorder = true
  endif
  assign colour = ''
  assign style = ''
  assign fit = ''
  for tag in product.tags
    if tag contains 'colour:'
      assign colour = tag | remove: 'colour:'
    endif
  endfor
  if product.tags contains 'grandad-collar'
    assign style = 'Grandad collar'
  elsif product.tags contains 'long-sleeve'
    assign style = 'Long sleeve'
  elsif product.tags contains 'short-sleeve'
    assign style = 'Short sleeve'
  endif
  if product.tags contains 'garment:shirt'
    assign fit = 'Athletic fit'
  elsif product.handle contains 'luxe-chino'
    assign fit = 'Tailored fit'
  elsif product.handle contains 'signore-chino'
    assign fit = 'Classic fit, subtly slim'
  elsif product.handle contains 'capri-chino-short'
    assign fit = 'Stretch & lightweight'
  elsif product.handle contains 'portofino'
    assign fit = 'English knit'
    assign style = '100% cotton'
  elsif product.tags contains 'fit:muscle'
    assign fit = 'Muscle fit'
  elsif product.tags contains 'fit:slim'
    assign fit = 'Slim fit'
  endif
  assign rating = product.metafields.reviews.rating.value.rating | plus: 0
  capture size_values
    for variant in product.variants
      echo variant.title
      unless forloop.last
        echo '|'
      endunless
    endfor
  endcapture
  capture available_sizes
    for variant in product.variants
      if variant.available
        echo variant.title
        echo '|'
      endif
    endfor
  endcapture
-%}
<article class="gc-card" {{ media_override.shopify_attributes }} data-gc-card data-name="{{ product.title | escape }}" data-tags="{{ product.tags | join: '|' | escape }}" data-colour="{{ colour | escape }}" data-sizes="{{ size_values | strip | escape }}" data-available-sizes="{{ available_sizes | strip | escape }}" data-handle="{{ product.handle }}" data-available="{{ product.available }}" data-price="{{ product.price }}" data-preorder="{{ is_preorder }}">
  <div class="gc-card__media" data-gc-media>
    <a href="{{ editorial_url }}" class="gc-card__photo" aria-label="View {{ product.title | escape }}">{{ card_image | image_url: width: 1200 | image_tag: widths: '240, 360, 540, 750, 1000, 1200', sizes: '(min-width: 1000px) 25vw, 50vw', loading: image_loading, alt: product.title }}{% render 'guillo-card-video', product: product, media_override: media_override, card_media_default: card_media_default, card_image: card_image %}</a>
    {%- if product.images[1] != blank -%}<a href="{{ editorial_url }}" class="gc-card__photo gc-card__photo--second" aria-label="Another view of {{ product.title | escape }}">{{ product.images[1] | image_url: width: 1200 | image_tag: widths: '240, 360, 540, 750, 1000, 1200', sizes: '(min-width: 1000px) 25vw, 50vw', loading: 'lazy', alt: product.title }}</a>{%- endif -%}
    {%- unless product.available -%}<span class="gc-card__badge">Sold out</span>{%- else -%}{%- if is_preorder -%}<span class="gc-card__badge">Pre-order</span>{%- endif -%}{%- endunless -%}
  </div>
  <div class="gc-card__details">
    <div class="gc-card__title-row"><h2><a href="{{ editorial_url }}">{{ product.title | remove_first: 'The ' | escape }}</a></h2></div>
    {% render 'guillo-family-options', product: product %}
    <p class="gc-card__subtitle">{{ fit }}{% if fit != blank and style != blank %} · {% endif %}{{ style }}{% if colour != blank %}{% if fit != blank or style != blank %} · {% endif %}{{ colour | capitalize }}{% endif %}</p>
    {%- if rating != blank and rating > 0 -%}<span class="gc-card__rating" aria-label="Rated {{ rating }} out of five">{{ rating | round: 2 }} <span aria-hidden="true">★★★★★</span></span>{%- endif -%}
    <div class="gc-card__bottom"><span>{{ product.price | money }}</span><button type="button" class="gc-card__quick" data-gc-quick="{{ product.id }}" aria-label="Choose a size for {{ product.title | escape }}" aria-haspopup="dialog"><span class="gc-card__quick-icon">+</span><span class="gc-card__quick-label">Quick Add</span></button></div>
  </div>
  <template data-gc-quick-template="{{ product.id }}">{% render 'guillo-quick-product', product: product %}</template>
</article>
