{%- liquid
  assign colour = ''
  assign style = ''
  assign fit = ''
  for tag in product.tags
    if tag contains 'colour:'
      assign colour = tag | remove: 'colour:'
    endif
  endfor
  if product.tags contains 'grandad-collar'
    assign style = 'Grandad collar'
  elsif product.tags contains 'long-sleeve'
    assign style = 'Long sleeve'
  elsif product.tags contains 'short-sleeve'
    assign style = 'Short sleeve'
  endif
  if product.tags contains 'fit:muscle'
    assign fit = 'Muscle fit'
  elsif product.tags contains 'fit:slim'
    assign fit = 'Slim fit'
  endif
  assign rating = product.metafields.reviews.rating.value.rating
  capture size_values
    for variant in product.variants
      echo variant.title
      unless forloop.last
        echo '|'
      endunless
    endfor
  endcapture
  capture available_sizes
    for variant in product.variants
      if variant.available
        echo variant.title
        echo '|'
      endif
    endfor
  endcapture
-%}
<article class="gc-card" data-gc-card data-name="{{ product.title | escape }}" data-tags="{{ product.tags | join: '|' | escape }}" data-colour="{{ colour | escape }}" data-sizes="{{ size_values | strip | escape }}" data-available-sizes="{{ available_sizes | strip | escape }}" data-available="{{ product.available }}" data-price="{{ product.price }}">
  <div class="gc-card__media" data-gc-media>
    <a href="{{ product.url }}" class="gc-card__photo" aria-label="View {{ product.title | escape }}">{{ product.featured_image | image_url: width: 1200 | image_tag: widths: '240, 360, 540, 750, 1000, 1200', sizes: '(min-width: 1000px) 25vw, 50vw', loading: image_loading, alt: product.title }}</a>
    {%- if product.images[1] != blank -%}<a href="{{ product.url }}" class="gc-card__photo gc-card__photo--second" aria-label="Another view of {{ product.title | escape }}">{{ product.images[1] | image_url: width: 1200 | image_tag: widths: '240, 360, 540, 750, 1000, 1200', sizes: '(min-width: 1000px) 25vw, 50vw', loading: 'lazy', alt: product.title }}</a>{%- endif -%}
    {%- unless product.available -%}<span class="gc-card__badge">Sold out</span>{%- else -%}{%- if product.tags contains 'pre-order' -%}<span class="gc-card__badge">Pre-order</span>{%- endif -%}{%- endunless -%}
  </div>
  <div class="gc-card__details">
    <div class="gc-card__title-row"><h2><a href="{{ product.url }}">{{ product.title | remove_first: 'The ' | escape }}</a></h2><span class="gc-card__colour" style="--swatch:{{ colour | default: 'transparent' | escape }}" aria-label="{{ colour | capitalize | escape }}" title="{{ colour | capitalize | escape }}"></span></div>
    <p class="gc-card__subtitle">{{ fit }}{% if fit != blank and style != blank %} · {% endif %}{{ style }}{% if colour != blank %} · {{ colour | capitalize }}{% endif %}</p>
    {%- if rating != blank and rating > 0 -%}<span class="gc-card__rating" aria-label="Rated {{ rating }} out of five">{{ rating | round: 1 }} <span aria-hidden="true">★★★★★</span></span>{%- endif -%}
    <div class="gc-card__bottom"><span>{{ product.price | money }}</span><button type="button" class="gc-card__quick" data-gc-quick="{{ product.id }}" aria-label="Choose a size for {{ product.title | escape }}" aria-haspopup="dialog">+</button></div>
  </div>
  <template data-gc-quick-template="{{ product.id }}">
    <div class="gc-quick__product">{{ product.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: product.title }}<div><h2>{{ product.title | escape }}</h2><span>{{ product.price | money_with_currency }}</span></div></div>
    {%- if product.tags contains 'pre-order' -%}<p class="gc-quick__note">Pre-order. Check the product page for the current dispatch date.</p>{%- endif -%}
    {%- capture quick_form_id -%}GCQuickForm-{{ product.id }}{%- endcapture -%}
    {%- form 'product', product, id: quick_form_id -%}
      <input type="hidden" name="id" value="{% if product.has_only_default_variant %}{{ product.selected_or_first_available_variant.id }}{% endif %}" data-gc-variant>
      <input type="hidden" name="quantity" value="1">
      {%- unless product.has_only_default_variant -%}<p class="gc-quick__label">Choose your size</p><div class="gc-quick__sizes">{%- for variant in product.variants -%}<button type="button" data-gc-size="{{ variant.id }}" aria-pressed="false" {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }}</button>{%- endfor -%}</div>{%- endunless -%}
      <button type="submit" class="gc-quick__add" {% unless product.has_only_default_variant and product.available %}disabled{% endunless %}>{% if product.available %}{% if product.has_only_default_variant %}Add to bag{% else %}Choose your size{% endif %}{% else %}Sold out{% endif %}</button>
    {%- endform -%}
    <a href="{{ product.url }}" class="gc-quick__full">View full details &amp; size guide</a>
  </template>
</article>
