{%- liquid
  assign category = block.settings.collection
  assign representative = block.settings.product
  assign category_image = block.settings.image | default: representative.featured_image
  if category_image == blank and block.settings.fallback_asset == blank
    assign category_image = category.image
  endif
  assign title = block.settings.heading | default: category.title
-%}
{%- if category != blank -%}
<article class="ga-card ga-category ga-reveal" {{ block.shopify_attributes }}>
  <a class="ga-category__link" href="{{ category.url }}" aria-label="Shop {{ title | escape }}">
    <div class="ga-card__image ga-drift">
      {%- if category_image != blank -%}
        {{ category_image | image_url: width: 1400 | image_tag: widths: '390, 600, 900, 1100, 1400', sizes: '(min-width: 990px) 44vw, 100vw', loading: 'lazy', alt: title }}
      {%- elsif block.settings.fallback_asset != blank -%}
        <img src="{{ block.settings.fallback_asset | asset_url }}" alt="{{ title | escape }}" width="900" height="1600" loading="lazy">
      {%- else -%}
        {{ 'collection-apparel-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    <div class="ga-category__caption"><h3>{{ title | escape }}</h3><span>Shop {{ title | downcase | escape }} <span aria-hidden="true">↗</span></span></div>
  </a>
</article>
{%- endif -%}
