{%- liquid
  assign shirt_reviews = '' | split: ''
  assign shirt_weighted = 0
  assign shirt_count = 0
  for shirt in collections.shirts.products
    assign payload = shirt.metafields.judgeme.review_widget_data.value
    if payload.reviews != blank
      assign shirt_reviews = shirt_reviews | concat: payload.reviews
    endif
    assign n = shirt.metafields.reviews.rating_count.value | plus: 0
    assign a = shirt.metafields.reviews.rating.value.rating | plus: 0
    assign contribution = a | times: n
    assign shirt_count = shirt_count | plus: n
    assign shirt_weighted = shirt_weighted | plus: contribution
  endfor
  assign shirt_reviews = shirt_reviews | uniq | sort: 'created_at' | reverse
  assign shirt_rating = 0
  if shirt_count > 0
    assign shirt_rating = shirt_weighted | times: 1.0 | divided_by: shirt_count | round: 1
  endif
-%}
{% if summary %}
  {% if shirt_count > 0 %}<a class="ge-rating" href="#GEReviews" aria-label="{{ shirt_rating }} out of five from {{ shirt_count }} shirt reviews">{{ shirt_rating }} <span aria-hidden="true">★★★★★</span> ({{ shirt_count }})</a>{% endif %}
{% else %}
<section class="ge-shirt-reviews" id="GEReviews" data-ge-shirt-reviews>
  <h2>Shirt Reviews</h2><p class="ge-review-score">{% if shirt_count > 0 %}{{ shirt_rating }} / 5 · {{ shirt_count }} reviews{% endif %}</p><p class="ge-review-family">Reviews from across the Guillo shirt collection</p>
  <div id="klaviyo-reviews-all" data-id="{{ product.id }}" data-ge-klaviyo-widget></div>
  <div data-ge-review-fallback>
    {% for review in shirt_reviews %}<article class="ge-review" {% if forloop.index > 5 %}hidden data-ge-review-extra{% endif %}><div><strong>{{ review.reviewer_name | default: review.reviewer.name | escape }}</strong>{% if review.verified_buyer %}<span>Verified purchase</span>{% endif %}<time>{{ review.created_at | date: '%-d %B %Y' }}</time></div><div><p class="ge-review-stars" aria-label="{{ review.rating }} out of five">{% for star in (1..5) %}{% if star <= review.rating %}★{% else %}☆{% endif %}{% endfor %}</p>{% if review.title != blank %}<h3>{{ review.title | escape }}</h3>{% endif %}<div>{{ review.body_html | default: review.body }}</div>{% if review.reply_content != blank %}<blockquote><strong>Guillo replied</strong><p>{{ review.reply_content }}</p></blockquote>{% endif %}</div></article>{% endfor %}
    {% if shirt_reviews.size > 5 %}<button type="button" data-ge-more-reviews>Read more reviews</button>{% endif %}
  </div>
</section>
{% endif %}
