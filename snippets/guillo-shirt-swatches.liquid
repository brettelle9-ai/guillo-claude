{%- capture family_handles -%}{%- render 'guillo-shirt-family', product: product -%}{%- endcapture -%}
{%- assign family_handles = family_handles | strip | split: ',' -%}
<div class="ge-shirt-family"><p>Style: <span>{{ product.title | remove_first: 'The ' }}</span></p><div class="ge-shirt-swatches" aria-label="Shirt styles">
{%- for handle in family_handles -%}{%- assign sibling = all_products[handle] -%}{%- if sibling != blank -%}
<a href="{{ sibling.url }}{% if editorial %}?view=firenze-editorial{% endif %}" class="ge-shirt-swatch{% if sibling.id == product.id %} is-current{% endif %}" {% if sibling.id == product.id %}aria-current="page"{% endif %} aria-label="{{ sibling.title | escape }}" title="{{ sibling.title | escape }}"><span>{{ sibling.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: sibling.title }}</span><small>{{ sibling.title | remove_first: 'The ' | remove: ' Grandad Collar' | remove: ' Long Sleeve' | escape }}</small></a>
{%- endif -%}{%- endfor -%}</div></div>
<style>.ge-shirt-family{margin:25px 0 30px;font:400 12px/1.5 var(--g-sans);color:inherit}.ge-shirt-family>p{margin:0 0 14px}.ge-shirt-family>p>span{color:#777}.ge-shirt-swatches{display:flex;flex-wrap:wrap;gap:14px}.ge-shirt-swatch{display:flex;flex-direction:column;align-items:center;gap:7px;text-decoration:none!important;color:inherit!important}.ge-shirt-swatch>span{display:block;position:relative;width:38px;height:38px;overflow:hidden;border-radius:50%;outline:1px solid #d7d7d7;outline-offset:3px}.ge-shirt-swatch.is-current>span{outline-color:#292929}.ge-shirt-swatch img{position:absolute;width:300%;height:300%;max-width:none;left:-100%;top:-90%;object-fit:cover;object-position:50% 45%}.ge-shirt-swatch small{font:400 10px/1.4 var(--g-sans)}.ge-shirt-swatch:focus-visible{outline:2px solid #657989;outline-offset:5px}</style>
