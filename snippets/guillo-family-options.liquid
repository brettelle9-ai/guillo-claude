{%- liquid
 capture key
  render 'guillo-product-family-key', product: product
 endcapture
 assign pool = collections.all.products
 if key == 'shirts'
  assign pool = collections.shirts.products
  capture shirt_handles
   render 'guillo-shirt-family', product: product
  endcapture
 elsif key contains 'chinos'
  assign pool = collections.chinos.products
 elsif key contains 'polos'
  assign pool = collections.polos.products
 elsif key == 'capri-shorts'
  assign pool = collections.shorts.products
 elsif key == 'torino-jeans'
  assign pool = collections.jeans.products
 elsif key == 'classico-tees'
  assign pool = collections['t-shirts'].products
 endif
 assign printed_handles = 'ischia-banded-collar-shirt,firenze-chevron-shirt,milano-pinstripe-shirt,amalfi-short-sleeve-shirt,como-short-sleeve-shirt,the-santorini-grandad-collar'
 assign group = product.metafields.custom.product_group.value
 capture group_images
  for img in group.custom_images.value
   echo img | image_url: width: 300
   unless forloop.last
    echo '|||'
   endunless
  endfor
 endcapture
 assign group_images = group_images | split: '|||'
-%}
<div class="g-family-options" aria-label="Available colours for {{ product.title | escape }}">
{%- for sibling in pool -%}
 {%- capture sibling_key -%}{% render 'guillo-product-family-key', product: sibling %}{%- endcapture -%}
 {%- assign match = false -%}
 {%- if key == 'shirts' -%}{% if shirt_handles contains sibling.handle %}{% assign match = true %}{% endif %}{%- elsif sibling_key == key -%}{% assign match = true %}{%- endif -%}
 {%- if match -%}
  {%- liquid
   assign name = sibling.title | remove_first: 'The '
   assign image = sibling.metafields.custom.fabric_swatch.value | default: sibling.featured_image
   assign image_url = image | image_url: width: 300
   if key != 'shirts'
    for tag in sibling.tags
     if tag contains 'colour:'
      assign name = tag | remove: 'colour:' | capitalize
     endif
    endfor
    for member in group.products.value
     if member.id == sibling.id
      assign image_url = group_images[forloop.index0] | default: image_url
      assign name = group.display_names.value[forloop.index0] | default: name
      break
     endif
    endfor
   endif
   # Card and quick-add swatches use colour chips for solid garments.
   # Main product selectors render separate snippets and keep their existing imagery.
   assign solid = false
   if key == 'capri-shorts' or key == 'signore-chinos' or key contains 'polos'
    assign solid = true
   elsif key == 'shirts'
    unless printed_handles contains sibling.handle
     assign solid = true
    endunless
   endif
   assign colour = sibling.metafields.custom.colour_name.value | downcase
   for tag in sibling.tags
    if tag contains 'colour:'
     assign colour = tag | remove: 'colour:' | downcase | strip
     break
    endif
   endfor
   assign swatch = blank
   for member in group.products.value
    if member.id == sibling.id
     assign swatch = group.swatch_colours.value[forloop.index0]
     break
    endif
   endfor
   if swatch == blank
    case colour
     when 'black'
      assign swatch = '#1b1b1d'
     when 'white'
      assign swatch = '#faf9f6'
     when 'latte'
      assign swatch = '#d6c4a7'
     when 'mocha'
      assign swatch = '#76604e'
     when 'midnight', 'navy'
      assign swatch = '#202b41'
     when 'blue'
      assign swatch = '#9ebacb'
     when 'red'
      assign swatch = '#8b2938'
     when 'grey', 'gray'
      assign swatch = '#a3a5a6'
     when 'stone'
      assign swatch = '#d7ccb5'
     when 'olive'
      assign swatch = '#7b8062'
     when 'reef'
      assign swatch = '#9abbb9'
    endcase
   endif
   # One product-specific palette keeps each garment consistent across cards,
   # regardless of which legacy metaobject group the surrounding product uses.
   case sibling.handle
    when 'the-capri-chino-short-reef'
     assign swatch = '#a7c6c5'
    when 'the-capri-chino-short-stone'
     assign swatch = '#e1dfce'
    when 'the-capri-chino-short-navy'
     assign swatch = '#1c2233'
    when 'the-capri-chino-short-olive-5in'
     assign swatch = '#69705a'
    when 'the-capri-chino-short-grey-5in'
     assign swatch = '#acb0b1'
    when 'the-portofino-polo-blue'
     assign swatch = '#234698'
    when 'the-portofino-polo-red'
     assign swatch = '#b51b31'
    when 'the-portofino-polo-black'
     assign swatch = '#191c22'
    when 'the-valenti-knit-polo-navy'
     assign swatch = '#282544'
    when 'the-signore-chino-latte'
     assign swatch = '#e0d4bc'
    when 'the-signore-chino-mocha'
     assign swatch = '#86624f'
    when 'the-signore-chino-midnight'
     assign swatch = '#273244'
    when 'siracusa-short-sleeve-slim-fit-shirt', 'guillo-fitted-siracusa-long-sleeve-shirt'
     assign swatch = '#f4f3ef'
    when 'guillo-rapallo-short-sleeve-shirt', 'rapallo-banded-collar-jersey'
     assign swatch = '#ca2433'
    when 'guillo-fitted-vulcano-short-sleeve-shirt', 'vulcano-short-sleeve-slim-fit-shirt-copy', 'vulcano-banded-collar-jersey'
     assign swatch = '#1e1e22'
    when 'turin-short-sleeve-shirt'
     assign swatch = '#dce0e4'
    when 'turin-banded-collar-jersey'
     assign swatch = '#e4e2dc'
   endcase
   if solid and swatch == blank
    assign solid = false
   endif
   if solid and colour != blank
    assign name = colour | capitalize
   endif
   assign x = 58
   assign y = 61
   assign zoom = 9
   if sibling.handle == 'milano-pinstripe-shirt'
    assign x = 51
    assign y = 68
    assign zoom = 14
   elsif sibling.handle == 'amalfi-short-sleeve-shirt'
    assign x = 46
    assign y = 64
    assign zoom = 12
   elsif sibling.handle == 'como-short-sleeve-shirt'
    assign x = 61
    assign y = 59
   elsif sibling.handle == 'the-santorini-grandad-collar'
    assign x = 60
    assign y = 64
   endif
   if key != 'shirts' or sibling.metafields.custom.fabric_swatch.value != blank
    assign zoom = 1
    assign x = 50
    assign y = 50
   else
    assign image_url = image | image_url: width: 1800
   endif
   assign width = zoom | times: 100
   assign height = image.height | times: 1.0 | divided_by: image.width | times: width
   assign left = x | times: zoom | minus: 50
   assign top = y | times: height | divided_by: 100.0 | minus: 50
  -%}
  <a class="g-family-option{% if sibling.id == product.id %} is-current{% endif %}" href="{{ sibling.url }}" {% if quick %}data-gq-sibling="{{ sibling.handle }}"{% else %}data-gc-quick-handle="{{ sibling.handle }}"{% endif %} aria-label="{{ sibling.title | escape }} — {{ name | escape }}{% if key == 'capri-shorts' %}{% if sibling.handle contains '5in' %} · 5 inch{% else %} · 7 inch{% endif %}{% endif %}" title="{{ name | escape }}" {% if sibling.id == product.id %}aria-current="true"{% endif %}><span {% if solid %}data-solid-swatch="{{ colour | escape }}" style="background:{{ swatch | escape }}"{% else %}style="--swatch-width:{{ width }}%;--swatch-left:-{{ left }}%;--swatch-top:-{{ top }}%;{% if zoom == 1 %}--swatch-fit:cover{% endif %}"{% endif %}>{% unless solid %}<img src="{{ image_url }}" alt="{{ name | escape }}" width="60" height="60" loading="lazy">{% endunless %}</span></a>
 {%- endif -%}
{%- endfor -%}
</div>
