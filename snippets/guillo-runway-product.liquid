{% if product != blank %}
<article class="gr-piece" data-gr-piece data-product="{{ product.handle }}" data-index="{{ index }}" data-price="{{ product.price }}">
  <div class="gr-piece__row">
    <a class="gr-piece__image" href="{{ product.url }}"><span class="gr-piece__number">{{ index }}</span>{{ product.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', sizes: '80px', alt: product.title }}</a>
    <div class="gr-piece__body"><span class="gr-piece__brand">Guillo</span><a class="gr-piece__title" href="{{ product.url }}">{{ product.title | escape }}</a><span class="gr-piece__price" data-gr-price>{{ product.price | money }}</span><span class="gr-piece__size" data-gr-size-label>{% if product.available %}Choose size{% else %}Sold out{% endif %}</span></div>
    <button type="button" class="gr-piece__toggle" data-gr-size-toggle aria-label="Choose size for {{ product.title | escape }}" aria-expanded="false" aria-controls="gr-sizes-{{ section.id }}-{{ index }}-{{ product.id }}" {% unless product.available %}disabled{% endunless %}>+</button>
  </div>
  <div class="gr-piece__options" data-gr-options id="gr-sizes-{{ section.id }}-{{ index }}-{{ product.id }}" hidden>
    <div class="gr-size-options" role="group" aria-label="{{ product.title | escape }} sizes">{% for variant in product.variants %}<button type="button" class="gr-size-option" data-gr-variant="{{ variant.id }}" data-price="{{ variant.price }}" data-label="{{ variant.title | escape }}" aria-pressed="false" {% unless variant.available %}disabled{% endunless %}>{% if variant.title == 'Default Title' %}One size{% else %}{{ variant.title | escape }}{% endif %}</button>{% endfor %}</div>
    <button type="button" class="gr-piece__add" data-gr-add-one aria-label="Add {{ product.title | escape }} to bag" disabled>Add piece to bag</button>
  </div>
</article>
{% endif %}
