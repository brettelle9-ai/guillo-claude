{% doc %}
  Loads the Guillo brand fonts (Jost + EB Garamond) from Google Fonts.
  Jost is not in the Shopify font library, so both faces load here and
  guillo.css points the theme's font variables at them.
{% enddoc %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Jost:wght@200;300;400;500;600&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap"
  rel="stylesheet"
>

