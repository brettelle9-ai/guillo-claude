<section class="luxe-wardrobe" id="LuxeLook-{{ section.id }}" data-luxe-wardrobe aria-labelledby="LuxeWardrobeHeading-{{ section.id }}">
  <div class="luxe-wardrobe__head">
    <div><p class="luxe-kicker">Wear it together</p><h2 id="LuxeWardrobeHeading-{{ section.id }}">Build your wardrobe.</h2><p class="luxe-wardrobe__intro">Shirts to wear with your Luxe Chino.</p></div>
    <div class="luxe-wardrobe__nav"><p>3+ pieces, 20% off.</p><div><button type="button" data-wardrobe-prev aria-label="Previous shirts" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6"/></svg></button><button type="button" data-wardrobe-next aria-label="Next shirts"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button></div></div>
  </div>
  <div class="luxe-wardrobe__track" data-wardrobe-track tabindex="0" aria-label="Browse shirts to pair with your chinos" aria-roledescription="carousel">
    {%- assign wardrobe_count = 0 -%}
    {%- for piece in collections.shirts.products limit: 16 -%}
      {%- unless piece.available and piece.featured_image != blank -%}{%- continue -%}{%- endunless -%}
      {%- liquid
        assign wardrobe_title = piece.title
        assign wardrobe_group = piece.metafields.custom.product_group.value
        if wardrobe_group != blank
          assign wardrobe_names = wardrobe_group.display_names.value
          for grouped_piece in wardrobe_group.products.value
            if grouped_piece.id == piece.id
              assign wardrobe_style = wardrobe_names[forloop.index0]
              if wardrobe_style != blank
                assign wardrobe_title = wardrobe_style | append: ' Shirt'
                if wardrobe_style == 'Milano'
                  assign wardrobe_title = 'Milano Pinstripe Shirt'
                endif
              endif
              break
            endif
          endfor
        endif
      -%}
      {%- assign wardrobe_second = piece.images[1] -%}
      <article class="luxe-wardrobe__card" data-wardrobe-card data-wardrobe-title="{{ wardrobe_title | escape }}" data-luxe-reveal style="--wardrobe-delay:{{ wardrobe_count | times: 70 }}ms">
        <a class="luxe-wardrobe__image" href="{{ piece.url }}" aria-label="View {{ wardrobe_title | escape }}">
          {{ piece.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 640, 800, 1000', sizes: '(min-width: 990px) 30vw, 82vw', alt: wardrobe_title }}
          {%- if wardrobe_second != blank -%}{{ wardrobe_second | image_url: width: 1000 | image_tag: class: 'luxe-wardrobe__alternate', loading: 'lazy', widths: '400, 640, 800, 1000', sizes: '(min-width: 990px) 30vw, 82vw', alt: '', aria-hidden: 'true' }}{%- endif -%}
        </a>
        <div class="luxe-wardrobe__caption"><a href="{{ piece.url }}">{{ wardrobe_title }}</a><span data-wardrobe-price>{{ piece.price | money }}</span></div>
        {%- if piece.metafields.theme.preorder.value -%}<p class="luxe-wardrobe__preorder">Pre-order · <a href="{{ piece.url }}">dispatch details</a></p>{%- endif -%}
        <div class="luxe-wardrobe__sizes" role="group" aria-label="Choose {{ wardrobe_title | escape }} size">
          {%- for v in piece.variants -%}<button type="button" data-wardrobe-size data-variant-id="{{ v.id }}" data-variant-price="{{ v.price }}" aria-pressed="false"{% unless v.available %} disabled{% endunless %}>{{ v.title }}{% unless v.available %}<span class="visually-hidden"> — unavailable</span>{% endunless %}</button>{%- endfor -%}
        </div>
        <button class="luxe-wardrobe__add" type="button" data-wardrobe-add>Choose size <span aria-hidden="true">↗</span></button>
      </article>
      {%- assign wardrobe_count = wardrobe_count | plus: 1 -%}
      {%- if wardrobe_count == 6 -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
  </div>
  <div class="luxe-wardrobe__progress" aria-hidden="true"><span data-wardrobe-progress></span></div>
  <p class="luxe-wardrobe__status" data-wardrobe-status role="status" aria-live="polite"></p>
  <script type="application/json" data-wardrobe-money>{"currency":{{ cart.currency.iso_code | json }},"locale":{{ request.locale.iso_code | json }}}</script>
</section>
