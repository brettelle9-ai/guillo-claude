{% doc %}
  Product discovery data for the editorial product page. Reviews are added
  from the published storefront feed by guillo-shirt-reviews.js; the reviews
  metafields can contain collection-wide totals and must not be used here.

  @param {object} product - Current Shopify product
  @param {string} [availability_mode] - normal, preorder or interest
{% enddoc %}
{%- if product != blank and availability_mode != 'interest' -%}
  {%- liquid
    assign product_url = canonical_url | split: '?' | first
    assign product_description = product.description | strip_html | strip
    assign currency = cart.currency.iso_code | default: localization.country.currency.iso_code | default: shop.currency
    assign is_group = true
    if product.has_only_default_variant
      assign is_group = false
    endif
  -%}
  {%- capture schema_json -%}
  {
    "@context": "https://schema.org",
    "@type": {% if is_group %}"ProductGroup"{% else %}"Product"{% endif %},
    "@id": {{ product_url | append: '#product' | json }},
    "name": {{ product.title | json }},
    "url": {{ product_url | json }},
    "brand": {"@type": "Brand", "name": {{ product.vendor | default: shop.name | json }}}
    {%- if product.type != blank -%}, "category": {{ product.type | json }}{%- endif -%}
    {%- if product_description != blank -%},
      "description": {{ product_description | json }}
    {%- endif -%}
    {%- if product.featured_image != blank -%},
      "image": {{ product.featured_image | image_url: width: 1920 | prepend: 'https:' | json }}
    {%- endif -%}
    {%- if is_group -%},
      "productGroupID": {{ product.id | append: '' | json }},
      "variesBy": [
        {%- assign option_separator = '' -%}
        {%- for option in product.options_with_values -%}
          {%- assign option_name = option.name | downcase -%}
          {%- case option_name -%}
            {%- when 'size', 'waist' -%}{{ option_separator }}"https://schema.org/size"{%- assign option_separator = ',' -%}
            {%- when 'color', 'colour' -%}{{ option_separator }}"https://schema.org/color"{%- assign option_separator = ',' -%}
          {%- endcase -%}
        {%- endfor -%}
      ],
      "hasVariant": [
        {%- for variant in product.variants -%}
          {%- liquid
            assign variant_url = product_url | append: '?variant=' | append: variant.id
            assign variant_image = variant.featured_image | default: product.featured_image
          -%}
          {
            "@type": "Product",
            "@id": {{ variant_url | append: '#variant' | json }},
            "name": {{ product.title | append: ' - ' | append: variant.title | json }},
            "url": {{ variant_url | json }}
            {%- if product_description != blank -%}, "description": {{ product_description | json }}{%- endif -%}
            {%- if variant_image != blank -%}, "image": {{ variant_image | image_url: width: 1920 | prepend: 'https:' | json }}{%- endif -%}
            {%- if variant.sku != blank -%}, "sku": {{ variant.sku | json }}{%- endif -%}
            {%- for option in product.options_with_values -%}
              {%- assign option_name = option.name | downcase -%}
              {%- case option_name -%}
                {%- when 'size', 'waist' -%}, "size": {{ variant.options[forloop.index0] | json }}
                {%- when 'color', 'colour' -%}, "color": {{ variant.options[forloop.index0] | json }}
              {%- endcase -%}
            {%- endfor -%},
            "offers": {% render 'guillo-product-offer-schema', variant: variant, variant_url: variant_url, currency: currency, availability_mode: availability_mode %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    {%- else -%}
      {%- if product.selected_or_first_available_variant.sku != blank -%}, "sku": {{ product.selected_or_first_available_variant.sku | json }}{%- endif -%},
      "offers": {% render 'guillo-product-offer-schema', variant: product.selected_or_first_available_variant, variant_url: product_url, currency: currency, availability_mode: availability_mode %}
    {%- endif -%}
  }
  {%- endcapture -%}
  {%- capture escaped_open_angle -%}\u003c{%- endcapture -%}
  <script type="application/ld+json" id="guillo-product-structured-data" data-product-id="{{ product.id }}">{{ schema_json | replace: '<', escaped_open_angle }}</script>
{%- endif -%}
