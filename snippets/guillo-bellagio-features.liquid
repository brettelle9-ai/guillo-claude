{%- comment -%}Weekender features verified against its product description.{%- endcomment -%}
{%- assign feature_labels = 'Genuine leather|16-inch laptop sleeve|Suitcase trolley sleeve|Adjustable shoulder strap|Organised inner pockets|Rear zip pocket' | split: '|' -%}
<div class="bellagio-features" data-bellagio-features>
  <ul class="bellagio-features__list" aria-label="Bellagio Weekender features">
    {%- for label in feature_labels -%}
      <li class="bellagio-features__item">
        <svg class="bellagio-features__icon" width="28" height="28" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          {%- case forloop.index -%}
            {%- when 1 -%}<path d="M11 4c2 3 8 3 10 0l5 5c-3 3-3 11 0 14l-6 5c-2-3-6-3-8 0l-6-5c3-3 3-11 0-14z"/><path d="m12 15 3 3 6-6"/>
            {%- when 2 -%}<rect x="6" y="5" width="20" height="16" rx="1.5"/><path d="m6 21-3 5h26l-3-5M13 24h6"/>
            {%- when 3 -%}<rect x="7" y="11" width="18" height="17" rx="2"/><path d="M12 11V4h8v7M5 18h22M12 15v9M20 15v9"/>
            {%- when 4 -%}<path d="M6 22C6 3 26 3 26 22M9 22C9 7 23 7 23 22"/><rect x="4" y="21" width="7" height="6" rx="1"/><rect x="21" y="21" width="7" height="6" rx="1"/>
            {%- when 5 -%}<rect x="4" y="7" width="24" height="20" rx="2"/><path d="M4 13h24M11 13v14M21 13v14M10 4h12"/>
            {%- when 6 -%}<rect x="5" y="6" width="22" height="21" rx="2"/><path d="M8 13h16M10 11v4M14 11v4M18 11v4M22 11v4M22 13v7"/><rect x="20" y="19" width="4" height="5" rx="1"/>
          {%- endcase -%}
        </svg>
        <span>{{ label }}</span>
      </li>
    {%- endfor -%}
  </ul>
</div>

<script src="{{ 'guillo-bellagio-features.js' | asset_url }}" defer></script>

<style>.guillo-pdp--bellagio .guillo-pdp__tabbar{border-bottom:0!important}.guillo-pdp--bellagio .bellagio-features{border-top:0!important}</style>
