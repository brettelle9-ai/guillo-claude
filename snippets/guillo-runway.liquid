{{ 'guillo-runway.css' | asset_url | stylesheet_tag }}
<script src="{{ 'guillo-runway.js' | asset_url }}" defer></script>
{%- assign looks = section.blocks | where: 'type', 'look' -%}
{% if looks.size > 0 %}
<guillo-runway class="gr" id="guillo-runway-{{ section.id }}" data-currency="{{ cart.currency.iso_code }}" data-root="{{ routes.root_url }}" data-version="spring-runway-v4">
  <header class="gr-head">
    <div class="gr-heading"><h2>{{ section.settings.runway_heading | default: 'Try the look.' | escape }}</h2><p>{{ looks.size }} looks, styled head to toe. Select a look to explore the pieces.</p></div>
    <div class="gr-selected-heading" aria-live="polite" aria-hidden="true"><span class="gr-micro">Look <span data-gr-current>01</span></span><strong data-gr-title></strong></div>
    <button class="gr-night" type="button" role="switch" data-gr-night aria-label="Night mode" aria-checked="false"><span class="gr-night__label">Night mode</span><span class="gr-night__track" aria-hidden="true"><span></span></span></button>
    <button class="gr-back" type="button" data-gr-close hidden aria-label="Back to all looks">×</button>
  </header>
  <div class="gr-stage">
    <div class="gr-track" role="group" aria-label="Guillo outfit runway" aria-roledescription="carousel" tabindex="0">
      {% for block in looks %}
        {%- liquid
          assign primary = block.settings.product
          assign image_index = block.settings.image_index | default: 1 | minus: 1
          assign look_image = block.settings.image | default: primary.images[image_index] | default: primary.featured_image
          assign look_title = block.settings.title | default: primary.title
          assign cutout_asset = block.settings.cutout_asset
          assign piece_count = 0
          if primary != blank
            assign piece_count = 1
          endif
          for piece in block.settings.products limit: 3
            unless piece.id == primary.id
              assign piece_count = piece_count | plus: 1
            endunless
          endfor
        -%}
        <article class="gr-look" data-gr-look data-title="{{ look_title | escape }}" data-count="{{ piece_count }}" aria-label="{{ forloop.index }} of {{ looks.size }}: {{ look_title | escape }}" {{ block.shopify_attributes }}>
          <div class="gr-figure">
            <button type="button" class="gr-look__open" data-gr-open aria-label="Shop {{ look_title | escape }}" aria-expanded="false" aria-controls="gr-shop-{{ section.id }}">
              {% if block.settings.image != blank or cutout_asset == blank %}
                {% if look_image != blank %}{{ look_image | image_url: width: 1200 | image_tag: class: 'gr-cutout', loading: 'lazy', widths: '400, 600, 900, 1200', sizes: '(min-width: 990px) 400px, 75vw', alt: block.settings.alt | default: look_title }}{% endif %}
              {% else %}
                <img class="gr-cutout" src="{{ cutout_asset | asset_url }}" width="1060" height="1484" loading="lazy" decoding="async" alt="{{ block.settings.alt | default: look_title | escape }}">
              {% endif %}
            </button>
            <div class="gr-pins" inert aria-hidden="true">
              {% if primary != blank %}<button class="gr-pin" style="--x:{{ block.settings.pin_x | default: 50 }}%;--y:{{ block.settings.pin_y | default: 35 }}%" type="button" data-gr-pin="1" aria-label="Choose {{ primary.title | escape }} size">1</button>{% endif %}
              {%- assign piece_index = 1 -%}
              {% for piece in block.settings.products limit: 3 %}
                {% unless piece.id == primary.id %}
                  {%- liquid
                    assign piece_index = piece_index | plus: 1
                    assign pin_x = block.settings.pin_two_x | default: 52
                    assign pin_y = block.settings.pin_two_y | default: 70
                    if piece_index == 3
                      assign pin_x = block.settings.pin_three_x | default: 73
                      assign pin_y = block.settings.pin_three_y | default: 52
                    elsif piece_index == 4
                      assign pin_x = 48
                      assign pin_y = 91
                    endif
                  -%}
                  <button class="gr-pin" style="--x:{{ pin_x }}%;--y:{{ pin_y }}%" type="button" data-gr-pin="{{ piece_index }}" aria-label="Choose {{ piece.title | escape }} size">{{ piece_index }}</button>
                {% endunless %}
              {% endfor %}
            </div>
          </div>
          <template data-gr-template>
            <header class="gr-shop__head"><span class="gr-micro">In this look</span><span class="gr-piece-count">{{ piece_count }} pieces</span><h3>{{ look_title | escape }}</h3><p>Choose your size for each piece.</p></header>
            <div class="gr-pieces">
              {% render 'guillo-runway-product', product: primary, index: 1, runway_section_id: section.id %}
              {%- assign piece_index = 1 -%}
              {% for piece in block.settings.products limit: 3 %}{% unless piece.id == primary.id %}{% assign piece_index = piece_index | plus: 1 %}{% render 'guillo-runway-product', product: piece, index: piece_index, runway_section_id: section.id %}{% endunless %}{% endfor %}
            </div>
            <footer class="gr-summary"><div><span>The complete look</span><strong data-gr-total></strong></div><button class="gr-add-all" type="button" data-gr-add-all>Add the complete look <span aria-hidden="true">→</span></button><p class="gr-status" data-gr-status role="status" aria-live="polite"></p><a class="gr-cart-link" href="{{ routes.cart_url }}" hidden>View your bag →</a></footer>
          </template>
        </article>
      {% endfor %}
    </div>
    <section class="gr-shop" id="gr-shop-{{ section.id }}" data-gr-content aria-label="Shop the selected look" hidden inert></section>
    <div class="gr-detail-hint" aria-hidden="true">Tap a number to choose your piece</div>
  </div>
  <footer class="gr-controls">
    <button type="button" class="gr-nav-arrow" data-gr-prev aria-label="Previous look">←</button>
    <nav class="gr-numbers" aria-label="Choose a look">{% for block in looks %}<button type="button" data-gr-dot="{{ forloop.index0 }}" aria-label="View look {{ forloop.index }}" aria-pressed="false"><span>{{ forloop.index | prepend: '0' }}</span><span class="gr-number-title" aria-hidden="true">{{ block.settings.title | default: block.settings.product.title | escape }}</span></button>{% endfor %}</nav>
    <button type="button" class="gr-pause" data-gr-pause aria-label="Pause runway" aria-pressed="false">Ⅱ</button>
    <button type="button" class="gr-nav-arrow" data-gr-next aria-label="Next look">→</button>
  </footer>
</guillo-runway>
{% endif %}
