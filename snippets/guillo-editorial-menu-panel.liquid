{%- comment -%}One real menu level; recursively renders Shopify's child links.{%- endcomment -%}
<section class="gc-menu__panel" data-gc-menu-panel="{{ panel_id }}" data-panel-title="{{ title | escape }}" {% unless panel_id == 'root' %}hidden{% endunless %}>
  <ul class="gc-menu__links">
    {%- if parent_url != blank -%}<li><a href="{{ parent_url }}">Shop all {{ title | downcase | escape }}</a></li>{%- endif -%}
    {%- for link in links -%}
      {%- capture child_id -%}{{ panel_id }}-{{ forloop.index }}{%- endcapture -%}
      <li>{%- if link.links.size > 0 -%}<button type="button" data-gc-menu-go="{{ child_id }}">{{ link.title | escape }}<span aria-hidden="true">›</span></button>{%- else -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endif -%}</li>
    {%- endfor -%}
  </ul>
  <div class="gc-menu__tiles">
    {%- assign tile_count = 0 -%}
    {%- for link in links -%}
      {%- assign tile_image = link.object.image | default: link.object.featured_image | default: link.object.products.first.featured_image -%}
      {%- if tile_image != blank and tile_count < 2 -%}
        <a href="{{ link.url }}" class="gc-menu__tile">{{ tile_image | image_url: width: 650 | image_tag: loading: 'lazy', widths: '240, 400, 650', sizes: '250px', alt: link.title }}<span>{{ link.title | escape }}<small>Shop now</small></span></a>
        {%- assign tile_count = tile_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{%- for link in links -%}
  {%- if link.links.size > 0 -%}
    {%- capture child_id -%}{{ panel_id }}-{{ forloop.index }}{%- endcapture -%}
    {% render 'guillo-editorial-menu-panel', links: link.links, panel_id: child_id, title: link.title, parent_url: link.url %}
  {%- endif -%}
{%- endfor -%}
