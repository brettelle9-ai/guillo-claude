{%- liquid
  assign length_label = 'Ankle length'
  assign length_position = '50%'
  assign product_name = product.title | downcase
  if product.handle contains '-long' or product_name contains 'long'
    assign length_label = 'Long leg'
    assign length_position = '100%'
  endif
-%}
<div class="luxe-fit-profile" aria-label="Cut and fit at a glance">
  <div class="luxe-fit-profile__scales">
    <div class="luxe-fit-profile__scale">
      <div class="luxe-fit-profile__head"><span>Leg fit</span><strong>Slim</strong></div>
      <div class="luxe-fit-profile__track" role="img" aria-label="Slim fit, between skinny and relaxed"><span style="--fit-position:50%"></span></div>
      <div class="luxe-fit-profile__labels" aria-hidden="true"><span>Skinny</span><span>Slim</span><span>Relaxed</span></div>
    </div>
    <div class="luxe-fit-profile__scale">
      <div class="luxe-fit-profile__head"><span>Leg length</span><strong>{{ length_label }}</strong></div>
      <div class="luxe-fit-profile__track" role="img" aria-label="{{ length_label }}; check your inside-leg measurement"><span style="--fit-position:{{ length_position }}"></span></div>
      <div class="luxe-fit-profile__labels" aria-hidden="true"><span>Cropped</span><span>Ankle</span><span>Full</span></div>
    </div>
  </div>
  <p class="luxe-fit-profile__measurement" data-luxe-inseam>Inside leg varies by size · compare with a pair you own.</p>
  <ul class="luxe-product-notes" aria-label="Product details">
    <li><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M9 4h14l2 23h-7l-2-14-2 14H7L9 4Z"/><path d="M9 8h14M16 4v9"/></svg><span>Tapered leg</span></li>
    <li><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M4 11h24v10H4zM7 9v14M25 9v14"/><rect x="13" y="12" width="7" height="8"/><path d="M16 16h7"/></svg><span>Belt-loop waist</span></li>
    <li><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M6 5h20v22H6zM6 9h20M6 19c7-1 10-5 11-10M21 5v4"/></svg><span>Side pockets</span></li>
    <li><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M5 8h22v16H5zM5 13h22M9 11h14"/><circle cx="16" cy="17" r="1"/></svg><span>Rear pockets</span></li>
  </ul>
</div>
