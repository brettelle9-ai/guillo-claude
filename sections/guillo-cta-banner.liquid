{% comment %}
  Dark image-backed centered CTA banner ("Now you know your cut.").
{% endcomment %}

<section class="guillo-cta">
  {% render 'guillo-img',
    image: section.settings.image,
    fallback: 'guillo-bone-fountain.jpg',
    alt: '',
    class: 'guillo-cta__img',
    sizes: '100vw',
    position: section.settings.image_position
  %}
  <div class="guillo-cta__content">
    <h2 class="guillo-cta__heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="guillo-cta__text">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_link }}" class="g-btn g-btn--light">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .guillo-cta {
    position: relative;
    min-height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: var(--g-ink);
    overflow: hidden;
  }
  .guillo-cta__img,
  .guillo-cta > svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.42;
  }
  .guillo-cta__content {
    position: relative;
    padding: 80px 40px;
    max-width: 660px;
  }
  .guillo-cta__heading {
    font: 500 clamp(32px, 3.4vw, 50px)/1.08 var(--g-serif);
    color: #fff;
    margin: 0 0 20px;
  }
  .guillo-cta__text {
    font: 300 16px/1.7 var(--g-sans);
    color: #CDCFD3;
    margin: 0 0 32px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Guillo CTA banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "image_position", "label": "Image focal point", "default": "center 24%" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Now you know your cut." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Free exchanges within 44 days, so the first order can be the one that teaches you the size." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop the chinos" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Guillo CTA banner", "category": "Guillo" }
  ]
}
{% endschema %}

