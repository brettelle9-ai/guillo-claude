{{ 'guillo-editorial-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'guillo-editorial-home.js' | asset_url }}" defer></script>
{%- assign hero_product = section.settings.hero_product -%}
{%- assign feature_product = section.settings.feature_product -%}
<div class="gh-home" data-gh-home>
  <section class="gh-hero" aria-label="{{ section.settings.hero_heading | escape }}">
    {%- if section.settings.hero_media_type == 'video' and section.settings.hero_video != blank -%}
      {% render 'guillo-editorial-media', video: section.settings.hero_video, mobile_video: section.settings.hero_mobile_video, image: section.settings.hero_image, mobile_image: section.settings.hero_mobile_image, fallback_image: hero_product.featured_image, fallback_asset: 'guillo-shirt-campaign-wide.jpg', media_class: 'gh-hero__media', eager: true, alt: section.settings.hero_heading %}
    {%- else -%}
    <picture>
      {%- assign hero_mobile_image = section.settings.hero_mobile_image | default: hero_product.featured_image -%}{% if hero_mobile_image != blank %}<source media="(max-width:767px)" srcset="{{ hero_mobile_image | image_url: width: 1000 }}">{% endif %}
      {% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '1000, 1600, 2000, 2400', sizes: '100vw', alt: 'The Guillo shirt collection' }}{% else %}<img src="{{ 'guillo-shirt-campaign-wide.jpg' | asset_url }}" width="1920" height="1080" alt="The Firenze shirt at the villa" fetchpriority="high">{% endif %}
    </picture>
    {%- endif -%}
    <div class="gh-hero__content"><h1>{{ section.settings.hero_heading | escape }}</h1>{% if section.settings.hero_subheading != blank %}<p>{{ section.settings.hero_subheading | escape }}</p>{% endif %}<a class="gh-button" href="{{ section.settings.hero_link | default: collections.shirts.url }}">{{ section.settings.hero_button | default: 'Shop now' | escape }}</a></div>
  </section>
  <div class="gh-notice"><a href="{{ shop.refund_policy.url }}">44-day returns &amp; exchanges · AU &amp; NZ</a></div>
  <section class="gh-categories" aria-label="Shop by category">
    {% for block in section.blocks %}{% if block.type == 'category' %}
      {%- assign category_product = block.settings.product -%}
      <a class="gh-category" href="{{ block.settings.link }}{% if block.settings.heading == 'Shirts' %}?view=shirts-editorial{% endif %}" {{ block.shopify_attributes }}>
        {% render 'guillo-editorial-media', media_type: block.settings.media_type, image: block.settings.image, video: block.settings.video, fallback_image: category_product.featured_image, fallback_film: block.settings.film_asset, alt: block.settings.heading %}
        <h2>{{ block.settings.heading | escape }}</h2>
      </a>
    {% endif %}{% endfor %}
  </section>
  <div class="gh-notice"><a href="{{ pages['fit-guide'].url }}">A closer fit. A more distinctive way to dress.</a></div>
  <section class="gh-feature">
    <a class="gh-feature__image" href="{{ feature_product.url }}">{% render 'guillo-editorial-media', media_type: section.settings.feature_media_type, image: section.settings.feature_image, video: section.settings.feature_video, fallback_image: feature_product.featured_image, alt: feature_product.title %}</a>
    <div class="gh-feature__body"><div><h2>{{ section.settings.feature_heading | escape }}</h2><p>{{ section.settings.feature_text | escape }}</p><a class="gh-link" href="{{ feature_product.url }}">{{ section.settings.feature_button | default: 'Discover the Signore' | escape }}</a></div></div>
  </section>
  <section class="gh-products">
    <header class="gh-section-heading"><h2>Chosen for you</h2><div><button type="button" data-gh-rail-prev aria-label="Previous products">←</button><button type="button" data-gh-rail-next aria-label="Next products">→</button></div></header>
    <div class="gh-product-rail" data-gh-rail>{%- assign featured_products = section.settings.featured_products | default: collections.shirts.products -%}{% for p in featured_products limit: 8 %}{% liquid
      assign card_override = blank
      for media_block in section.blocks
        if media_block.type == 'product_media' and media_block.settings.product.id == p.id
          assign card_override = media_block
          break
        endif
      endfor
    %}{% render 'guillo-editorial-card', product: p, image_loading: 'lazy', media_override: card_override, card_media_default: section.settings.card_media_default %}{% endfor %}</div>
  </section>
  <section class="gh-campaign" data-gh-campaign aria-label="Guillo campaign films" aria-roledescription="carousel">
    <div class="gh-campaign__track" data-gh-campaign-track>
      <article class="gh-campaign__slide" aria-label="1 of 2">
        {% if section.settings.campaign_one_media_type == 'video' and section.settings.campaign_one_video != blank %}
          {% render 'guillo-editorial-media', video: section.settings.campaign_one_video, image: section.settings.campaign_one_image, fallback_asset: 'guillo-bone-pool.jpg', media_class: 'gh-campaign__film', alt: section.settings.campaign_one_heading %}
        {% else %}<div class="gh-campaign__pair">
          {% if section.settings.campaign_one_image != blank %}{{ section.settings.campaign_one_image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: section.settings.campaign_one_heading }}{% else %}<img src="{{ 'guillo-bone-pool.jpg' | asset_url }}" alt="Guillo pinstripe shirt and cream chinos by the pool" loading="lazy" width="1500" height="2000">{% endif %}
          {% if section.settings.campaign_one_image_two != blank %}{{ section.settings.campaign_one_image_two | image_url: width: 1800 | image_tag: loading: 'lazy', alt: section.settings.campaign_one_heading }}{% else %}<img src="{{ 'guillo-black-drive-01.jpg' | asset_url }}" alt="Guillo in black, styled for the evening" loading="lazy" width="1500" height="2000">{% endif %}
        </div>{% endif %}
        <div class="gh-hero__content"><h2>{{ section.settings.campaign_one_heading | escape }}</h2><a class="gh-button" href="{{ section.settings.campaign_one_link | default: collections['all'].url }}">{{ section.settings.campaign_one_button | escape }}</a></div>
      </article>
      <article class="gh-campaign__slide" aria-label="2 of 2">
        {% render 'guillo-editorial-media', media_type: section.settings.campaign_two_media_type, video: section.settings.campaign_video, image: section.settings.campaign_two_image, mobile_image: section.settings.campaign_two_mobile_image, fallback_asset: 'guillo-campaign-primary.jpg', fallback_film: 'guillo-campaign-primary.mp4', media_class: 'gh-campaign__film', alt: section.settings.campaign_two_heading %}
        <div class="gh-hero__content"><h2>{{ section.settings.campaign_two_heading | escape }}</h2><a class="gh-button" href="{{ section.settings.campaign_two_link | default: collections.shirts.url }}">{{ section.settings.campaign_two_button | escape }}</a></div>
      </article>
    </div>
    <div class="gh-campaign__controls"><button type="button" data-gh-slide="0" aria-label="View campaign 1" aria-pressed="true"></button><button type="button" data-gh-slide="1" aria-label="View campaign 2" aria-pressed="false"></button><button class="gh-campaign__pause" type="button" data-gh-pause aria-label="Pause campaign slideshow">Ⅱ</button></div>
  </section>
  <section class="gh-looks">
    <header class="gh-section-heading"><h2>Worn the Guillo way.</h2></header>
    <div class="gh-look-rail">
      {% for block in section.blocks %}{% if block.type == 'look' %}
        {%- assign look_product = block.settings.product -%}
        <article class="gh-look" {{ block.shopify_attributes }}>
          {% render 'guillo-editorial-media', media_type: block.settings.media_type, image: block.settings.image, video: block.settings.video, fallback_image: look_product.featured_image, fallback_asset: block.settings.image_asset, alt: block.settings.alt %}
          <button type="button" data-gh-look="{{ look_product.handle }}" aria-label="Shop this look: {{ look_product.title | escape }}">Shop the look <span aria-hidden="true">+</span></button>
          <template><h2 class="gh-look-heading">Shop this look</h2><div class="gh-look-products">
            {% render 'guillo-look-product', product: look_product %}
            {% for piece in block.settings.products %}{% unless piece.id == look_product.id %}{% render 'guillo-look-product', product: piece %}{% endunless %}{% endfor %}
          </div></template>
        </article>
      {% endif %}{% endfor %}
    </div>
    <a class="gh-instagram gh-link" href="https://www.instagram.com/guilloclothing/" target="_blank" rel="noopener">Follow @guilloclothing</a>
  </section>
  <div class="gh-perks"><a href="{{ pages['fit-guide'].url }}"><strong>Find your fit</strong><span>Size guides for a closer fit</span></a><a href="{{ shop.refund_policy.url }}"><strong>44 days to get it right</strong><span>Returns &amp; exchanges · AU &amp; NZ</span></a></div>
</div>
<dialog class="gc-quick gc-dialog" aria-label="Choose product size" data-gh-quick><button type="button" class="gc-icon-button gc-quick__close" data-gc-close aria-label="Close quick add">×</button><div data-gh-quick-content></div></dialog>
<dialog class="gc-quick gc-dialog" aria-label="Shop the look" data-gh-look-dialog><button type="button" class="gc-icon-button gc-quick__close" data-gc-close aria-label="Close shop the look">×</button><div data-gh-look-content></div></dialog>
{% schema %}
{"name":"Guillo editorial homepage","settings":[{"type":"header","content":"Main hero"},{"type":"text","id":"hero_heading","label":"Heading","default":"A Mediterranean state of mind."},{"type":"text","id":"hero_subheading","label":"Optional supporting line"},{"type":"text","id":"hero_button","label":"Button label","default":"Explore Guillo"},{"type":"url","id":"hero_link","label":"Button link"},{"type":"select","id":"hero_media_type","label":"Hero display","default":"image","options":[{"value":"image","label":"Image"},{"value":"video","label":"Video"}]},{"type":"image_picker","id":"hero_image","label":"Desktop image"},{"type":"image_picker","id":"hero_mobile_image","label":"Mobile image"},{"type":"video","id":"hero_video","label":"Desktop video"},{"type":"video","id":"hero_mobile_video","label":"Mobile video (optional)"},{"type":"product","id":"hero_product","label":"Fallback mobile image product"},{"type":"header","content":"Feature section"},{"type":"product","id":"feature_product","label":"Feature product"},{"type":"text","id":"feature_heading","label":"Feature heading","default":"The Signore Chino"},{"type":"textarea","id":"feature_text","label":"Description","default":"A clean front. Side-tab adjusters. A considered fit through the leg. Meet the chino with a different point of view."},{"type":"text","id":"feature_button","label":"Button label","default":"Discover the Signore"},{"type":"select","id":"feature_media_type","label":"Feature display","default":"image","options":[{"value":"image","label":"Image"},{"value":"video","label":"Video"}]},{"type":"image_picker","id":"feature_image","label":"Feature image"},{"type":"video","id":"feature_video","label":"Feature video"},{"type":"header","content":"Chosen for you"},{"type":"product_list","id":"featured_products","label":"Products","limit":12},{"type":"select","id":"card_media_default","label":"Default card display","default":"auto","options":[{"value":"auto","label":"Automatic — play available video"},{"value":"image","label":"Image"},{"value":"video","label":"Video"}]},{"type":"paragraph","content":"Add a Product card media block below to choose an image or video for an individual product."},{"type":"header","content":"Campaign 1"},{"type":"text","id":"campaign_one_heading","label":"Heading","default":"A certain presence."},{"type":"text","id":"campaign_one_button","label":"Button label","default":"Shop the collection"},{"type":"url","id":"campaign_one_link","label":"Button link"},{"type":"select","id":"campaign_one_media_type","label":"Display","default":"image","options":[{"value":"image","label":"Image"},{"value":"video","label":"Video"}]},{"type":"image_picker","id":"campaign_one_image","label":"Main image / video cover"},{"type":"image_picker","id":"campaign_one_image_two","label":"Second image (desktop)"},{"type":"video","id":"campaign_one_video","label":"Video"},{"type":"header","content":"Campaign 2"},{"type":"text","id":"campaign_two_heading","label":"Heading","default":"Guillo in motion."},{"type":"text","id":"campaign_two_button","label":"Button label","default":"Shop shirts"},{"type":"url","id":"campaign_two_link","label":"Button link"},{"type":"select","id":"campaign_two_media_type","label":"Display","default":"video","options":[{"value":"image","label":"Image"},{"value":"video","label":"Video"}]},{"type":"image_picker","id":"campaign_two_image","label":"Desktop image / video cover"},{"type":"image_picker","id":"campaign_two_mobile_image","label":"Mobile image"},{"type":"video","id":"campaign_video","label":"Video"}],"blocks":[{"type":"category","name":"Category tile","limit":4,"settings":[{"type":"text","id":"heading","label":"Heading"},{"type":"product","id":"product","label":"Fallback image product"},{"type":"url","id":"link","label":"Link"},{"type":"select","id":"media_type","label":"Display","default":"image","options":[{"value":"image","label":"Image"},{"value":"video","label":"Video"}]},{"type":"image_picker","id":"image","label":"Image / video cover"},{"type":"video","id":"video","label":"Video"},{"type":"text","id":"film_asset","label":"Original film (optional)","info":"Keeps the current film until you select another video. Choose Image above to turn it off."}]},{"type":"look","name":"Shop the look","limit":4,"settings":[{"type":"product","id":"product","label":"Featured product"},{"type":"product_list","id":"products","label":"Other products in this look","limit":4},{"type":"select","id":"media_type","label":"Display","default":"image","options":[{"value":"image","label":"Image"},{"value":"video","label":"Video"}]},{"type":"image_picker","id":"image","label":"Image / video cover"},{"type":"video","id":"video","label":"Video"},{"type":"text","id":"alt","label":"Image description"},{"type":"text","id":"image_asset","label":"Original image (optional)","info":"Your current image is kept until you select a replacement above."}]},{"type":"product_media","name":"Product card media","settings":[{"type":"product","id":"product","label":"Product"},{"type":"select","id":"media_type","label":"Display","default":"auto","options":[{"value":"auto","label":"Automatic — play available video"},{"value":"image","label":"Image"},{"value":"video","label":"Video"}]},{"type":"image_picker","id":"image","label":"Card image / video cover"},{"type":"video","id":"video","label":"Card video"},{"type":"paragraph","content":"Choose the product, then Image or Video. Automatic uses its product video or the existing film. Leave the image empty to keep the product photo."}]}],"presets":[{"name":"Guillo editorial homepage"}]}
