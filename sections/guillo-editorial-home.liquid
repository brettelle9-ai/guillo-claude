{{ 'guillo-editorial-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'guillo-editorial-home.js' | asset_url }}" defer></script>
{%- assign hero_product = section.settings.hero_product -%}
{%- assign feature_product = section.settings.feature_product -%}
<div class="gh-home" data-gh-home>
  <section class="gh-hero" aria-label="{{ section.settings.hero_heading | escape }}">
    <picture>
      {% if hero_product.featured_image != blank %}<source media="(max-width:767px)" srcset="{{ hero_product.featured_image | image_url: width: 1000 }}">{% endif %}
      {% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '1000, 1600, 2000, 2400', sizes: '100vw', alt: 'The Guillo shirt collection' }}{% else %}<img src="{{ 'guillo-shirt-campaign-wide.jpg' | asset_url }}" width="1920" height="1080" alt="The Firenze shirt at the villa" fetchpriority="high">{% endif %}
    </picture>
    <div class="gh-hero__content"><h1>{{ section.settings.hero_heading | escape }}</h1><a class="gh-button" href="{{ collections.shirts.url }}?view=shirts-editorial">Shop now</a></div>
  </section>
  <div class="gh-notice"><a href="{{ shop.refund_policy.url }}">44-day returns &amp; exchanges · AU &amp; NZ</a></div>
  <section class="gh-categories" aria-label="Shop by category">
    {% for block in section.blocks %}{% if block.type == 'category' %}
      {%- assign category_product = block.settings.product -%}
      <a class="gh-category" href="{{ block.settings.link }}{% if block.settings.heading == 'Shirts' %}?view=shirts-editorial{% endif %}" {{ block.shopify_attributes }}>
        {{ category_product.featured_image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '350, 600, 850, 1100', sizes: '(min-width:768px) 25vw, 50vw', alt: block.settings.heading }}
        {% if block.settings.film_asset != blank %}<video data-guillo-card-video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"><source data-src="{{ block.settings.film_asset | asset_url }}" type="video/mp4"></video>{% endif %}
        <h2>{{ block.settings.heading | escape }}</h2>
      </a>
    {% endif %}{% endfor %}
  </section>
  <div class="gh-notice"><a href="{{ pages['fit-guide'].url }}">A closer fit. A more distinctive way to dress.</a></div>
  <section class="gh-feature">
    <a class="gh-feature__image" href="{{ feature_product.url }}">{{ feature_product.featured_image | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '600, 1000, 1500', sizes: '(min-width:768px) 50vw, 100vw', alt: feature_product.title }}</a>
    <div class="gh-feature__body"><div><h2>{{ section.settings.feature_heading | escape }}</h2><p>{{ section.settings.feature_text | escape }}</p><a class="gh-link" href="{{ feature_product.url }}">Discover the Signore</a></div></div>
  </section>
  <section class="gh-products">
    <header class="gh-section-heading"><h2>Chosen for you</h2><div><button type="button" data-gh-rail-prev aria-label="Previous products">←</button><button type="button" data-gh-rail-next aria-label="Next products">→</button></div></header>
    <div class="gh-product-rail" data-gh-rail>{% for p in collections.shirts.products limit: 8 %}{% render 'guillo-editorial-card', product: p, image_loading: 'lazy' %}{% endfor %}</div>
  </section>
  <section class="gh-campaign" data-gh-campaign aria-label="Guillo campaign films" aria-roledescription="carousel">
    <div class="gh-campaign__track" data-gh-campaign-track>
      <article class="gh-campaign__slide" aria-label="1 of 2">
        <div class="gh-campaign__pair"><img src="{{ 'guillo-bone-pool.jpg' | asset_url }}" alt="Guillo pinstripe shirt and cream chinos by the pool" loading="lazy" width="1500" height="2000"><img src="{{ 'guillo-black-drive-01.jpg' | asset_url }}" alt="Guillo in black, styled for the evening" loading="lazy" width="1500" height="2000"></div>
        <div class="gh-hero__content"><h2>A certain presence.</h2><a class="gh-button" href="{{ collections['all'].url }}">Shop the collection</a></div>
      </article>
      <article class="gh-campaign__slide" aria-label="2 of 2">
        {% if section.settings.campaign_video != blank %}{{ section.settings.campaign_video | video_tag: class: 'gh-campaign__film', autoplay: false, loop: true, muted: true, controls: false, playsinline: true, preload: 'none', image_size: '1600x' }}{% else %}<video class="gh-campaign__film" data-guillo-card-video muted loop playsinline preload="none" poster="{{ 'guillo-campaign-primary.jpg' | asset_url }}"><source data-src="{{ 'guillo-campaign-primary.mp4' | asset_url }}" type="video/mp4"></video>{% endif %}
        <div class="gh-hero__content"><h2>Guillo in motion.</h2><a class="gh-button" href="{{ collections.shirts.url }}?view=shirts-editorial">Shop shirts</a></div>
      </article>
    </div>
    <div class="gh-campaign__controls"><button type="button" data-gh-slide="0" aria-label="View campaign 1" aria-pressed="true"></button><button type="button" data-gh-slide="1" aria-label="View campaign 2" aria-pressed="false"></button><button class="gh-campaign__pause" type="button" data-gh-pause aria-label="Pause campaign slideshow">Ⅱ</button></div>
  </section>
  <section class="gh-looks">
    <header class="gh-section-heading"><h2>Worn the Guillo way.</h2></header>
    <div class="gh-look-rail">
      {% for block in section.blocks %}{% if block.type == 'look' %}
        {%- assign look_product = block.settings.product -%}
        <article class="gh-look" {{ block.shopify_attributes }}>
          <img src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.alt | escape }}" width="900" height="1200" loading="lazy">
          <button type="button" data-gh-look="{{ look_product.handle }}" aria-label="Shop this look: {{ look_product.title | escape }}">Shop the look <span aria-hidden="true">+</span></button>
          <template><a class="gh-look-product" href="{{ look_product.url }}">{{ look_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: look_product.title }}<div><h2>{{ look_product.title | escape }}</h2><p>{{ look_product.price | money }}</p><span class="gh-link">View product &amp; choose size</span></div></a></template>
        </article>
      {% endif %}{% endfor %}
    </div>
    <a class="gh-instagram gh-link" href="https://www.instagram.com/guilloclothing/" target="_blank" rel="noopener">Follow @guilloclothing</a>
  </section>
  <div class="gh-perks"><a href="{{ pages['fit-guide'].url }}"><strong>Find your fit</strong><span>Size guides for a closer fit</span></a><a href="{{ shop.refund_policy.url }}"><strong>44 days to get it right</strong><span>Returns &amp; exchanges · AU &amp; NZ</span></a></div>
</div>
<dialog class="gc-quick gc-dialog" aria-label="Choose product size" data-gh-quick><button type="button" class="gc-icon-button gc-quick__close" data-gc-close aria-label="Close quick add">×</button><div data-gh-quick-content></div></dialog>
<dialog class="gc-quick gc-dialog" aria-label="Shop the look" data-gh-look-dialog><button type="button" class="gc-icon-button gc-quick__close" data-gc-close aria-label="Close shop the look">×</button><div data-gh-look-content></div></dialog>
{% schema %}
{"name":"Guillo editorial homepage","settings":[{"type":"text","id":"hero_heading","label":"Hero heading","default":"Signature shirts"},{"type":"image_picker","id":"hero_image","label":"Desktop hero image"},{"type":"product","id":"hero_product","label":"Mobile hero product"},{"type":"product","id":"feature_product","label":"Feature product"},{"type":"text","id":"feature_heading","label":"Feature heading","default":"The Signore Chino"},{"type":"textarea","id":"feature_text","label":"Feature description","default":"A clean front. Side-tab adjusters. A considered fit through the leg. Meet the chino with a different point of view."},{"type":"video","id":"campaign_video","label":"Second campaign film"}],"blocks":[{"type":"category","name":"Category tile","limit":4,"settings":[{"type":"text","id":"heading","label":"Heading"},{"type":"product","id":"product","label":"Image product"},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"film_asset","label":"Optional theme MP4 asset"}]},{"type":"look","name":"Shop the look","limit":4,"settings":[{"type":"product","id":"product","label":"Product"},{"type":"text","id":"image_asset","label":"Theme image asset"},{"type":"text","id":"alt","label":"Image description"}]}],"presets":[{"name":"Guillo editorial homepage"}]}
{% endschema %}
