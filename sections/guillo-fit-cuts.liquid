{% comment %}
  Fit guide "The three cuts": stacked rows, each an image beside fit tag,
  serif name, copy, a three-cell measurement grid and an "Order this if" line.
{% endcomment %}

<section class="guillo-fcuts g-pad" id="{{ section.settings.anchor | default: 'fit-cuts' }}">
  <div class="g-container">
    <h2 class="guillo-fcuts__heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="guillo-fcuts__intro">{{ section.settings.text }}</p>
    {%- endif -%}
    <div class="guillo-fcuts__rows">
      {%- for block in section.blocks -%}
        {%- liquid
          assign row_product = block.settings.product
          assign row_image = block.settings.image
          if row_image == blank and row_product != blank
            assign row_image = row_product.featured_image
          endif
          assign row_name = block.settings.name
          if row_name == blank and row_product != blank
            assign row_name = row_product.title
          endif
          assign row_price = block.settings.price
          if row_price == blank and row_product != blank
            assign row_price = row_product.price | money
          endif
        -%}
        <div class="guillo-fcuts__row" {{ block.shopify_attributes }}>
          <div class="guillo-fcuts__media">
            {%- if row_product != blank -%}
              <a href="{{ row_product.url }}" class="guillo-fcuts__media-link" aria-label="{{ row_name }}"></a>
            {%- endif -%}
            {% render 'guillo-img',
              image: row_image,
              fallback: block.settings.fallback_asset,
              alt: row_name,
              class: 'guillo-fcuts__img',
              sizes: '(min-width: 750px) 340px, 100vw',
              position: 'center 20%'
            %}
          </div>
          <div class="guillo-fcuts__body">
            <div class="guillo-fcuts__meta-row">
              <span class="guillo-fcuts__fit">{{ block.settings.fit }}</span>
              <span class="guillo-fcuts__dash" aria-hidden="true"></span>
              <span class="guillo-fcuts__price">{{ row_price }}</span>
            </div>
            <h3 class="guillo-fcuts__name">
              {%- if row_product != blank -%}
                <a href="{{ row_product.url }}">{{ row_name }}</a>
              {%- else -%}
                {{ row_name }}
              {%- endif -%}
            </h3>
            <p class="guillo-fcuts__copy">{{ block.settings.text }}</p>
            <div class="guillo-fcuts__measures">
              <div>
                <div class="guillo-fcuts__m-label">Rise</div>
                <div class="guillo-fcuts__m-value">{{ block.settings.rise }}</div>
              </div>
              <div>
                <div class="guillo-fcuts__m-label">Thigh</div>
                <div class="guillo-fcuts__m-value">{{ block.settings.thigh }}</div>
              </div>
              <div>
                <div class="guillo-fcuts__m-label">Leg opening</div>
                <div class="guillo-fcuts__m-value">{{ block.settings.opening }}</div>
              </div>
            </div>
            <div class="guillo-fcuts__who"><strong>Order this if</strong> {{ block.settings.who }}</div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .guillo-fcuts {
    padding-block: 92px 40px;
    background: var(--g-paper);
  }
  .guillo-fcuts__heading {
    font: 500 clamp(30px, 3vw, 46px)/1.06 var(--g-serif);
    letter-spacing: -0.004em;
    margin: 0 0 14px;
  }
  .guillo-fcuts__intro {
    font: 300 16px/1.7 var(--g-sans);
    color: var(--g-muted);
    margin: 0 0 52px;
    max-width: 640px;
  }
  .guillo-fcuts__rows {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .guillo-fcuts__row {
    display: grid;
    grid-template-columns: 340px 1fr;
    background: var(--g-off);
  }
  .guillo-fcuts__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--g-canvas);
  }
  .guillo-fcuts__media-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .guillo-fcuts__name a {
    color: inherit;
    text-decoration: none;
  }
  .guillo-fcuts__name a:hover { color: var(--g-bronze); }
  .guillo-fcuts__img,
  .guillo-fcuts__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .guillo-fcuts__body {
    padding: 44px 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .guillo-fcuts__meta-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }
  .guillo-fcuts__fit {
    font: 500 10px/1 var(--g-sans);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--g-bronze);
  }
  .guillo-fcuts__dash {
    width: 26px;
    height: 1px;
    background: #BBBDC2;
  }
  .guillo-fcuts__price {
    font: 300 12px/1 var(--g-sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--g-faint);
  }
  .guillo-fcuts__name {
    font: 500 30px/1.15 var(--g-serif);
    margin: 0 0 16px;
  }
  .guillo-fcuts__copy {
    font: 300 15px/1.75 var(--g-sans);
    color: var(--g-muted);
    margin: 0 0 26px;
    max-width: 640px;
  }
  .guillo-fcuts__measures {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: #D6D8DC;
    max-width: 640px;
    margin-bottom: 26px;
  }
  .guillo-fcuts__measures > div {
    background: var(--g-off);
    padding: 16px 18px;
  }
  .guillo-fcuts__measures > div:first-child { padding-left: 0; }
  .guillo-fcuts__m-label {
    font: 500 9px/1 var(--g-sans);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--g-faint);
    margin-bottom: 8px;
  }
  .guillo-fcuts__m-value { font: 300 15px/1 var(--g-sans); }
  .guillo-fcuts__who {
    font: 300 14px/1.6 var(--g-sans);
    color: var(--g-ink);
  }
  .guillo-fcuts__who strong { font-weight: 500; }
  @media screen and (max-width: 989px) {
    .guillo-fcuts { padding-block: 56px 20px; }
    .guillo-fcuts__row { grid-template-columns: 1fr; }
    .guillo-fcuts__body { padding: 28px 22px 34px; }
  }
{% endstylesheet %}

{% schema %}
