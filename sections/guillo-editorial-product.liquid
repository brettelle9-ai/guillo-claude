{% if product.handle contains 'bellagio' %}{{ 'guillo-bellagio.css' | asset_url | stylesheet_tag }}{% endif %}
{%- liquid
  assign rating = product.metafields.reviews.rating.value.rating | plus: 0
  assign rating_count = product.metafields.reviews.rating_count.value | plus: 0
  assign fys_block = blank
  assign ge_catalog = collections.all
  if product.tags contains 'garment:shirt'
    assign ge_catalog = collections.shirts
  elsif product.tags contains 'garment:chino'
    assign ge_catalog = collections.chinos
  elsif product.tags contains 'garment:polo'
    assign ge_catalog = collections.polos
  elsif product.tags contains 'garment:short'
    assign ge_catalog = collections.shorts
  elsif product.tags contains 'garment:tee'
    assign ge_catalog = collections['t-shirts']
  elsif product.tags contains 'garment:accessory'
    assign ge_catalog = collections['accessories-1']
  elsif product.tags contains 'Jeans'
    assign ge_catalog = collections.jeans
  elsif product.tags contains 'garment:pant'
    assign ge_catalog = collections.pants
  endif
  capture family_key
    render 'guillo-product-family-key', product: product
  endcapture
  assign family_candidates = product.metafields.custom.product_group.value.products.value | default: product.metafields.custom.colour_group.value | default: ge_catalog.products
  if family_key == 'shirts'
    assign family_candidates = collections.shirts.products
  elsif family_key == 'luxe-chinos' or family_key == 'signore-chinos' or family_key == 'portofino-polos' or family_key == 'valenti-polos' or family_key == 'capri-shorts' or family_key == 'torino-jeans' or family_key == 'classico-tees'
    assign family_candidates = ge_catalog.products
  endif
  for guide in section.blocks
    if guide.type == 'guillo_find_your_size'
      if guide.settings.family == family_key
        assign fys_block = guide
        break
      elsif guide.settings.family == 'all' or guide.settings.family == blank
        assign fys_block = guide
      endif
    endif
  endfor
  assign availability_mode = section.settings.availability_mode | default: 'normal'
  if product.handle == 'firenze-chevron-shirt'
    assign availability_mode = 'normal'
  endif
  assign garment_name = 'piece'
  if product.tags contains 'garment:shirt'
    assign garment_name = 'shirt'
  elsif product.tags contains 'garment:polo'
    assign garment_name = 'polo'
  elsif product.tags contains 'garment:tee'
    assign garment_name = 'tee'
  endif
  assign fit_text = product.metafields.custom.fit_details.value | default: section.settings.fabric_fit
  assign care_text = product.metafields.custom.care_instructions.value | default: section.settings.care
  assign composition = product.metafields.custom.fabric_composition.value
  assign description = product.description
  assign subtitle = product.metafields.custom.short_description.value
  if subtitle == blank
    assign subtitle = section.settings.subtitle
  endif
  if subtitle == blank
    assign subtitle = product.type
  endif
  assign add_label = 'Add to Bag'
  if availability_mode == 'preorder'
    assign add_label = 'Pre-order'
  elsif availability_mode == 'interest'
    assign add_label = 'Register your interest'
  endif
  assign product_video = section.settings.video
  for media_override in section.blocks
    if media_override.type == 'product_video' and media_override.settings.product.handle == product.handle
      assign product_video = media_override.settings.video | default: product_video
    endif
  endfor
  assign video_index = blank
  assign gallery_count = product.media.size
  for item in product.media
    if item.media_type == 'video' or item.media_type == 'external_video'
      if video_index == blank
        assign video_index = forloop.index0
      endif
    endif
  endfor
  assign use_extra_video = false
  if video_index == blank and product_video != blank
    assign video_index = product.media.size
    assign gallery_count = gallery_count | plus: 1
    assign use_extra_video = true
  endif
  assign colour = product.metafields.custom.colour_name.value | default: ''
  if colour == blank
    for tag in product.tags
      if tag contains 'colour:'
        assign colour = tag | remove: 'colour:' | capitalize
      endif
    endfor
  endif
-%}
<section class="ge-product" data-ge-product data-availability-mode="{{ availability_mode }}" data-add-label="{{ add_label }}" data-product-name="{{ product.title | remove_first: 'The ' | escape }}">
  <div class="ge-main">
    <div class="ge-gallery-wrap">
      <div class="ge-gallery" data-ge-gallery aria-label="{{ product.title | escape }} photographs" tabindex="0">
        {%- for media in product.media -%}
          {%- assign image_loading = 'lazy' -%}{%- if forloop.first -%}{%- assign image_loading = 'eager' -%}{%- endif -%}
          <div class="ge-slide" data-ge-slide{% if media.media_type == 'video' or media.media_type == 'external_video' %} data-ge-video-slide{% endif %}>
            {%- if media.media_type == 'image' -%}<button type="button" data-ge-zoom="{{ forloop.index0 }}" aria-label="Enlarge photograph {{ forloop.index }} of {{ product.title | escape }}">{{ media | image_url: width: 1800 | image_tag: widths: '400, 600, 900, 1200, 1800', sizes: '(min-width: 750px) 43vw, 100vw', loading: image_loading, alt: media.alt }}</button>
            {%- elsif media.media_type == 'video' -%}{{ media | video_tag: controls: true, loop: true, muted: true, preload: 'none', image_size: '1200x' }}{%- else -%}{{ media | media_tag }}{%- endif -%}
          </div>
        {%- endfor -%}
        {%- if use_extra_video -%}<div class="ge-slide ge-slide--video" data-ge-slide data-ge-video-slide>{{ product_video | video_tag: controls: true, loop: true, muted: true, preload: 'none', image_size: '1200x', class: 'ge-product-video' }}</div>{%- endif -%}
      </div>
      <div class="ge-gallery-controls"><button type="button" data-ge-previous aria-label="Previous photograph">‹</button><span data-ge-gallery-count>1 / {{ gallery_count }}</span><button type="button" data-ge-next aria-label="Next photograph">›</button></div>
      {%- if video_index != blank -%}<button type="button" class="ge-video-shortcut" data-ge-video-shortcut="{{ video_index }}" aria-label="View product video"><svg width="25" height="25" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="white"/><path d="m10 7 7 5-7 5z" fill="#454545"/></svg><span>Video</span></button>{%- endif -%}
    </div>
    <div class="ge-info">
      <div class="ge-title-row"><h1>{% render 'guillo-product-heading', product: product %}</h1>{% render 'guillo-editorial-reviews', product: product, summary: true %}</div>
      <p class="ge-subtitle">{% render 'guillo-editorial-subtitle', product: product %}{% if colour != blank %} · {{ colour | escape }}{% endif %}</p>
      <p class="ge-price"><span data-ge-price>{{ product.price | money }}</span> {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</p>
      {% if product.tags contains 'garment:shirt' %}{% render 'guillo-shirt-swatches', product: product %}{% else %}{% render 'guillo-editorial-family-swatches', product: product, candidates: family_candidates, family_key: family_key %}{% endif %}
      {% form 'product', product, id: 'GEProductForm', data-ge-product-form: '', data-purchase-state: 'blocked' %}
        <input type="hidden" name="id" value="{% if product.has_only_default_variant %}{{ product.selected_or_first_available_variant.id }}{% endif %}" data-ge-variant><input type="hidden" name="quantity" value="1">
        {% unless product.has_only_default_variant %}<fieldset class="ge-sizes"><legend>Size: <span data-ge-selected>Choose your size</span></legend><div>
          {%- for variant in product.variants -%}

            <label><input type="radio" name="ge-size" required value="{{ variant.id }}" data-ge-option data-price="{{ variant.price | money | escape }}" data-size="{{ variant.title | escape }}" data-ge-available="{{ variant.available }}"><span>{{ variant.title | escape }}{% unless variant.available %}<small>Notify me</small>{% endunless %}</span></label>
          {%- endfor -%}
        </div></fieldset>{% endunless %}
        {% unless product.has_only_default_variant %}<div class="ge-fitline"><span>{% if product.metafields.custom.model_height != blank and product.metafields.custom.model_size != blank %}Model is {{ product.metafields.custom.model_height }} and wears {{ product.metafields.custom.model_size }}{% else %}{{ product.metafields.custom.fit.value | default: section.settings.fit_note | escape }}{% endif %}</span>{% if fys_block %}<span class="ge-fit-tools"><button type="button" data-gfys-open="gfys-modal-{{ fys_block.id }}" aria-haspopup="dialog">Size Guide</button><button type="button" data-gff-open data-gff-link hidden class="ge-fit-question"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="m12 2 2.7 7.3L22 12l-7.3 2.7L12 22l-2.7-7.3L2 12l7.3-2.7z"/><path d="m20 2 1 3 3 1-3 1-1 3-1-3-3-1 3-1z"/></svg>Find My Size</button></span>{% else %}<button type="button" data-ge-panel="sizeguide">Size Guide</button>{% endif %}</div>
        {% endunless %}
        {% if availability_mode == 'preorder' %}<p class="ge-availability">Pre-order · Ships when the production run arrives.{% if product.metafields.custom.preorder_ships_by != blank %} {{ product.metafields.custom.preorder_ships_by }}{% endif %}</p>{% elsif availability_mode == 'interest' %}<p class="ge-availability">Register your size to hear when this piece becomes available.</p>{% endif %}
        <button type="submit" class="ge-add" data-ge-add>{% if product.available or availability_mode == 'interest' %}{{ add_label }}{% else %}Notify me{% endif %}</button>
      {% endform %}
      {% render 'guillo-editorial-notify', product: product, availability_mode: availability_mode %}
      {% render 'guillo-editorial-services', product: product, availability_mode: availability_mode %}
      <div class="ge-accordions" aria-label="Product information">
        <button type="button" data-ge-panel="details">Details<span aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.1"><path d="m6 3 5 5-5 5"/></svg></span></button>
        <button type="button" data-ge-panel="fabric">Fabric &amp; Fit<span aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.1"><path d="m6 3 5 5-5 5"/></svg></span></button>
        <button type="button" data-ge-panel="care">Care Instructions<span aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.1"><path d="m6 3 5 5-5 5"/></svg></span></button>
        <button type="button" data-ge-panel="delivery">Delivery<span aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.1"><path d="m6 3 5 5-5 5"/></svg></span></button>
      </div>
      {% if product.handle contains 'bellagio' %}{% render 'guillo-bellagio-features' %}{% endif %}
      {% capture pairings %}
        {% assign paired_products = product.metafields.custom.style_with.value %}
        {% if paired_products == blank %}{% if product.tags contains 'garment:shirt' or product.tags contains 'garment:polo' or product.tags contains 'garment:tee' %}{% assign paired_products = collections.chinos.products %}{% elsif product.tags contains 'garment:accessory' %}{% assign paired_products = collections['travel-essentials'].products %}{% else %}{% assign paired_products = collections.shirts.products %}{% endif %}{% endif %}
        {% assign paired_count = 0 %}{% for paired in paired_products %}{% unless paired.id == product.id or paired.handle contains 'test' %}{% if paired_count < 2 %}{% render 'guillo-editorial-card', product: paired, image_loading: 'lazy' %}{% assign paired_count = paired_count | plus: 1 %}{% endif %}{% endunless %}{% endfor %}
      {% endcapture %}{% if paired_count > 0 %}<div class="ge-style"><h2>Wear With</h2>{{ pairings }}</div>{% endif %}
      <nav class="ge-breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a> / <a href="{{ ge_catalog.url }}">{{ ge_catalog.title | escape }}</a> / {{ product.title | escape }}</nav>
    </div>
  </div>
  {% if product.handle == 'bellagio-leather-weekender-duffel-bag' %}{% render 'guillo-bellagio-interior', section: section %}{% endif %}
  {% render 'guillo-runway', section: section %}
  {% render 'guillo-editorial-recommendations', product: product, ge_catalog: ge_catalog, family_candidates: family_candidates, family_key: family_key %}
  {% render 'guillo-editorial-reviews', product: product, candidates: family_candidates, family_key: family_key %}
  {% render 'guillo-editorial-proof' %}
  <div class="ge-sticky" data-ge-sticky><button type="button" data-ge-sticky-add>{% if product.available or availability_mode == 'interest' %}{{ add_label }}{% else %}Notify me{% endif %}</button></div>
  {% if fys_block %}<div class="ge-sizeguide-source">{% render 'guillo-find-your-size', settings: fys_block.settings, unique: fys_block.id, product: product %}{% unless availability_mode == 'interest' %}{% render 'guillo-editorial-fit-finder', product: product, fys: fys_block, settings: section.settings %}{% endunless %}</div>{% endif %}
  <script type="application/json" data-variant-data>{{ product.variants | json }}</script>
  <dialog class="ge-panel gc-dialog" data-ge-info-dialog aria-labelledby="GEPanelTitle"><header><h2 id="GEPanelTitle" data-ge-panel-title></h2><button type="button" data-gc-close aria-label="Close product information">×</button></header><div class="ge-panel-copy" data-ge-panel-content></div><footer><button type="button" data-ge-panel-purchase>{% if product.available or availability_mode == 'interest' %}{{ add_label }}{% else %}Notify me{% endif %}</button></footer></dialog>
  <template data-ge-panel-template="details"><div class="ge-copy">{{ product.description }}</div></template>
  <template data-ge-panel-template="fabric"><div class="ge-copy">{% if composition != blank %}<p>{{ composition }}</p>{% endif %}{% if fit_text != blank %}{{ fit_text }}{% elsif product.description != blank %}{{ product.description }}{% else %}<p>See the product description and size guide for this item.</p>{% endif %}</div></template>
  <template data-ge-panel-template="care"><div class="ge-copy">{% if care_text != blank %}{{ care_text }}{% else %}<p>Follow the care instructions supplied with this item.</p>{% endif %}</div></template>
  <template data-ge-panel-template="delivery"><div class="ge-copy">{% render 'guillo-shipping-panel' %}<h3>44 days to find your fit</h3><p>{% if localization.country.iso_code == 'AU' or localization.country.iso_code == 'NZ' %}Free returns and exchanges within 44 days in Australia and New Zealand.{% else %}Returns and exchanges are available within 44 days. See our returns policy for international return costs.{% endif %}</p><p><a href="{{ shop.shipping_policy.url }}">Full shipping policy</a> · <a href="{{ shop.refund_policy.url }}">Returns &amp; exchanges</a></p></div></template>
  <template data-ge-panel-template="sizeguide"><div class="ge-copy"><p>Compare your measurements with the guide for {{ product.title | escape }}.</p>{% if product.metafields.custom.size_chart != blank %}{{ product.metafields.custom.size_chart }}{% endif %}<p>Use the measurements for this product before choosing your size.</p><a href="{{ pages['fit-guide'].url | default: '/pages/fit-guide' }}" target="_blank" rel="noopener">Open Guillo’s full size guide ↗</a></div></template>
  <dialog class="gc-quick gc-dialog" aria-label="Choose product size" data-ge-quick><button type="button" class="gc-icon-button gc-quick__close" data-gc-close aria-label="Close quick add">×</button><div data-ge-quick-content></div></dialog>
  <dialog class="ge-zoom gc-dialog" aria-label="Product photograph" data-ge-zoom-dialog><button type="button" class="gc-icon-button" data-gc-close aria-label="Close photograph">×</button><img alt="{{ product.title | escape }}" data-ge-zoom-image></dialog>
</section>
{% schema %}
{
  "name": "Editorial product",
  "settings": [
    {
      "type": "image_picker",
      "id": "interior_image",
      "label": "Interior image"
    },
    {
      "type": "text",
      "id": "interior_caption",
      "label": "Interior image caption"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Product video"
    },
    {
      "type": "text",
      "id": "video_caption",
      "label": "Video caption",
      "default": "Watch the fit in motion"
    },
    {
      "type": "select",
      "id": "availability_mode",
      "label": "Availability",
      "default": "normal",
      "options": [
        {
          "value": "normal",
          "label": "In stock / normal"
        },
        {
          "value": "preorder",
          "label": "Pre-order"
        },
        {
          "value": "interest",
          "label": "Register interest only"
        }
      ]
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Product summary"
    },
    {
      "type": "text",
      "id": "fit_note",
      "label": "Short fit note"
    },
    {
      "type": "richtext",
      "id": "fabric_fit",
      "label": "Fabric and fit information"
    },
    {
      "type": "richtext",
      "id": "care",
      "label": "Care information"
    },
    {
      "type": "product",
      "id": "fit_finder_cross_product",
      "label": "Optional comparison product"
    },
    {
      "type": "text",
      "id": "runway_heading",
      "label": "Heading",
      "default": "Try the look."
    }
  ],
  "blocks": [
    {
      "type": "guillo_find_your_size",
      "name": "Guillo Find Your Size",
      "settings": [
        {
          "type": "select",
          "id": "family",
          "label": "Product family for this guide",
          "default": "all",
          "options": [
            {
              "value": "all",
              "label": "This template"
            },
            {
              "value": "shirts",
              "label": "All shirts"
            },
            {
              "value": "luxe-chinos",
              "label": "Luxe Chinos"
            },
            {
              "value": "signore-chinos",
              "label": "Signore Chinos"
            },
            {
              "value": "capri-shorts",
              "label": "Capri Shorts"
            },
            {
              "value": "portofino-polos",
              "label": "Portofino Polos"
            },
            {
              "value": "valenti-polos",
              "label": "Valenti Polos"
            },
            {
              "value": "torino-jeans",
              "label": "Torino Jeans"
            },
            {
              "value": "classico-tees",
              "label": "Classico Tees"
            }
          ]
        },
        {
          "type": "header",
          "content": "Trigger"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Guillo Find Your Size"
        },
        {
          "type": "checkbox",
          "id": "show_icon",
          "label": "Show ruler icon",
          "default": true
        },
        {
          "type": "header",
          "content": "Modal Header"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow label",
          "default": "Size Guide"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Guillo Find Your Size"
        },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "Subheading",
          "default": "Use your body measurements to choose the right Guillo fit."
        },
        {
          "type": "header",
          "content": "Logo Loader",
          "info": "Slow pulse while the popup opens. Upload your Guillo logo or paste a URL."
        },
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Loader logo image"
        },
        {
