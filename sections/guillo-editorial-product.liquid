        },
        {
          "type": "text",
          "id": "chart_heading",
          "label": "Heading",
          "default": "Size Chart"
        },
        {
          "type": "checkbox",
          "id": "show_unit_toggle",
          "label": "Show CM / IN toggle",
          "default": true
        },
        {
          "type": "select",
          "id": "default_unit",
          "label": "Default unit",
          "options": [
            {
              "value": "cm",
              "label": "CM"
            },
            {
              "value": "in",
              "label": "IN"
            }
          ],
          "default": "cm"
        },
        {
          "type": "textarea",
          "id": "measurements_cm",
          "label": "Measurements - CM",
          "default": "Size|Chest|Shoulder|Length|Sleeve\nXS|92|42|70|62\nS|96|44|72|63\nM|100|46|74|64\nL|106|48|76|65\nXL|112|50|78|66\nXXL|118|52|80|67"
        },
        {
          "type": "textarea",
          "id": "measurements_in",
          "label": "Measurements - IN",
          "default": "Size|Chest|Shoulder|Length|Sleeve\nXS|36.2|16.5|27.6|24.4\nS|37.8|17.3|28.3|24.8\nM|39.4|18.1|29.1|25.2\nL|41.7|18.9|29.9|25.6\nXL|44.1|19.7|30.7|26.0\nXXL|46.5|20.5|31.5|26.4"
        },
        {
          "type": "header",
          "content": "Fit Notes"
        },
        {
          "type": "checkbox",
          "id": "show_fit_notes",
          "label": "Show fit notes",
          "default": true
        },
        {
          "type": "text",
          "id": "fit_notes_heading",
          "label": "Heading",
          "default": "Fit Notes"
        },
        {
          "type": "text",
          "id": "note1_title",
          "label": "Note 1 - title",
          "default": "Between sizes?"
        },
        {
          "type": "textarea",
          "id": "note1_text",
          "label": "Note 1 - text",
          "default": "Choose the larger size for more comfort."
        },
        {
          "type": "text",
          "id": "note2_title",
          "label": "Note 2 - title",
          "default": "Prefer a sharper fit?"
        },
