{%- liquid
  assign rating = product.metafields.reviews.rating.value.rating | plus: 0
  assign rating_count = product.metafields.reviews.rating_count.value | plus: 0
  assign fys_block = section.blocks | where: 'type', 'guillo_find_your_size' | first
  assign video_index = blank
  assign gallery_count = product.media.size
  for item in product.media
    if item.media_type == 'video' or item.media_type == 'external_video'
      if video_index == blank
        assign video_index = forloop.index0
      endif
    endif
  endfor
  assign use_extra_video = false
  if video_index == blank and section.settings.video != blank
    assign video_index = product.media.size
    assign gallery_count = gallery_count | plus: 1
    assign use_extra_video = true
  endif
  assign colour = product.metafields.custom.colour_name.value | default: ''
  if colour == blank
    for tag in product.tags
      if tag contains 'colour:'
        assign colour = tag | remove: 'colour:' | capitalize
      endif
    endfor
  endif
  assign shirt_style = 'Short-sleeve printed shirt'
  if product.tags contains 'long-sleeve'
    assign shirt_style = 'Long-sleeve fitted shirt'
  elsif product.tags contains 'grandad-collar'
    assign shirt_style = 'Grandad collar shirt'
  elsif product.handle contains 'siracusa' or product.handle contains 'vulcano' or product.handle contains 'turin' or product.handle contains 'rapallo'
    assign shirt_style = 'Short-sleeve fitted shirt'
  endif
-%}
<section class="ge-product" data-ge-product data-product-name="{{ product.title | remove_first: 'The ' | escape }}">
  <div class="ge-main">
    <div class="ge-gallery-wrap">
      <div class="ge-gallery" data-ge-gallery aria-label="{{ product.title | escape }} photographs" tabindex="0">
        {%- for media in product.media -%}
          {%- assign image_loading = 'lazy' -%}{%- if forloop.first -%}{%- assign image_loading = 'eager' -%}{%- endif -%}
          <div class="ge-slide" data-ge-slide{% if media.media_type == 'video' or media.media_type == 'external_video' %} data-ge-video-slide{% endif %}>
            {%- if media.media_type == 'image' -%}<button type="button" data-ge-zoom="{{ forloop.index0 }}" aria-label="Enlarge photograph {{ forloop.index }} of {{ product.title | escape }}">{{ media | image_url: width: 1800 | image_tag: widths: '400, 600, 900, 1200, 1800', sizes: '(min-width: 750px) 43vw, 100vw', loading: image_loading, alt: media.alt }}</button>
            {%- elsif media.media_type == 'video' -%}{{ media | video_tag: controls: true, loop: true, muted: true, preload: 'none', image_size: '1200x' }}{%- else -%}{{ media | media_tag }}{%- endif -%}
          </div>
        {%- endfor -%}
        {%- if use_extra_video -%}<div class="ge-slide ge-slide--video" data-ge-slide data-ge-video-slide>{{ section.settings.video | video_tag: controls: true, loop: true, muted: true, preload: 'none', image_size: '1200x', class: 'ge-product-video' }}</div>{%- endif -%}
      </div>
      <div class="ge-gallery-controls"><button type="button" data-ge-previous aria-label="Previous photograph">‹</button><span data-ge-gallery-count>1 / {{ gallery_count }}</span><button type="button" data-ge-next aria-label="Next photograph">›</button></div>
      {%- if video_index != blank -%}<button type="button" class="ge-video-shortcut" data-ge-video-shortcut="{{ video_index }}" aria-label="View product video"><svg width="25" height="25" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="white"/><path d="m10 7 7 5-7 5z" fill="#454545"/></svg><span>Video</span></button>{%- endif -%}
    </div>
    <div class="ge-info">
      <div class="ge-title-row"><h1>{{ product.title | remove_first: 'The ' | escape }}</h1>{% render 'guillo-shirt-reviews', product: product, summary: true %}</div>
      <p class="ge-subtitle">{{ shirt_style }} in {{ colour | downcase }}</p>
      <p class="ge-price"><span data-ge-price>{{ product.price | money }}</span> {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</p>
      {% render 'guillo-shirt-swatches', product: product, editorial: true %}
      {% form 'product', product, id: 'GEProductForm' %}
        <input type="hidden" name="id" value="" data-ge-variant><input type="hidden" name="quantity" value="1">
        <fieldset class="ge-sizes"><legend>Size: <span data-ge-selected>Choose your size</span></legend><div>
          {%- for variant in product.variants -%}

            <label><input type="radio" name="ge-size" required value="{{ variant.id }}" data-ge-option data-price="{{ variant.price | money | escape }}" data-size="{{ variant.title | escape }}" {% unless variant.available %}disabled{% endunless %}><span>{{ variant.title | escape }}</span></label>
          {%- endfor -%}
        </div></fieldset>
        <div class="ge-fitline"><span>{% if product.metafields.custom.model_height != blank and product.metafields.custom.model_size != blank %}Model is {{ product.metafields.custom.model_height }} and wears {{ product.metafields.custom.model_size }}{% else %}Slim fit through the body{% endif %}</span>{% if fys_block %}<span class="ge-fit-tools"><button type="button" data-gfys-open="gfys-modal-{{ fys_block.id }}" aria-haspopup="dialog">Size Guide</button><button type="button" data-gff-open data-gff-link hidden class="ge-fit-question"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="m12 2 2.7 7.3L22 12l-7.3 2.7L12 22l-2.7-7.3L2 12l7.3-2.7z"/><path d="m20 2 1 3 3 1-3 1-1 3-1-3-3-1 3-1z"/></svg>Find My Size</button></span>{% else %}<button type="button" data-ge-panel="sizeguide">Size Guide</button>{% endif %}</div>
        <button type="submit" class="ge-add" data-ge-add {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to Bag{% else %}Sold out{% endif %}</button>
      {% endform %}
      <div class="ge-delivery"><svg width="19" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="m3 7 9-5 9 5v10l-9 5-9-5zM3 7l9 5 9-5M12 12v10M7 4.8l10 5"/></svg><span>Ships from Brisbane<br><button type="button" data-ge-panel="delivery">Delivery to {{ localization.country.name }} · See delivery options</button></span></div>
      <div class="ge-accordions" aria-label="Product information">
        <button type="button" data-ge-panel="details">Details<span>›</span></button>
        <button type="button" data-ge-panel="fabric">Fabric &amp; Fit<span>›</span></button>
        <button type="button" data-ge-panel="care">Care Instructions<span>›</span></button>
        <button type="button" data-ge-panel="delivery">Delivery<span>›</span></button>
      </div>
      <div class="ge-style"><h2>Style It With</h2>{% assign style_handles = 'the-luxe-chino-stone,the-signore-chino-latte' | split: ',' %}{% for handle in style_handles %}{% assign paired = all_products[handle] %}{% if paired != blank %}{% render 'guillo-editorial-card', product: paired, image_loading: 'lazy' %}{% endif %}{% endfor %}</div>
      <nav class="ge-breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a> / <a href="{{ collections.shirts.url }}?view=shirts-editorial">Shirts</a> / {{ product.title | escape }}</nav>
    </div>
  </div>
  <div class="ge-related"><div class="ge-rail-heading"><h2>More You’ll Love</h2><div><button type="button" data-ge-rail-previous aria-label="Previous recommendations">‹</button><button type="button" data-ge-rail-next aria-label="Next recommendations">›</button></div></div><div class="ge-rail">{% for related in collections.shirts.products limit: 9 %}{% unless related.id == product.id %}{% render 'guillo-editorial-card', product: related, image_loading: 'lazy' %}{% endunless %}{% endfor %}</div></div>
  {% capture navy_rail %}{% assign navy_count = 0 %}{% for navy_product in collections.all.products limit: 50 %}{% if navy_product.tags contains 'colour:navy' and navy_product.id != product.id and navy_count < 8 %}{% render 'guillo-editorial-card', product: navy_product, image_loading: 'lazy' %}{% assign navy_count = navy_count | plus: 1 %}{% endif %}{% endfor %}{% endcapture %}
  {% if navy_count > 0 %}<div class="ge-related"><div class="ge-rail-heading"><h2>More In This Colour</h2><div><button type="button" data-ge-rail-previous aria-label="Previous navy products">‹</button><button type="button" data-ge-rail-next aria-label="Next navy products">›</button></div></div><div class="ge-rail">{{ navy_rail }}</div></div>{% endif %}
  {% render 'guillo-shirt-reviews', product: product %}
  <div class="ge-sticky" data-ge-sticky><button type="button" data-ge-sticky-add>{% if product.available %}Add to Bag{% else %}Sold out{% endif %}</button></div>
  {% if fys_block %}<div class="ge-sizeguide-source">{% render 'guillo-find-your-size', settings: fys_block.settings, unique: fys_block.id, product: product %}{% render 'guillo-editorial-fit-finder', product: product, fys: fys_block, settings: section.settings %}<script type="application/json" data-variant-data>{{ product.variants | json }}</script></div>{% endif %}
  <dialog class="ge-panel gc-dialog" data-ge-info-dialog aria-labelledby="GEPanelTitle"><header><h2 id="GEPanelTitle" data-ge-panel-title></h2><button type="button" data-gc-close aria-label="Close product information">×</button></header><div class="ge-panel-copy" data-ge-panel-content></div><footer><button type="button" data-ge-panel-purchase>{% if product.available %}Add to Bag{% else %}Sold out{% endif %}</button></footer></dialog>
  <template data-ge-panel-template="details"><div class="ge-copy">{{ product.description }}</div></template>
  <template data-ge-panel-template="fabric"><div class="ge-copy">{% if product.handle == 'firenze-chevron-shirt' %}<p>A navy chevron print on lightweight, breathable fabric with a cool-touch finish.</p><p>Stretch construction, a wrinkle-resistant finish and a slim, tapered shape. Short sleeves and a button-down collar.</p>{% else %}<p>{{ product.description | strip_html | truncatewords: 70 }}</p>{% endif %}{% if product.metafields.custom.fabric_composition != blank %}<p>{{ product.metafields.custom.fabric_composition }}</p>{% endif %}</div></template>
  <template data-ge-panel-template="care"><div class="ge-copy"><p>Machine wash cold. Hang dry.</p><p>Follow the care label supplied with your shirt.</p></div></template>
  <template data-ge-panel-template="delivery"><div class="ge-copy">{% render 'guillo-shipping-panel' %}<p><a href="{{ shop.shipping_policy.url }}">Full shipping policy</a> · <a href="{{ shop.refund_policy.url }}">Returns &amp; exchanges</a></p></div></template>
  <template data-ge-panel-template="sizeguide"><div class="ge-copy"><p>The Firenze has a slim cut through the body, with stretch for ease of movement.</p>{% if product.metafields.custom.size_chart != blank %}{{ product.metafields.custom.size_chart }}{% endif %}<p>Compare your measurements with the shirt size chart before choosing.</p><a href="{{ pages['fit-guide'].url | default: '/pages/fit-guide' }}" target="_blank" rel="noopener">Open Guillo’s full size guide ↗</a></div></template>
  <dialog class="gc-quick gc-dialog" aria-label="Choose shirt size" data-ge-quick><button type="button" class="gc-icon-button gc-quick__close" data-gc-close aria-label="Close quick add">×</button><div data-ge-quick-content></div></dialog>
  <dialog class="ge-zoom gc-dialog" aria-label="Product photograph" data-ge-zoom-dialog><button type="button" class="gc-icon-button" data-gc-close aria-label="Close photograph">×</button><img alt="{{ product.title | escape }}" data-ge-zoom-image></dialog>
</section>
