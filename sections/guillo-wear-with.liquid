{% comment %}
  "Wear it with" horizontal product scroller. Pick the products by hand in
  the section's Products picker; with none picked it falls back to a chosen
  collection, then to Shopify's related-product recommendations.
{% endcomment %}

{%- liquid
  # Hand-picked products win over any automatic source.
  assign picked_products = section.settings.products
  assign picked = false
  if picked_products != blank and picked_products.count > 0
    assign picked = true
  endif

  unless picked
    if section.settings.collection != blank
      assign source_products = section.settings.collection.products
    elsif recommendations.performed? and recommendations.products_count > 0
      assign source_products = recommendations.products
    elsif product
      assign source_collection = collection | default: product.collections.first
      assign source_products = source_collection.products
    endif
  endunless
-%}

<section class="guillo-wear">
  <div class="guillo-wear__head g-pad">
    <div>
      <h2 class="guillo-wear__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.wardrobe_note != blank -%}
        <p class="guillo-wear__note">
          {%- if section.settings.wardrobe_link != blank -%}
            <a href="{{ section.settings.wardrobe_link }}">{{ section.settings.wardrobe_note }}</a>
          {%- else -%}
            {{ section.settings.wardrobe_note }}
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>
    {%- if section.settings.collection != blank -%}
      <a href="{{ section.settings.collection.url }}" class="g-link">View all</a>
    {%- endif -%}
  </div>
  <div class="guillo-wear__scroller">
    {%- if picked -%}
      {%- for item in picked_products -%}
        {%- if item.id != product.id -%}
          <div class="guillo-wear__cell">
            {% render 'guillo-product-card', product: item, show_quick: false, sizes: '(min-width: 750px) 20vw, 60vw' %}
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- for item in source_products limit: section.settings.products_to_show -%}
        {%- unless item.id == product.id -%}
          <div class="guillo-wear__cell">
            {% render 'guillo-product-card', product: item, show_quick: false, sizes: '(min-width: 750px) 20vw, 60vw' %}
          </div>
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .guillo-wear {
    padding: 88px 0 96px;
    background: var(--g-paper);
  }
  .guillo-wear__head {
    padding-bottom: 34px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 30px;
  }
  .guillo-wear__heading {
    font: 400 clamp(19px, 1.8vw, 26px)/1.2 var(--g-sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--g-ink);
    margin: 0;
  }
  /* The wardrobe discount is a quiet aside under the heading, not a promo
     banner — it applies automatically at checkout either way. */
  .guillo-wear__note {
    font: 300 12px/1.6 var(--g-sans);
    letter-spacing: 0.02em;
    color: var(--g-whisper);
    margin: 10px 0 0;
  }
  .guillo-wear__note a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--g-line);
    padding-bottom: 2px;
  }
  .guillo-wear__note a:hover {
    color: var(--g-bronze);
    border-bottom-color: var(--g-bronze);
  }
  .guillo-wear__scroller {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    padding: 0 40px 6px;
    scroll-snap-type: x mandatory;
  }
  .guillo-wear__cell {
    flex: 0 0 calc((100% - 100px) / 5.4);
    min-width: 210px;
    scroll-snap-align: start;
  }
  @media screen and (max-width: 749px) {
    .guillo-wear { padding: 56px 0 64px; }
    .guillo-wear__scroller { padding-inline: 20px; }
    .guillo-wear__cell { min-width: 62vw; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Guillo wear it with",
  "settings": [
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 12,
      "info": "Pick the products to show, in order. Leave empty to fall back to the collection below."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wear it with"
    },
    {
      "type": "text",
      "id": "wardrobe_note",
      "label": "Wardrobe note",
      "default": "Build your wardrobe — three pieces or more, 20% off automatically.",
      "info": "Matches the live “Wardrobe 20” automatic discount. Leave blank to hide."
    },
    {
      "type": "url",
      "id": "wardrobe_link",
      "label": "Wardrobe note link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Used only when no Product blocks are added. Leave empty on product pages to use related products."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 8,
      "info": "Applies to the collection and related-product fallbacks, not to Product blocks."
    }
  ],
  "presets": [
    {
      "name": "Guillo wear it with",
      "category": "Guillo"
    }
  ]
}
{% endschema %}

