{% comment %}
  Near-black Guillo footer: logo + brand line, three menu columns,
  copyright row with payment chips.
{% endcomment %}

<nav class="guillo-social-strip" aria-label="Guillo social media">{% assign platforms = 'instagram,facebook,youtube,tiktok,pinterest,twitter' | split: ',' %}{% for platform in platforms %}{% assign setting_key = platform | prepend: 'social_' %}{% assign profile_url = section.settings[setting_key] %}{% if profile_url == blank and platform == 'instagram' %}{% assign profile_url = 'https://www.instagram.com/guilloclothing/' %}{% elsif profile_url == blank and platform == 'facebook' %}{% assign profile_url = 'https://www.facebook.com/p/Guillo-Clothing-61563291266328/' %}{% endif %}{% if profile_url != blank %}<a href="{{ profile_url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ platform | capitalize }}"><svg viewBox="0 0 20 20" aria-hidden="true">{% render 'icon', icon: platform %}</svg></a>{% endif %}{% endfor %}</nav>
<footer id="GuilloFooter-{{ section.id }}" class="guillo-footer g-pad" style="--guillo-footer-navy:{{ section.settings.background | default: '#14232c' }}">
  <div class="g-container">
    <div class="guillo-footer__grid">
      <div class="guillo-footer__brand">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 400 | image_tag: class: 'guillo-footer__logo', alt: shop.name }}
        {%- else -%}
          <img src="{{ 'guillo-logo-white.png' | asset_url }}" alt="{{ shop.name }}" class="guillo-footer__logo" loading="lazy" width="720" height="120">
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="guillo-footer__tagline">{{ section.settings.text }}</p>
        {%- endif -%}

      </div>
      {%- for block in section.blocks -%}
        <details class="guillo-footer__col" open {{ block.shopify_attributes }}>
          <summary class="guillo-footer__col-title">{{ block.settings.title | default: block.settings.menu.title | escape }}<span class="guillo-footer__menu-icon" aria-hidden="true"></span></summary>
          <div class="guillo-footer__links">
            {%- for link in block.settings.menu.links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          </div>
        </details>
      {%- endfor -%}
    </div>
    <div class="guillo-footer__bottom">
      <span class="guillo-footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_note }}</span>
      {%- if section.settings.payment_labels != blank -%}
        <div class="guillo-footer__payments">
          {%- assign labels = section.settings.payment_labels | split: ',' -%}
          {%- for label in labels -%}
            <span class="guillo-footer__payment-chip">{{ label | strip }}</span>
          {%- endfor -%}
        </div>
      {%- elsif section.settings.show_payment_icons -%}
        <div class="guillo-footer__payments">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'guillo-footer__payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

<script>
(() => {
  const footer = document.getElementById('GuilloFooter-{{ section.id }}');
  if (!footer || footer.dataset.menusReady) return;
  footer.dataset.menusReady = 'true';
  const mobile = matchMedia('(max-width: 749px)');
  const menus = [...footer.querySelectorAll('.guillo-footer__col')];
  const sync = () => menus.forEach(menu => { menu.open = !mobile.matches; });
  sync();
  mobile.addEventListener('change', sync);
  footer.addEventListener('click', event => {
    if (!mobile.matches && event.target.closest('summary')) event.preventDefault();
  });
})();
</script>

{% stylesheet %}
  .guillo-footer {
    background: var(--g-black);
    color: var(--g-faint);
    padding-block: 70px 34px;
  }
  .guillo-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 56px;
    padding-bottom: 56px;
    border-bottom: 1px solid #202226;
  }
  .guillo-footer__logo {
    height: 26px;
    width: auto;
    margin-bottom: 26px;
    display: block;
  }
  .guillo-footer__tagline {
    font: 300 14px/1.75 var(--g-sans);
    color: var(--g-faint);
    margin: 0;
    max-width: 300px;
  }
  .guillo-footer__col-title {
    font: 500 10px/1 var(--g-sans);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--g-off);
    margin-bottom: 20px;
  }
  .guillo-footer__links {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .guillo-footer__links a {
    font: 300 14px/1 var(--g-sans);
    color: var(--g-faint);
    text-decoration: none;
  }
  .guillo-footer__links a:hover { color: var(--g-off); }
  .guillo-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    padding-top: 26px;
    flex-wrap: wrap;
  }
  .guillo-footer__copyright {
    font: 300 12px/1 var(--g-sans);
    color: #4C4E54;
  }
  .guillo-footer__payments {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .guillo-footer__payment-icon {
    height: 24px;
    width: auto;
    opacity: 0.55;
  }
  .guillo-footer__payment-chip {
    font: 500 10px/1 var(--g-sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #4C4E54;
    border: 1px solid #202226;
    padding: 8px 11px;
  }
  @media screen and (max-width: 989px) {
    .guillo-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
    .guillo-footer__brand { grid-column: 1 / -1; }
  }

  .guillo-footer__col-title{list-style:none;cursor:default}
  .guillo-footer__col-title::-webkit-details-marker{display:none}
  .guillo-footer__menu-icon{display:none}
  @media(max-width:749px){
    body .guillo-footer{padding-block:28px 22px}
    body .guillo-footer .guillo-footer__grid{grid-template-columns:1fr;gap:0;padding-bottom:0;border-bottom:0}
    body .guillo-footer .guillo-footer__brand{grid-column:1/-1;padding-bottom:22px}
    body .guillo-footer .guillo-footer__logo{height:21px;margin-bottom:12px}
    body .guillo-footer .guillo-footer__tagline{font-size:12px;line-height:1.6;max-width:270px}
    body .guillo-footer .guillo-footer__col{border-top:1px solid #ffffff24}
    body .guillo-footer .guillo-footer__col-title{display:flex;align-items:center;justify-content:space-between;min-height:48px;margin:0;cursor:pointer;letter-spacing:.15em}
    body .guillo-footer .guillo-footer__col-title:focus-visible{outline:2px solid currentColor;outline-offset:3px}
    .guillo-footer__menu-icon{display:block;position:relative;width:12px;height:12px}
    .guillo-footer__menu-icon::before,.guillo-footer__menu-icon::after{content:'';position:absolute;left:0;top:5px;width:12px;height:1px;background:currentColor}
    .guillo-footer__menu-icon::after{transform:rotate(90deg)}
    .guillo-footer__col[open] .guillo-footer__menu-icon::after{transform:rotate(0deg)}
    body .guillo-footer .guillo-footer__links{gap:0;padding:0 0 12px}
    body .guillo-footer .guillo-footer__links a{min-height:44px;font-size:13px;line-height:1.4}
    body .guillo-footer .guillo-footer__bottom{border-top:1px solid #ffffff24;gap:14px;padding-top:20px;flex-direction:column;align-items:flex-start}
    body .guillo-footer .guillo-footer__copyright{font-size:10px;line-height:1.5}
    body .guillo-footer .guillo-footer__payments{gap:5px}
    body .guillo-footer .guillo-footer__payment-chip{font-size:8px;letter-spacing:.05em;padding:6px 7px}
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Guillo footer",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (light)"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Brand line",
      "default": "Designed for movement, escapes and life beyond routine. Brought to life in Brisbane."
    },
    {
      "type": "text",
      "id": "copyright_note",
      "label": "Copyright note",
      "default": "Brisbane, Australia."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "text",
      "id": "payment_labels",
      "label": "Payment text chips",
      "info": "Comma-separated labels rendered as bordered chips instead of icons.",
      "default": "Afterpay, Visa, Mastercard, Apple Pay, Paypal"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Footer background",
      "default": "#14232c"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram profile"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook profile"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "Youtube profile"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "Tiktok profile"
    },
    {
      "type": "url",
      "id": "social_pinterest",
      "label": "Pinterest profile"
    },
    {
      "type": "url",
      "id": "social_twitter",
      "label": "Twitter profile"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Guillo footer",
      "category": "Guillo",
      "blocks": [
        {
          "type": "menu",
          "settings": {
            "title": "Shop"
          }
        },
        {
          "type": "menu",
          "settings": {
            "title": "Help"
          }
        },
        {
          "type": "menu",
          "settings": {
            "title": "Guillo"
          }
        }
      ]
    }
  ]
}
{% endschema %}
