{% if request.page_type == 'index' %}
{{ 'guillo-editorial-home.css' | asset_url | stylesheet_tag }}
{{ 'guillo-home-cinematic.css' | asset_url | stylesheet_tag }}
<link rel="preload" as="image" href="{{ 'guillo-home-logo-exact.png' | asset_url }}">
{% endif %}
{%- capture search_icon -%}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>{%- endcapture -%}
{%- assign preview_menu = linklists['guillo-redesign-main'] | default: section.settings.menu -%}
<div class="gc-header" data-gc-header>
  {% if request.page_type == 'index' %}{% render 'guillo-header-atmosphere' %}{% endif %}
  <div class="gc-header__row">
    <button class="gc-icon-button gc-header__menu" type="button" data-gc-menu-open aria-label="Open menu" aria-controls="GCNavigation" aria-expanded="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg><span>Menu</span></button>
    <a class="gc-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home"><img src="{{ 'guillo-wordmark-black.png' | asset_url }}" width="720" height="120" alt="{{ shop.name | escape }}" loading="eager">{% if request.page_type == 'index' %}{% render 'guillo-cinematic-brand' %}{% endif %}</a>
    <nav class="gc-header__desktop-nav" aria-label="Main navigation">
      {%- for link in preview_menu.links limit: 6 -%}
        {%- capture child_id -%}root-{{ forloop.index }}{%- endcapture -%}
        {%- if link.links.size > 0 -%}<a href="{{ link.url }}" data-gc-mega-trigger="{{ child_id }}" aria-controls="GCMega-{{ child_id }}" aria-expanded="false">{{ link.title | escape }}</a>{%- else -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endif -%}
      {%- endfor -%}
    </nav>
    {% if request.page_type == 'index' %}
    <div class="gh-home-tools">
      <details class="gh-country"><summary aria-label="Choose country and currency"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18M5 7h14M5 17h14"/></svg></summary><div class="gh-country__panel">{% form 'localization', id: 'GCHomeLocalization' %}<label for="GCHomeCountry">Country and currency</label><select name="country_code" id="GCHomeCountry">{% for country in localization.available_countries %}<option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>{{ country.name }} · {{ country.currency.iso_code }}</option>{% endfor %}</select><button type="submit">Update location</button>{% endform %}</div></details>
      <a href="{{ pages['contact'].url | default: '/pages/contact' }}" aria-label="Contact Guillo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 6 9 7 9-7"/></svg></a>
      <button type="button" class="gh-atmosphere-toggle" data-gh-atmosphere-toggle aria-label="Pause logo atmosphere" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path class="gh-pause-lines" d="M10 8v8M14 8v8"/><path class="gh-play-triangle" d="m10 8 6 4-6 4z"/></svg></button>
    </div>
    {% endif %}
    <div class="gc-header__actions"><a class="gc-header__account" href="{{ routes.account_url }}" aria-label="Account"><svg class="gh-account-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><circle cx="12" cy="7" r="3.5"/><path d="M5 21v-3a7 7 0 0 1 14 0v3z"/></svg><span class="gh-account-text">Account</span></a><a class="gc-icon-button" href="{{ routes.cart_url }}" aria-label="Open shopping bag"><svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M5 8h14l1 13H4zM9 8V6a3 3 0 0 1 6 0v2"/></svg></a></div>
  </div>
  <form class="gc-header__search" action="{{ routes.search_url }}" method="get" role="search"><input type="hidden" name="type" value="product"><input type="search" name="q" placeholder="Try searching for…" data-gc-type-search data-gc-search-input aria-controls="GCSearchPanel" aria-expanded="false" data-search-terms="{{ section.settings.search_suggestions | escape }}" aria-label="Search Guillo products" autocomplete="off"><button type="submit" aria-label="Search"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button></form>
  <div class="gc-mega-shade" data-gc-mega-shade hidden></div>
  {%- for link in preview_menu.links limit: 6 -%}{%- if link.links.size > 0 -%}{%- capture mega_id -%}root-{{ forloop.index }}{%- endcapture -%}{% render 'guillo-editorial-mega-menu', link: link, panel_id: mega_id, settings: section.settings %}{%- endif -%}{%- endfor -%}
  {% render 'guillo-editorial-search', section: section %}
</div>
<dialog class="gc-menu gc-dialog" id="GCNavigation" aria-label="Guillo navigation" data-gc-menu>
  <div class="gc-menu__top"><button type="button" class="gc-icon-button" data-gc-menu-back aria-label="Back to previous menu" hidden>‹</button><a class="gc-menu__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home"><img src="{{ 'guillo-wordmark-black.png' | asset_url }}" width="720" height="120" alt="{{ shop.name | escape }}"></a><span class="gc-visually-hidden" data-gc-menu-title>Menu</span><button type="button" class="gc-icon-button" data-gc-close aria-label="Close menu" autofocus>×</button></div>
  <form class="gc-menu__search" action="{{ routes.search_url }}" method="get" role="search"><input type="hidden" name="type" value="product"><input type="search" name="q" placeholder="Try searching for…" data-gc-type-search data-gc-menu-search data-search-terms="{{ section.settings.search_suggestions | escape }}" aria-label="Search products from menu" autocomplete="off"><button type="submit" aria-label="Search">{{ search_icon }}</button></form>
  <div class="gc-menu__body">{% render 'guillo-editorial-menu-panel', links: preview_menu.links, panel_id: 'root', title: 'Menu' %}</div>
  <footer class="gc-menu__footer"><a href="{{ routes.account_url }}">Your account</a>{%- form 'localization', id: 'GCMenuLocalization' -%}<label class="gc-visually-hidden" for="GCCountry">Country and currency</label><select name="country_code" id="GCCountry" data-gc-country>{%- for country in localization.available_countries -%}<option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>{{ country.name }} · {{ country.currency.iso_code }}</option>{%- endfor -%}</select><button type="submit" aria-label="Update country">→</button>{%- endform -%}</footer>
</dialog>
<style>
  .gh-account-icon{display:none}
  .gc-collection-preview .gc-header__logo{display:block;padding:0;line-height:0;letter-spacing:0}
  .gc-header__logo img{display:block;width:160px;height:auto;max-width:100%;object-fit:contain}
  @media(max-width:749px){.gc-header__logo img{width:146px;max-width:36vw}}
</style>
{{ 'guillo-editorial-navigation.css' | asset_url | stylesheet_tag }}
<script src="{{ 'guillo-editorial-navigation.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Editorial header",
  "class": "gc-preview-header-section",
  "settings": [
    {
      "type": "textarea",
      "id": "search_suggestions",
      "label": "Animated search suggestions",
      "default": "Shirts\nSlim fit\nLuxe chinos\nKnit polos\nNew arrivals"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "textarea",
      "id": "popular_searches",
      "label": "Popular search links",
      "default": "Shirts\nSlim fit\nLuxe chinos\nKnit polos"
    },
    {
      "type": "image_picker",
      "id": "mega_image_new-in",
      "label": "New in \u2014 dropdown feature image"
    },
    {
      "type": "image_picker",
      "id": "mega_image_pants",
      "label": "Pants \u2014 dropdown feature image"
    },
    {
      "type": "image_picker",
      "id": "mega_image_shirts",
      "label": "Shirts \u2014 dropdown feature image"
    },
    {
      "type": "image_picker",
      "id": "mega_image_polos",
      "label": "Polos \u2014 dropdown feature image"
    },
    {
      "type": "image_picker",
      "id": "mega_image_tees",
      "label": "Tees \u2014 dropdown feature image"
    },
    {
      "type": "image_picker",
      "id": "mega_image_accessories",
      "label": "Accessories \u2014 dropdown feature image"
    },
    {
      "type": "image_picker",
      "id": "search_image_new-arrivals",
      "label": "Search \u2014 New Arrivals image"
    },
    {
      "type": "image_picker",
      "id": "search_image_best-sellers",
      "label": "Search \u2014 Bestsellers image"
    },
    {
      "type": "image_picker",
      "id": "search_image_shirts",
      "label": "Search \u2014 Shirts image"
    },
    {
      "type": "image_picker",
      "id": "search_image_chinos",
      "label": "Search \u2014 Chinos image"
    },
    {
      "type": "image_picker",
      "id": "search_image_polos",
      "label": "Search \u2014 Polos image"
    },
    {
      "type": "image_picker",
      "id": "search_image_shorts",
      "label": "Search \u2014 Shorts image"
    }
  ]
}
{% endschema %}

