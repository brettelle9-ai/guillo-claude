    --gcart-btn-bg: {{ section.settings.button_bg }};
    --gcart-btn-text: {{ section.settings.button_text }};
    --gcart-checkout-hover: {{ section.settings.checkout_hover_color }};
    --gcart-accent: {{ section.settings.accent_color }};
    --gcart-base-size: {{ section.settings.base_font_size }}px;
    --gcart-heading-size: {{ section.settings.heading_font_size }}px;
    --gcart-width: {{ section.settings.drawer_width }}px;
