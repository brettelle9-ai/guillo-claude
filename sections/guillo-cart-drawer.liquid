{%- comment -%}
  ============================================================================
  GUILLO — Custom Cart Drawer
  ----------------------------------------------------------------------------
  A premium, app-free AJAX cart drawer for the Pipeline theme (Markets-ready).
  - Slides in from the side, updates without page refresh.
  - "Build Your Wardrobe" progress bar (display-only offer).
  - "Complete the Look" manually-selected upsells.
  - All text/colours editable in the theme customizer (see {% schema %} below).

  This file renders the *shell* + settings. Line items and totals are rendered
  client-side by assets/cart-drawer.js from Shopify's /cart.js so the drawer
  always reflects the live cart (and the active market's currency).
  ============================================================================
{%- endcomment -%}

{%- liquid
  # ---- Resolve the active market / country (Shopify Markets) -------------
  assign cc = localization.country.iso_code | default: 'ZZ'

  # ---- Per-market text overrides (fall back to the global defaults) -------
  # Free shipping text
  assign free_shipping_text = section.settings.free_shipping_text
  case cc
    when 'AU'
      if section.settings.au_free_shipping_text != blank
        assign free_shipping_text = section.settings.au_free_shipping_text
      endif
    when 'NZ'
      if section.settings.nz_free_shipping_text != blank
        assign free_shipping_text = section.settings.nz_free_shipping_text
      endif
    when 'US'
      if section.settings.us_free_shipping_text != blank
        assign free_shipping_text = section.settings.us_free_shipping_text
      endif
    when 'GB'
      if section.settings.gb_free_shipping_text != blank
        assign free_shipping_text = section.settings.gb_free_shipping_text
      endif
    when 'CA'
      if section.settings.ca_free_shipping_text != blank
        assign free_shipping_text = section.settings.ca_free_shipping_text
      endif
  endcase

  # Returns text
  assign returns_text = section.settings.returns_text
  case cc
    when 'AU'
      if section.settings.au_returns_text != blank
        assign returns_text = section.settings.au_returns_text
      endif
    when 'NZ'
      if section.settings.nz_returns_text != blank
        assign returns_text = section.settings.nz_returns_text
      endif
    when 'US'
      if section.settings.us_returns_text != blank
        assign returns_text = section.settings.us_returns_text
      endif
    when 'GB'
      if section.settings.gb_returns_text != blank
        assign returns_text = section.settings.gb_returns_text
      endif
    when 'CA'
      if section.settings.ca_returns_text != blank
        assign returns_text = section.settings.ca_returns_text
      endif
  endcase

  # Payment / installments text ({payment} = subtotal / 4)
  assign payment_text = section.settings.payment_text
  case cc
    when 'AU'
      if section.settings.au_payment_text != blank
        assign payment_text = section.settings.au_payment_text
      endif
    when 'NZ'
      if section.settings.nz_payment_text != blank
        assign payment_text = section.settings.nz_payment_text
      endif
    when 'US'
      if section.settings.us_payment_text != blank
        assign payment_text = section.settings.us_payment_text
      endif
    when 'GB'
      if section.settings.gb_payment_text != blank
        assign payment_text = section.settings.gb_payment_text
      endif
    when 'CA'
      if section.settings.ca_payment_text != blank
        assign payment_text = section.settings.ca_payment_text
      endif
  endcase

  # ---- Shipping truth, per market ----------------------------------------
  # These MUST mirror Settings > Shipping for the matching zone. If they drift,
  # the drawer goes back to telling customers something checkout will contradict.
  # Looked up dynamically as "<cc>_free_shipping_threshold" etc, so adding a
  # market is a schema entry only, no Liquid change.
  # Leave a market's fields blank and the drawer says "calculated at checkout"
  # rather than guessing.
  assign ship_threshold = section.settings.free_shipping_threshold
  assign ship_rate = section.settings.shipping_rate
  assign shipping_nudge_text = section.settings.shipping_nudge_text
  assign ship_unlocked_text = section.settings.ship_unlocked_text
  assign show_payment_market = section.settings.show_payment

  case cc
    when 'AU'
      assign t = section.settings.au_free_shipping_threshold
      assign r = section.settings.au_shipping_rate
      assign n = section.settings.au_shipping_nudge_text
      assign u = section.settings.au_ship_unlocked_text
      assign h = section.settings.au_hide_payment
    when 'NZ'
      assign t = section.settings.nz_free_shipping_threshold
      assign r = section.settings.nz_shipping_rate
      assign n = section.settings.nz_shipping_nudge_text
      assign u = section.settings.nz_ship_unlocked_text
      assign h = section.settings.nz_hide_payment
    when 'US'
      assign t = section.settings.us_free_shipping_threshold
      assign r = section.settings.us_shipping_rate
      assign n = section.settings.us_shipping_nudge_text
      assign u = section.settings.us_ship_unlocked_text
      assign h = section.settings.us_hide_payment
    when 'GB'
      assign t = section.settings.gb_free_shipping_threshold
      assign r = section.settings.gb_shipping_rate
      assign n = section.settings.gb_shipping_nudge_text
      assign u = section.settings.gb_ship_unlocked_text
      assign h = section.settings.gb_hide_payment
    when 'CA'
      assign t = section.settings.ca_free_shipping_threshold
      assign r = section.settings.ca_shipping_rate
      assign n = section.settings.ca_shipping_nudge_text
      assign u = section.settings.ca_ship_unlocked_text
      assign h = section.settings.ca_hide_payment
    when 'SG'
      assign t = section.settings.sg_free_shipping_threshold
      assign r = section.settings.sg_shipping_rate
      assign n = section.settings.sg_shipping_nudge_text
      assign u = section.settings.sg_ship_unlocked_text
      assign h = section.settings.sg_hide_payment
  endcase

  if t != blank
    assign ship_threshold = t
  endif
  if r != blank
    assign ship_rate = r
  endif
  if n != blank
    assign shipping_nudge_text = n
  endif
  if u != blank
    assign ship_unlocked_text = u
  endif
  # Per-market kill switch for the instalments line, so we never name a BNPL
  # provider in a market where it is not actually offered.
  if h
    assign show_payment_market = false
  endif
-%}

{{ 'guillo-cart-drawer.css' | asset_url | stylesheet_tag }}

{%- comment -%} Only schema-driven values live inline; all real styling is in the CSS file. {%- endcomment -%}
<style>
