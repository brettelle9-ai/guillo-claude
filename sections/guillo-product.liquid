{% comment %}
  Guillo main product section: breadcrumb, two-column media grid on the
  left, sticky purchase panel on the right (title/price, rating, colour
  siblings, size buttons, add to bag, feature icons, accordions), and a
  sticky add-to-bag bar that appears on scroll.

  Colour "swatches" are sibling products read from the
  product.metafields.custom.colour_group product-list metafield when
  present; otherwise the product's own colour option is shown as buttons.
{% endcomment %}

{%- liquid
  assign bellagio_page = false
  if product.handle == 'bellagio-leather-weekender-duffel-bag' or product.handle == 'the-bellagio-wash-bag' or product.handle == 'the-bellagio-passport-holder'
    assign bellagio_page = true
  endif
  assign current_variant = product.selected_or_first_available_variant
  assign film_block = section.blocks | where: 'type', 'product_film' | first
  assign film_settings = section.settings
  if film_block != blank
    assign film_settings = film_block.settings
  endif

  # ---- reviews rolled up across the product family ----
  # Judge.me stores its payload per product, so a colourway with one review
  # showed one review. Roll up over the Guillo Product Group instead.
  # Shirts are the exception: the store splits them into three groups (short
  # sleeve, long sleeve, grandad collar) for the swatches, but they are one
  # shirt in different collars and Judge.me reviews them as one, so their
  # reviews come from the whole Shirts collection.
  assign gr_products = blank
  assign gr_legacy = blank
  if product.tags contains 'garment:shirt' and collections.shirts != blank
    assign gr_products = collections.shirts.products
  endif
  if product.tags contains 'garment:chino' and collections.chinos != blank
    # Every chino together, Luxe and Signore, but not the chino shorts -
    # those are garment:short and sit in their own collection.
    assign gr_products = collections.chinos.products
    # Three retired Luxe products (Sand, and the two Tailored Fit colours)
    # still hold reviews, and Liquid cannot read draft products at all, so
    # they are kept as a shop metafield and merged back in here. If Judge.me
    # grouping is ever switched back on, per-product counts become group
    # totals and this whole roll-up needs revisiting.
    assign gr_legacy = shop.metafields.custom.legacy_chino_reviews.value
  endif
  if gr_products == blank
    assign gr_group = product.metafields.custom.product_group.value
    if gr_group != blank
      assign gr_products = gr_group.products.value
    endif
  endif
  if gr_products == blank
    assign gr_products = product.metafields.custom.colour_group.value
  endif

  if bellagio_page
    assign gr_products = blank
  endif

  assign gr_reviews = '' | split: ''
  assign gr_count = 0
  assign gr_weighted = 0

  if gr_products != blank and gr_products.size > 0
    for gr_p in gr_products
      if product.handle contains 'the-luxe-chino-'
        unless gr_p.handle contains 'the-luxe-chino-'
          continue
        endunless
      endif
      assign gr_d = gr_p.metafields.judgeme.review_widget_data.value
      if gr_d != blank and gr_d.reviews != blank
        assign gr_reviews = gr_reviews | concat: gr_d.reviews
      endif
      assign gr_c = gr_p.metafields.reviews.rating_count.value | default: 0
      assign gr_a = gr_p.metafields.reviews.rating.value.rating | default: 0
      if gr_c > 0
        assign gr_count = gr_count | plus: gr_c
        assign gr_part = gr_a | times: gr_c
        assign gr_weighted = gr_weighted | plus: gr_part
      endif
    endfor
  else
    assign gr_d = product.metafields.judgeme.review_widget_data.value
    if gr_d != blank and gr_d.reviews != blank
      assign gr_reviews = gr_reviews | concat: gr_d.reviews
    endif
    assign gr_count = product.metafields.reviews.rating_count.value | default: 0
    assign gr_a = product.metafields.reviews.rating.value.rating | default: 0
    assign gr_weighted = gr_a | times: gr_count
  endif

  if gr_legacy != blank and gr_legacy.size > 0
    assign gr_reviews = gr_reviews | concat: gr_legacy
    for gr_l in gr_legacy
      assign gr_count = gr_count | plus: 1
      assign gr_weighted = gr_weighted | plus: gr_l.rating
    endfor
  endif

  assign gr_rating = 0
  if gr_count > 0
    assign gr_weighted_f = gr_weighted | times: 1.0
    assign gr_rating = gr_weighted_f | divided_by: gr_count | round: 2
  endif
  assign gr_reviews = gr_reviews | sort: 'created_at' | reverse

  assign rating = gr_rating
  assign rating_count = gr_count
  assign colour_group = product.metafields.custom.colour_group.value
  assign fys_block = section.blocks | where: 'type', 'guillo_find_your_size' | first

  # Guillo Product Group metaobject (custom.product_group) is the store's own
  # grouping system: it carries the group title, each sibling's display name,
  # its swatch image and swatch colour. Use it for the heading and the style
  # selector, falling back to the colour_group product list where a product
  # has not been grouped.
  # ---------------------------------------------------------------------
  # Luxe Chino layout. Approved on Stone, now on every colourway that uses
  # the Luxe Chino template. Every style is scoped to .guillo-pdp--stone so
  # no other product page can be touched.
  # ---------------------------------------------------------------------
  assign capri_page = false
  if product.tags contains 'garment:short' or template.suffix contains 'shorts'
    assign capri_page = true
  endif
  assign stone_test = false
  if product.handle == 'the-luxe-chino-stone' or product.template_suffix == 'aw26_luxe-chino_claude_'
    assign stone_test = true
  endif

  assign short_desc = section.settings.short_description
  if product.tags contains 'garment:polo'
    assign short_desc = product.metafields.custom.short_description | default: section.settings.short_description
  endif
  if short_desc == blank
    assign short_desc = section.settings.short_description
  endif
  if short_desc == blank
    if product.tags contains 'garment:polo'
      assign short_desc = product.description | strip_html | truncatewords: 32
    endif
  endif
  if stone_test
    assign short_desc = 'A defined waist. A slim leg. A clean finish above the shoe.'
  endif

  assign group = product.metafields.custom.product_group.value
  assign group_title = product.title
  assign style_name = ''
  if group != blank
    assign group_products = group.products.value
    assign group_names = group.display_names.value
    assign group_images = group.custom_images.value
    # Metaobject file_reference LISTS cannot be index-accessed - group_images[i]
    # comes back blank and the swatch quietly falls through to the product's
    # featured image, which is why these stopped matching the live store (the
    # Sage chino's featured image is a scene plate, not a garment shot). The
    # live theme builds a '|||' string of URLs and indexes that; same here.
    capture group_img_str
      for gimg in group_images
        echo gimg | image_url: width: 400
        unless forloop.last
          echo '|||'
        endunless
      endfor
    endcapture
    assign group_img_urls = group_img_str | split: '|||'
    assign group_swatches = group.swatch_colours.value
    if group.group_title != blank
      assign group_title = group.group_title
    endif
    for gp in group_products
      if gp.id == product.id
        assign style_name = group_names[forloop.index0]
      endif
    endfor
  endif

  # Bellagio pieces are individual products, not styles of a bundled set.
  if bellagio_page
    assign group = blank
    assign colour_group = blank
    assign group_title = product.title
    assign style_name = ''
    case product.handle
      when 'bellagio-leather-weekender-duffel-bag'
        assign short_desc = 'A genuine-leather weekender with a dedicated 16-inch laptop sleeve, organised pockets and a trolley sleeve. Carry it by hand, over your shoulder or on your suitcase.'
      when 'the-bellagio-wash-bag'
        assign short_desc = 'Keep your grooming essentials together in genuine leather, with a full zip opening and a wipe-clean lining.'
      when 'the-bellagio-passport-holder'
        assign short_desc = 'Your passport and cards, together in a slim genuine-leather holder that slips into a jacket pocket.'
    endcase
  endif

  assign size_option = null
  assign colour_option = null
  for option in product.options_with_values
    assign opt_name = option.name | downcase
    if opt_name == 'size' or opt_name == 'waist'
      assign size_option = option
    elsif opt_name == 'color' or opt_name == 'colour'
      assign colour_option = option
    endif
  endfor
-%}

{%- liquid
  # Availability mode turns this same PDP into a pre-order page (buyable now,
  # made later) or an interest page (not buyable; register a size and an email).
  # 'normal' changes nothing, so every existing template is untouched.
  assign avail_mode = section.settings.availability_mode | default: 'normal'
  assign preorder_ships_by = product.metafields.custom.preorder_ships_by.value
  assign size_tag_label = 'Notify me'
  if avail_mode == 'interest'
    assign size_tag_label = section.settings.interest_size_tag | default: 'Register'
  endif
-%}
{%- if bellagio_page -%}{{ 'guillo-bellagio.css' | asset_url | stylesheet_tag }}{%- endif -%}
{%- if stone_test -%}
  {{ 'guillo-luxe.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'guillo-luxe.js' | asset_url }}" defer></script>
{%- endif -%}
<section
  class="guillo-pdp guillo-pdp--{{ avail_mode }}{% if bellagio_page %} guillo-pdp--bellagio{% endif %}{% if stone_test %} guillo-pdp--stone{% endif %}"
  data-guillo-pdp
  data-avail-mode="{{ avail_mode }}"
  data-interest-cta="{{ section.settings.interest_cta | default: 'Register your interest' | escape }}"
  data-interest-hint="{{ section.settings.interest_hint | escape }}"
>
  <div class="guillo-pdp__crumb-wrap g-pad">
    {%- liquid
      # Home / category, not Home / product name, and always the garment
      # category rather than whichever collection someone happened to arrive
      # from - a polo reads Polo Shirts whether you came via Best Sellers,
      # New In or a direct link. Driven by the store's own garment:* tags so
      # it matches the nav.
      assign crumb = blank
      unless false
        if product.tags contains 'garment:polo'
          assign crumb = collections.polos
        elsif product.tags contains 'garment:shirt'
          assign crumb = collections.shirts
        elsif product.tags contains 'garment:chino'
          assign crumb = collections.chinos
        elsif product.tags contains 'garment:short'
          assign crumb = collections.shorts
        elsif product.tags contains 'garment:tee'
          assign crumb = collections['t-shirts']
        elsif product.tags contains 'garment:accessory'
          assign crumb = collections['accessories-1']
        elsif product.tags contains 'Jeans'
          assign crumb = collections.jeans
        elsif product.tags contains 'garment:pant'
          assign crumb = collections.pants
        endif
      endunless
      if crumb == blank or crumb.products_count == 0
        assign crumb = product.collections.first
      endif
    -%}
    <nav class="g-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      {%- if crumb != blank -%}
        <span class="g-breadcrumb__sep">/</span>
        <a href="{{ crumb.url }}">{{ crumb.title }}</a>
      {%- endif -%}
    </nav>
  </div>

  {%- liquid
      # Pre-order and interest pieces often have a single photograph. On desktop
      # the two-up grid would leave half the column empty, so the layout sizes
      # the column to that one image instead (see .guillo-pdp__layout--single).
      assign media_count = product.media.size
      assign gallery_mod = ''
      if media_count <= 1
        assign gallery_mod = ' guillo-pdp__gallery--single'
      elsif media_count == 2
        assign gallery_mod = ' guillo-pdp__gallery--pair'
      endif
    -%}
  {%- assign gallery_media = product.media -%}
  {%- if stone_test and product.handle == 'the-luxe-chino-stone' and media_count == 7 -%}
    {%- assign gallery_media = product.media | slice: 0, 1 -%}
    {%- assign gallery_order = '3,5,1,2,4,6' | split: ',' -%}
    {%- for index in gallery_order -%}{%- assign n = index | plus: 0 -%}{%- assign next_media = product.media | slice: n, 1 -%}{%- assign gallery_media = gallery_media | concat: next_media -%}{%- endfor -%}
  {%- endif -%}
  <div class="guillo-pdp__layout{% if media_count <= 1 %} guillo-pdp__layout--single{% endif %}">
    <div class="guillo-pdp__gallery-wrap">
    <div class="guillo-pdp__gallery{{ gallery_mod }}" data-gallery>
      {%- for media in gallery_media -%}
        <div class="guillo-pdp__frame">
          {%- liquid
            assign media_loading = 'lazy'
            if forloop.first
              assign media_loading = 'eager'
            endif
          -%}
          {%- comment -%}
            The image's own alt, falling back to the product title and colour.
            The "#note:" caption below is stripped out of the alt by the snippet,
            so a screen reader is not read the caption twice.
          {%- endcomment -%}
          {%- capture pdp_img_alt -%}
            {%- render 'guillo-image-alt', media_alt: media.alt, product: product -%}
          {%- endcapture -%}
          {%- assign pdp_img_alt = pdp_img_alt | strip -%}
          {%- if media.media_type == 'image' -%}
            {%- if stone_test -%}<button type="button" class="luxe-zoom" data-luxe-zoom="{{ media | image_url: width: 2000 }}" aria-label="Enlarge {{ pdp_img_alt | escape }}">{%- endif -%}
            {{
              media
              | image_url: width: 1400
              | image_tag: class: 'guillo-pdp__media', widths: '500, 700, 900, 1200, 1400', sizes: '(min-width: 990px) 33vw, 100vw', alt: pdp_img_alt, loading: media_loading
            }}
            {%- if stone_test -%}</button>{%- endif -%}
            {%- if media.alt contains '#note:' -%}
              <span class="guillo-pdp__note">{{ media.alt | split: '#note:' | last }}</span>
            {%- endif -%}
          {%- else -%}
            {{ media | media_tag: class: 'guillo-pdp__media' }}
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="guillo-pdp__frame">{{ 'product-apparel-1' | placeholder_svg_tag: 'guillo-pdp__media' }}</div>
        <div class="guillo-pdp__frame">{{ 'product-apparel-2' | placeholder_svg_tag: 'guillo-pdp__media' }}</div>
      {%- endfor -%}
    </div>
      {%- assign frame_count = product.media.size | default: 2 -%}
      {%- if frame_count > 1 -%}
        <div class="guillo-pdp__progress" data-gallery-progress aria-hidden="true">
          <span
            class="guillo-pdp__progress-fill"
            data-gallery-progress-fill
            style="width: {{ 100.0 | divided_by: frame_count }}%"
          ></span>
        </div>
      {%- endif -%}
    </div>

    <div class="guillo-pdp__panel">
      <div class="guillo-pdp__titlerow">
        <h1 class="guillo-pdp__title">
          {%- if stone_test -%}The Luxe Chino{%- elsif product.tags contains 'garment:shirt' and style_name != blank -%}{%- if style_name == 'Milano' -%}Milano Pinstripe Shirt{%- else -%}{{ style_name }} Shirt{%- endif -%}{%- else -%}{{ group_title }}{%- endif -%}
          {%- unless product.tags contains 'garment:shirt' -%}{%- if style_name != blank -%}
            <span class="guillo-pdp__style">{{ style_name }}</span>
          {%- endif -%}{%- endunless -%}
        </h1>
        <span class="guillo-pdp__price" data-price>{{ current_variant.price | money_with_currency }}</span>
      </div>

      {%- if bellagio_page -%}
        <p class="bellagio-individual">Sold individually · Matching accessories available below</p>
      {%- endif -%}

      {%- if avail_mode != 'normal' -%}
        <div class="guillo-pdp__avail guillo-pdp__avail--{{ avail_mode }}">
          {%- if section.settings.avail_eyebrow != blank -%}
            <p class="guillo-pdp__avail-eyebrow">{{ section.settings.avail_eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.avail_headline != blank -%}
            <p class="guillo-pdp__avail-line">{{ section.settings.avail_headline }}</p>
          {%- endif -%}
          {%- if section.settings.avail_note != blank -%}
            <p class="guillo-pdp__avail-note">{{ section.settings.avail_note }}</p>
          {%- endif -%}
          {%- if avail_mode == 'preorder' and preorder_ships_by != blank -%}
            <p class="guillo-pdp__avail-ships">Ships {{ preorder_ships_by }}</p>
          {%- endif -%}
          {%- if section.settings.avail_reward != blank -%}
            <p class="guillo-pdp__avail-reward">{{ section.settings.avail_reward }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}


      {%- if rating != blank and rating_count != blank and rating_count > 0 -%}
        {%- if stone_test or capri_page -%}
          {%- comment -%}
            On the stone page the rating is a plain anchor to the reviews
            section further down (its id is set in guillo-pdp-reviews). Native
            anchor, so it works with keyboard, screen readers and no script;
            the smooth scroll and the landing offset are CSS.
          {%- endcomment -%}
          <a class="guillo-pdp__rating guillo-pdp__rating--link" href="#guillo-reviews" aria-label="Rated {{ rating }} out of 5. Read customer reviews.">
            <span class="guillo-pdp__stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <span class="guillo-pdp__rating-note">{{ rating }} / 5</span>
          </a>
        {%- else -%}
          <div class="guillo-pdp__rating">
            <span class="guillo-pdp__stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <span class="guillo-pdp__rating-note">{{ rating }} / 5</span>
          </div>
        {%- endif -%}
      {%- endif -%}

      {%- if short_desc != blank and section.settings.show_short_description != false -%}
        {%- comment -%}
          Clamped to two lines with a Read more toggle. The clamp is applied
          by script only once it is measured as actually overflowing, so a
          short description never gets a pointless toggle, and with no JS the
          full text simply shows.
        {%- endcomment -%}
        <div class="guillo-pdp__desc-wrap"{% unless bellagio_page %} data-desc{% endunless %}>
          <p class="guillo-pdp__desc" data-desc-text>
            {{ short_desc }}
            {%- if section.settings.fit_guide_link != blank and bellagio_page == false %}
              <a href="{{ section.settings.fit_guide_link }}">Learn more.</a>
            {%- endif -%}
          </p>
          <button type="button" class="guillo-pdp__desc-more" data-desc-toggle hidden>Read more</button>
        </div>
      {%- endif -%}
      <div class="guillo-pdp__rule"></div>


      {%- comment -%}
        Style / colour selector. Prefers the store's product group (real
        display names, swatch images and hex swatches); falls back to the
        colour_group sibling list where a product is not in a group.
      {%- endcomment -%}
      {%- if group != blank and group_products.size > 1 -%}
        <div class="guillo-pdp__field">
          <div class="guillo-pdp__field-label">
            {{ section.settings.style_label | default: 'Style' }}:
            <span>{{ style_name | default: product.title }}</span>
          </div>
          <div class="guillo-pdp__colours">
            {%- for gp in group_products -%}
              {%- liquid
                assign gp_name = group_names[forloop.index0] | default: gp.title
                assign gp_img_url = group_img_urls[forloop.index0]
                assign gp_image = blank
                if gp_img_url == blank
                  assign gp_image = gp.featured_image
                endif
                assign gp_swatch = group_swatches[forloop.index0]
                # A colourway with nothing in stock is not a dead end, it is
                # not out yet: mark it coming soon and take it out of the
                # picker rather than sending anyone to a sold-out page.
                # The exception is a piece on an interest template: it is never
                # for sale, and its page is where people register a size, so it
                # stays a link and says so.
                assign gp_interest = false
                if gp.template_suffix contains 'interest'
                  assign gp_interest = true
                endif
                assign gp_coming = false
                unless gp.available or gp_interest
                  assign gp_coming = true
                endunless
              -%}
              {%- capture gp_inner -%}
                <span class="guillo-pdp__colour-frame"{% if gp_swatch != blank %} style="background: {{ gp_swatch }}"{% endif %}>
                  {%- if gp_img_url != blank -%}
                    <img src="{{ gp_img_url }}" alt="{{ gp_name | escape }}" class="guillo-pdp__colour-img" loading="lazy" width="200" height="250">
                  {%- elsif gp_image != blank -%}
                    {{ gp_image | image_url: width: 200 | image_tag: class: 'guillo-pdp__colour-img', alt: gp_name, loading: 'lazy' }}
                  {%- endif -%}
                </span>
                <span class="guillo-pdp__colour-name">{{ gp_name }}</span>
                {%- if gp_interest -%}
                  <span class="guillo-pdp__colour-soon">Register interest</span>
                {%- elsif gp_coming -%}
                  <span class="guillo-pdp__colour-soon">Coming soon</span>
                {%- endif -%}
              {%- endcapture -%}
              {%- if gp_coming -%}
                {%- comment -%} Not a link: there is nothing to buy there yet. {%- endcomment -%}
                <span
                  class="guillo-pdp__colour guillo-pdp__colour--soon{% if gp.id == product.id %} guillo-pdp__colour--on{% endif %}"
                  title="{{ gp_name | escape }} — coming soon"
                  aria-disabled="true"
                >{{ gp_inner }}</span>
              {%- else -%}
                <a
                  href="{{ gp.url }}"
                  class="guillo-pdp__colour{% if gp_interest %} guillo-pdp__colour--interest{% endif %}{% if gp.id == product.id %} guillo-pdp__colour--on{% endif %}"
                  title="{{ gp_name | escape }}{% if gp_interest %} — register interest{% endif %}"
                >{{ gp_inner }}</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- elsif colour_group != blank and colour_group.count > 1 -%}
        <div class="guillo-pdp__field">
          <div class="guillo-pdp__field-label">
            Colour:
            <span>{{ product.metafields.custom.colour_name | default: current_variant.title }}</span>
          </div>
          <div class="guillo-pdp__colours">
            {%- for sibling in colour_group -%}
              <a
                href="{{ sibling.url }}"
                class="guillo-pdp__colour{% if sibling.id == product.id %} guillo-pdp__colour--on{% endif %}"
              >
                <span class="guillo-pdp__colour-frame">
                  {%- if sibling.featured_image -%}
                    {{ sibling.featured_image | image_url: width: 200 | image_tag: class: 'guillo-pdp__colour-img', alt: sibling.title }}
                  {%- endif -%}
                </span>
                {%- liquid
                  assign sibling_colour = sibling.metafields.custom.colour_name
                  if sibling_colour == blank
                    assign sibling_colour = sibling.title | split: ' - ' | last | split: ' in ' | last
                  endif
                -%}
                <span class="guillo-pdp__colour-name">{{ sibling_colour }}</span>
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- liquid
        # Leg length is its own small choice rather than part of the colour
        # names: each short records its length and the one product that stands
        # for each length, so the current length is marked and the other links
        # across. Nothing renders on products without it.
        assign leg_here = product.metafields.custom.leg_length.value
        assign leg_opts = product.metafields.custom.leg_options.value
      -%}
      {%- if leg_here != blank and leg_opts != blank and leg_opts.size > 1 -%}
        <div class="guillo-pdp__field guillo-pdp__leg">
          <span class="guillo-pdp__field-label">Leg length</span>
          <div class="guillo-pdp__leg-switch" role="group" aria-label="Leg length">
            {%- for lp in leg_opts -%}
              {%- assign lp_len = lp.metafields.custom.leg_length.value -%}
              {%- if lp_len == leg_here -%}
                <span class="guillo-pdp__leg-opt is-current" aria-current="true">{{ lp_len }}</span>
              {%- else -%}
                <a class="guillo-pdp__leg-opt" href="{{ lp.url }}">{{ lp_len }}</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {% form 'product', product, id: 'GuilloProductForm', novalidate: 'novalidate' %}
        <input type="hidden" name="id" data-variant-id value="{{ current_variant.id }}">
        <input type="hidden" name="quantity" data-quantity value="1">

        {%- comment -%}
          A product with no real options still has one called "Title" holding
          "Default Title". Rendering it gave the belt a size picker reading
          Default Title and a button stuck on "Select a size".
        {%- endcomment -%}
        {%- for option in product.options_with_values -%}
          {%- if product.has_only_default_variant -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign opt_name = option.name | downcase
            assign is_colour = false
            if opt_name == 'color' or opt_name == 'colour'
              assign is_colour = true
            endif
          -%}
          {%- comment -%}
            When colours are sibling products (colour_group metafield) a colour
            option on the product itself is only skipped if it has one value —
            otherwise it still needs picking to resolve the variant.
          {%- endcomment -%}
          {%- if is_colour and colour_group != blank and colour_group.count > 1 and option.values.size == 1 -%}
            {%- continue -%}
          {%- endif -%}
          <div class="guillo-pdp__field" data-option-index="{{ forloop.index0 }}">
            <div class="guillo-pdp__field-head">
              <span class="guillo-pdp__field-label">
                {{ option.name }}:
                <span data-option-value-label>Select</span>
              </span>
              {%- liquid
                assign is_size_option = false
                if opt_name == 'size' or opt_name == 'waist'
                  assign is_size_option = true
                endif
              -%}
              {%- if is_size_option -%}
                {%- comment -%}
                  Guillo Fit sits beside the size guide, not instead of it: the
                  chart is for people who know their measurements, the finder
                  for people who do not. It only renders when the snippet has a
                  chart it trusts (see snippets/guillo-fit-finder.liquid).
                {%- endcomment -%}
                {%- if fys_block -%}
                  <span class="guillo-pdp__size-links">
                    <button type="button" class="guillo-pdp__size-guide guillo-pdp__fit-link" data-gff-open hidden data-gff-link>
                      <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 8.5h18v7H3z"/><path d="M7 8.5v3M11 8.5v4.5M15 8.5v3M19 8.5v4.5"/></svg>
                      Find my size
                    </button>
                    <button type="button" class="guillo-pdp__size-guide" data-open-size-guide>Size guide</button>
                  </span>
                {%- elsif section.settings.size_guide_page != blank -%}
                  <a class="guillo-pdp__size-guide" href="{{ section.settings.size_guide_page }}">Size guide</a>
                {%- endif -%}
              {%- endif -%}
            </div>
        {%- liquid
          assign preorder_ships_by = product.metafields.custom.preorder_ships_by.value
          assign has_preorder = false
          if product.metafields.theme.preorder.value
            assign has_preorder = true
          endif
          for variant in product.variants
            if variant.metafields.custom.preorder.value and variant.available
              assign has_preorder = true
            endif
          endfor
        -%}
            {%- assign size_cols = option.values.size | at_most: 8 | at_least: 4 -%}
            <div class="guillo-pdp__sizes" style="grid-template-columns: repeat({{ size_cols }}, 1fr)">
              {%- for value in option.values -%}
                {%- liquid
                  assign value_available = false
                  assign value_preorder = false
                  assign value_variant_id = ''
                  for variant in product.variants
                    if variant.options[forloop.parentloop.parentloop.index0] == value
                      if value_variant_id == ''
                        assign value_variant_id = variant.id
                      endif
                      if variant.available
                        assign value_available = true
                        assign value_variant_id = variant.id
                        if variant.metafields.custom.preorder.value or product.metafields.theme.preorder.value
                          assign value_preorder = true
                        endif
                      endif
                    endif
                  endfor
                  # Store size values carry inconsistent inch marks (28", 30'');
                  # display them as the clean numbers the design shows.
                  assign value_label = value | remove: '"' | remove: "''" | strip
                  # Interest pages take a size as a demand signal, never to cart.
                  if avail_mode == 'interest'
                    assign value_available = false
                  endif
                -%}
                {%- if value_available -%}
                  <label class="guillo-pdp__size{% if value_preorder %} guillo-pdp__size--pre{% endif %}"{% if value_preorder and preorder_ships_by != blank %} tabindex="0"{% endif %}>
                    <input
                      type="radio"
                      name="options[{{ option.name | escape }}]"
                      value="{{ value | escape }}"
                      data-label="{{ value_label | escape }}"
                      {% if value_preorder %}data-preorder="true"{% endif %}
                    >
                    <span>
                      {{ value_label }}
                      {%- if value_preorder -%}
                        <em class="guillo-pdp__size-tag guillo-pdp__size-tag--pre">Pre-order</em>
                      {%- endif -%}
                    </span>
                    {%- if value_preorder and preorder_ships_by != blank -%}
                      <span class="guillo-pdp__size-tip" role="tooltip">
                        Ships by {{ preorder_ships_by }}. Your size is held for you.
                      </span>
                    {%- endif -%}
                  </label>
                {%- else -%}
                  {%- comment -%}
                    Sold out sizes are a button rather than a disabled radio:
                    they cannot be chosen as a variant, but they are clickable
                    and open the back-in-stock form, as they do on live.
                  {%- endcomment -%}
                  <button
                    type="button"
                    class="guillo-pdp__size guillo-pdp__size--gone"
                    data-notify-open
                    data-notify-size="{{ value_label | escape }}"
                    data-notify-variant="{{ value_variant_id }}"
                  >
                    <span>
                      {{ value_label }}
                      <em class="guillo-pdp__size-tag">{{ size_tag_label }}</em>
                    </span>
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
        <div
          class="guillo-pdp__notify"
          data-notify-panel
          hidden
          data-product-title="{{ product.title | escape }}"
          data-product-url="{{ shop.url }}{{ product.url }}"
          data-product-image="{{ product.featured_image | image_url: width: 400 }}"
          data-product-price="{{ product.price | money }}"
        >
          <button type="button" class="guillo-pdp__notify-back" data-notify-close>&larr; {% if bellagio_page %}Back to product{% else %}Back to sizes{% endif %}</button>
          <p class="guillo-pdp__notify-title">
            {%- if avail_mode == 'interest' -%}
              {{ section.settings.interest_panel_title | default: 'Register your interest in size' }} <span data-notify-size-label></span>
            {%- else -%}
              {% if bellagio_page %}Notify me when this item is back in stock{% else %}Notify me when size <span data-notify-size-label></span> is back in stock{% endif %}
            {%- endif -%}
          </p>
          <p class="guillo-pdp__notify-sub">
            {%- if avail_mode == 'interest' -%}
              {{ section.settings.interest_panel_sub | default: 'One letter, the morning it opens. Nothing else.' }}
            {%- else -%}
              Enter your contact info below and we&rsquo;ll let you know the moment it&rsquo;s available.
            {%- endif -%}
          </p>
          <div class="guillo-pdp__notify-tabs" role="tablist">
            <button type="button" class="guillo-pdp__notify-tab is-active" data-notify-tab="email">Email</button>
            <button type="button" class="guillo-pdp__notify-tab" data-notify-tab="sms">SMS</button>
          </div>
          <div class="guillo-pdp__notify-form">
            <input type="email" class="guillo-pdp__notify-input" placeholder="Email address" autocomplete="email" data-notify-email>
            <input type="tel" class="guillo-pdp__notify-input" placeholder="Phone number" autocomplete="tel" data-notify-phone hidden>
            <button type="button" class="guillo-pdp__notify-submit" data-notify-submit>Notify me</button>
          </div>
          <p class="guillo-pdp__notify-msg" data-notify-msg role="status" aria-live="polite"></p>
        </div>

        {%- liquid
          # Return shipping is only free for AU/NZ. Everywhere else the
          # customer pays it, so "free" cannot be claimed (see the returns FAQ).
          assign ret_cc = localization.country.iso_code | default: 'ZZ'
          assign ret_line = '44-day returns and exchanges.'
          if ret_cc == 'AU' or ret_cc == 'NZ'
            assign ret_line = 'Free exchanges within 44 days.'
          endif
        -%}
        <div class="guillo-pdp__size-hint" data-size-hint>
          {%- if stone_test -%}Choose your waist size.{%- else -%}
            {%- unless product.has_only_default_variant -%}Select a size. {% endunless -%}
            {{- ret_line -}}
          {%- endif -%}
        </div>

        <button type="submit" class="guillo-pdp__atc" data-atc{% unless product.has_only_default_variant %} disabled{% endunless %}>
          <span data-atc-label>{% if product.has_only_default_variant %}Add to bag{% else %}Select a size{% endif %}</span>
        </button>

        {%- comment -%}
          The live theme's pair builder, rendered as-is: it derives the family
          from the garment:* tags, offers the other colourways as image cards,
          takes a size for each and adds both. It renders nothing on products
          with no pair discount, so the section setting is only an override to
          hide it.
        {%- endcomment -%}
        {%- if section.settings.show_pair and stone_test == false and bellagio_page == false -%}
          {% render 'guillo-pair-builder', product: product %}
        {%- endif -%}



        {%- if section.settings.trust_line != blank -%}
          {%- unless stone_test -%}<div class="guillo-pdp__trust">{{ section.settings.trust_line }}</div>{%- endunless -%}
        {%- endif -%}
      {% endform %}
      {%- if stone_test -%}
        <div class="luxe-assurance"><span>{{ ret_line }}</span><a href="#LuxeLook-{{ section.id }}">Complete the look <span aria-hidden="true">↗</span></a></div>
        {%- assign luxe_quote_authors = 'Ken C.|Nath W|Nathan|Ben|Steve' | split: '|' -%}
        {%- assign luxe_quote_count = 0 -%}
        {%- capture luxe_quote_slides -%}
          {%- for quote_author in luxe_quote_authors -%}
            {%- for luxe_review in gr_reviews -%}
              {%- assign luxe_author = luxe_review.reviewer_name | default: luxe_review.reviewer.name -%}
              {%- assign luxe_quote = luxe_review.body_html | default: luxe_review.body | strip_html | strip -%}
              {%- assign luxe_quote_lower = luxe_quote | downcase -%}
              {%- if luxe_quote_lower contains 'material' or luxe_quote_lower contains 'fabric' or luxe_quote_lower contains 'stretch' -%}{%- continue -%}{%- endif -%}
              {%- if luxe_author == quote_author and luxe_review.verified_buyer and luxe_quote.size >= 20 and luxe_quote.size <= 170 -%}
                <figure class="luxe-buy-quote{% if luxe_quote_count == 0 %} is-current{% endif %}" data-luxe-quote aria-hidden="{% if luxe_quote_count == 0 %}false{% else %}true{% endif %}"><blockquote>{{ luxe_quote | escape }}</blockquote><figcaption>{{ luxe_author | escape }} · Verified purchase</figcaption></figure>
                {%- assign luxe_quote_count = luxe_quote_count | plus: 1 -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if luxe_quote_count > 0 -%}
          <div class="luxe-buy-voices" data-luxe-quotes role="region" aria-label="Customer reviews" aria-roledescription="carousel">
            <div class="luxe-buy-voices__slides" aria-live="off">{{ luxe_quote_slides }}</div>
            {%- if luxe_quote_count > 1 -%}<div class="luxe-buy-voices__controls"><div class="luxe-buy-voices__dots" role="group" aria-label="Choose a review">{%- for i in (1..luxe_quote_count) -%}<button type="button" data-luxe-quote-dot="{{ forloop.index0 }}" aria-label="Show review from {{ luxe_quote_authors[forloop.index0] | escape }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"></button>{%- endfor -%}</div><button class="luxe-buy-voices__pause" type="button" data-luxe-quotes-pause aria-label="Pause rotating reviews"><span aria-hidden="true">Ⅱ</span></button></div>{%- endif -%}
          </div>
        {%- endif -%}
        {%- if product.metafields.custom.model_height != blank and product.metafields.custom.model_size != blank -%}<p class="luxe-model">Model: {{ product.metafields.custom.model_height | escape }} · wears {{ product.metafields.custom.model_size | escape }}</p>{%- endif -%}
      {%- endif -%}

      {%- assign icon_blocks = section.blocks | where: 'type', 'feature' -%}
      {%- capture gstone_features -%}
      {%- if icon_blocks.size > 0 -%}
        <div class="guillo-pdp__features">
          {%- for block in icon_blocks -%}
            <div class="guillo-pdp__feature" {{ block.shopify_attributes }}>
              <span class="guillo-pdp__feature-icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'stretch' -%}
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M2 12h20"/><path d="M6 8l-4 4 4 4"/><path d="M18 8l4 4-4 4"/></svg>
                  {%- when 'slim_fit' -%}
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"><path d="M9 3l3 2.2L15 3l4.2 2.5-1.7 3.6-1.6-.8v12.2H8.1V8.3l-1.6.8L4.8 5.5z"/><path d="M12 5.2v15.3"/></svg>
                  {%- when 'breathable' -%}
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"><path d="M3 8h9a2.5 2.5 0 1 0-2.5-2.5"/><path d="M3 12h13a2.5 2.5 0 1 1-2.5 2.5"/><path d="M3 16h7a2 2 0 1 1-2 2"/></svg>
                  {%- when 'quick_dry' -%}
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3.5c2.6 2.7 4 4.9 4 7a4.5 4.5 0 0 1-9 0c0-2.1 1.4-4.3 4-7l.5-.5z"/><path d="M2 7h5M2 11h3M2 15h4"/></svg>
                  {%- when 'no_iron' -%}
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="3" y="6" width="18" height="12"/><path d="M3 20l18-16"/></svg>
                  {%- when 'taper' -%}
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M6 3h12l-3 18H9L6 3z"/><path d="M8.5 12h7"/></svg>
                  {%- when 'clock' -%}
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l4 2"/></svg>
                  {%- when 'shield' -%}
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M12 3l8 3v6c0 5-3.4 8.1-8 9-4.6-.9-8-4-8-9V6l8-3z"/><path d="M8.6 12.2l2.3 2.3 4.5-4.6"/></svg>
                  {%- when 'truck' -%}
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M2 7h11v10H2z"/><path d="M13 10h5l3 3v4h-8z"/><circle cx="6" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
                  {%- when 'refresh' -%}
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M21 12a9 9 0 11-3.2-6.9"/><path d="M21 3v5h-5"/></svg>
                  {%- comment -%} Three flowing lines, for a fabric that reads smooth and fluid rather than structured. {%- endcomment -%}
                  {%- when 'lightweight' -%}
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 3.5c-5-2-12 1-13.5 6.5-1 3.5.5 6.5 3 7 5 1 10-5 10.5-13.5Z"/><path d="m3 21 13-13M8 16v-5M12 12h5"/></svg>
                  {%- when 'silk' -%}
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"><path d="M3 7c3-2.6 6-2.6 9 0s6 2.6 9 0"/><path d="M3 12c3-2.6 6-2.6 9 0s6 2.6 9 0"/><path d="M3 17c3-2.6 6-2.6 9 0s6 2.6 9 0"/></svg>
                  {%- else -%}
                    <span class="guillo-pdp__feature-dot"></span>
                {%- endcase -%}
              </span>
              <span>{{ block.settings.label }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- endcapture -%}
      {%- capture gstone_video -%}
      {%- if film_settings.show_video_tile -%}
        {%- comment -%}
          Poster + centre play button. The poster falls back to the product's
          own second image so each product shows itself, never another
          product's photo. The button reveals and plays the video when one is
          set; with no video it is not rendered, so there is no dead control.
        {%- endcomment -%}
        {%- liquid
          comment
            Poster priority: an explicitly chosen image, then the video's own
            first frame (so the tile previews the actual video, not a product
            photo), then the product's own imagery when there is no video.
          endcomment
          assign poster_image = film_settings.video_poster
          if poster_image == blank and film_settings.video != blank
            assign poster_image = film_settings.video.preview_image
          endif
          if poster_image == blank and film_settings.video_poster_asset == blank
            assign poster_image = product.media[1].preview_image | default: product.featured_image
          endif
        -%}
        {%- comment -%}
          The focal point rides on the tile as a custom property: video_tag
          builds its own <video> and poster, so there is nothing to hang a
          style attribute on, and one variable covers both.
        {%- endcomment -%}
        <div
          class="guillo-pdp__video"
          {% unless capri_page %}{{ film_block.shopify_attributes }}{% endunless %}
          style="
            --video-pos: {{ film_settings.video_position | default: 'center center' }};
            --video-ratio: {{ film_settings.video_ratio | default: '1 / 1' }};
            --video-fit: {{ film_settings.video_fit | default: 'cover' }};
          "
          {% if film_settings.video != blank %}data-video-tile{% endif %}
        >
          <div class="guillo-pdp__video-frame">
            {%- if film_settings.video != blank -%}
              {%- comment -%}
                No native controls: the browser's control bar is not wanted, so
                the video is driven entirely by the centre play icon and a
                click-to-pause on the video itself. video_tag supplies the
                video's own first frame as the poster.
              {%- endcomment -%}
              {%- assign film_poster_url = poster_image | image_url: width: 900 -%}
              {{
                film_settings.video
                | video_tag: controls: false, muted: true, preload: 'metadata', image_size: '900x', poster: film_poster_url, class: 'guillo-pdp__video-media'
              }}
              <button
                type="button"
                class="guillo-pdp__video-play"
                data-video-play
                aria-label="{{ film_settings.video_caption | default: 'Play video' | escape }}"
              >
                <span aria-hidden="true"></span>
              </button>
            {%- else -%}
              {% render 'guillo-img',
                image: poster_image,
                fallback: film_settings.video_poster_asset,
                alt: film_settings.video_caption,
                class: 'guillo-pdp__video-media',
                sizes: '440px',
                position: 'center 34%'
              %}
              <span class="guillo-pdp__video-play" aria-hidden="true">
                <span></span>
              </span>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
      {%- endcapture -%}
      {%- unless stone_test or capri_page or bellagio_page -%}{{ gstone_video }}{%- endunless -%}

      {%- unless stone_test or bellagio_page -%}{{ gstone_features }}{%- endunless -%}



      {%- if fys_block and bellagio_page == false -%}
        <div class="guillo-pdp__sizeguide" {{ fys_block.shopify_attributes }}>
          {% render 'guillo-find-your-size',
            settings: fys_block.settings,
            unique: fys_block.id,
            product: product
          %}
        </div>
        {%- comment -%}
          Guillo Fit. Renders nothing unless the size guide's own centimetre
          chart reads as real measurements, so a product with a broken chart
          quietly keeps the page it has today.
        {%- endcomment -%}
        {% render 'guillo-fit-finder', product: product, fys: fys_block, settings: section.settings %}
      {%- endif -%}

      {%- assign tab_blocks = section.blocks | where: 'type', 'tab' -%}
      {%- if tab_blocks.size > 0 -%}
        {%- if stone_test or capri_page -%}
        {%- comment -%}
          Stone test: each title sits directly above its own panel as a full
          width row, instead of the shared tab bar. Same data attributes, so
          the tab script below needs no change.
        {%- endcomment -%}
        <div class="guillo-pdp__tabs gstone-acc" data-tabs>
          {%- for block in tab_blocks -%}
            {%- liquid
              assign tab_cc = localization.country.iso_code | default: 'ZZ'
              assign tab_content = block.settings.content
              if bellagio_page and block.settings.title == 'Details'
                assign tab_content = product.description
              endif
              unless tab_cc == 'AU' or tab_cc == 'NZ'
                if block.settings.content_intl != blank
                  assign tab_content = block.settings.content_intl
                endif
              endunless
            -%}
            <div class="gstone-acc__item">
              <button
                type="button"
                class="guillo-pdp__tab-btn gstone-acc__btn"
                data-tab-btn="{{ forloop.index0 }}"
                aria-expanded="false"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.title }}
                <span class="guillo-pdp__tab-mark" aria-hidden="true">+</span>
              </button>
              <div class="guillo-pdp__tab-panel gstone-acc__panel" data-tab-panel="{{ forloop.index0 }}" hidden>
                {%- if block.settings.country_shipping -%}{% render 'guillo-shipping-panel' %}{%- else -%}{{ tab_content }}{%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="guillo-pdp__tabs" data-tabs>
          <div class="guillo-pdp__tabbar" role="tablist">
            {%- for block in tab_blocks -%}
              <button
                type="button"
                class="guillo-pdp__tab-btn"
                data-tab-btn="{{ forloop.index0 }}"
                aria-expanded="false"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.title }}
                <span class="guillo-pdp__tab-mark" aria-hidden="true">+</span>
              </button>
            {%- endfor -%}
          </div>
          {%- for block in tab_blocks -%}
            {%- liquid
              # Same AU/NZ rule as the size hint: an accordion can carry
              # separate wording for every other market.
              assign tab_cc = localization.country.iso_code | default: 'ZZ'
              assign tab_content = block.settings.content
              if bellagio_page and block.settings.title == 'Details'
                assign tab_content = product.description
              endif
              unless tab_cc == 'AU' or tab_cc == 'NZ'
                if block.settings.content_intl != blank
                  assign tab_content = block.settings.content_intl
                endif
              endunless
            -%}
            <div class="guillo-pdp__tab-panel" data-tab-panel="{{ forloop.index0 }}" hidden>
              {%- if block.settings.country_shipping -%}{% render 'guillo-shipping-panel' %}{%- else -%}{{ tab_content }}{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        {%- endif -%}
      {%- endif -%}
      {%- if product.handle == 'bellagio-leather-weekender-duffel-bag' -%}
        {% render 'guillo-bellagio-features' %}
      {%- endif -%}
    </div>
  </div>

  {%- if capri_page and film_settings.show_video_tile -%}
    <section class="capri-film" {{ film_block.shopify_attributes }} aria-label="{{ film_settings.video_caption | escape }}">
      <div class="capri-film__copy"><h2>{{ film_settings.video_caption }}</h2></div>
      {{ gstone_video }}
    </section>
  {%- endif -%}

  {%- if stone_test -%}
    {%- comment -%}
      Stone test: the persuasive material (video, story, fit gauges, feature
      rows, a verified quote, an editorial scene) leaves the narrow column and
      gets a band of its own. Lives in snippets/guillo-stone-band.liquid so it
      can be edited without touching this file.
    {%- endcomment -%}
    <section class="luxe-benefits" aria-label="The Luxe Chino benefits">
      {% render 'guillo-luxe-product-notes' %}
    </section>
    {% render 'guillo-luxe-story', product: product, section: section, film_block: film_block, film_settings: film_settings %}
    {% render 'guillo-luxe-look', product: product, section: section, style_name: style_name %}
  {%- endif -%}

  <div class="guillo-pdp__sticky" data-sticky-atc hidden>
    <div class="g-container g-container--wide guillo-pdp__sticky-inner">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 108 | image_tag: class: 'guillo-pdp__sticky-thumb', alt: '' }}
      {%- endif -%}
      <div class="guillo-pdp__sticky-copy">
        <div class="guillo-pdp__sticky-title">{{ product.title }}</div>
        <div class="guillo-pdp__sticky-price"><span data-price>{{ current_variant.price | money }}</span>{% if stone_test %}<span data-luxe-sticky-size> · {{ style_name }} · Choose size</span>{% endif %}</div>
      </div>
      <button type="submit" form="GuilloProductForm" class="guillo-pdp__atc guillo-pdp__atc--sticky" data-atc{% unless product.has_only_default_variant %} disabled{% endunless %}>
        <span data-atc-label>{% if product.has_only_default_variant %}Add to bag{% else %}Select a size{% endif %}</span>
      </button>
    </div>
  </div>

  <script type="application/json" data-variant-data>
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "available": {{ variant.available }},
          "price_cents": {{ variant.price }},
          "price": {{ variant.price | money | json }},
          "options": {{ variant.options | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</section>

<script>
  (() => {
    const root = document.querySelector('[data-guillo-pdp]');
    if (!root) return;
    const variants = JSON.parse(root.querySelector('[data-variant-data]').textContent);
    const form = root.querySelector('#GuilloProductForm');
    const idInput = form.querySelector('[data-variant-id]');
    // Every size can be sold out (the Portofino Polo is, today), in which case
    // the option wrapper holds notify buttons and no radio at all.
    const optionNames = [...form.querySelectorAll('[data-option-index]')]
      .map((el) => el.querySelector('input[type="radio"]'))
      .filter(Boolean)
      .map((el) => el.name);
    const atcButtons = root.querySelectorAll('[data-atc]');
    const labels = root.querySelectorAll('[data-atc-label]');
    const prices = root.querySelectorAll('[data-price]');
    const hint = root.querySelector('[data-size-hint]');

    function selectedOptions() {
      const wraps = [...form.querySelectorAll('[data-option-index]')];
      return wraps.map((wrap) => {
        const checked = wrap.querySelector('input:checked');
        return {
          index: Number(wrap.dataset.optionIndex),
          value: checked ? checked.value : null,
          display: checked ? checked.dataset.label || checked.value : null,
          input: checked,
          labelEl: wrap.querySelector('[data-option-value-label]'),
        };
      });
    }

    function update() {
      const sel = selectedOptions();
      sel.forEach((s) => {
        if (s.labelEl) s.labelEl.textContent = s.display || 'Select';
      });
      const allChosen = sel.every((s) => s.value !== null);
      if (!allChosen) {
        atcButtons.forEach((b) => (b.disabled = true));
        labels.forEach((l) => (l.textContent = 'Select a size'));
        return;
      }
      const match = variants.find((v) =>
        sel.every((s) => v.options[s.index] === s.value)
      );
      const chosen = sel.map((s) => s.input).filter(Boolean);
      const isPreorder = chosen.some((i) => i.dataset.preorder === 'true');
      if (match && match.available) {
        idInput.value = match.id;
        atcButtons.forEach((b) => (b.disabled = false));
        labels.forEach((l) => (l.textContent = isPreorder ? 'Pre-order' : 'Add to bag'));
        prices.forEach((p) => (p.textContent = match.price));
        if (hint) {
          hint.textContent = isPreorder ? 'Pre-order' : 'In stock, dispatched today';
        }
      } else {
        atcButtons.forEach((b) => (b.disabled = true));
        labels.forEach((l) => (l.textContent = match ? 'Sold out' : 'Unavailable'));
        if (hint) hint.textContent = 'This combination is not available.';
      }
    }

    form.addEventListener('change', (e) => {
      if (e.target.matches('input[type="radio"]')) update();
    });


    if (form.querySelectorAll('[data-option-index]').length === 0) {
      atcButtons.forEach((b) => (b.disabled = false));
      labels.forEach((l) => (l.textContent = 'Add to bag'));
    } else if (form.querySelectorAll('[data-option-index] input[type="radio"]').length === 0) {
      // Nothing left to pick: say so rather than asking for a size.
      // Nothing to buy, but there is something to do: the button opens the
      // back-in-stock form rather than sitting there dead.
      atcButtons.forEach((b) => {
        b.disabled = false;
        b.dataset.notifyAll = 'true';
      });
      const mode = root.dataset.availMode || 'normal';
      labels.forEach((l) => (l.textContent = mode === 'interest'
        ? (root.dataset.interestCta || 'Register your interest')
        : 'Notify me'));
      if (hint) {
        hint.textContent = mode === 'interest'
          ? (root.dataset.interestHint || 'Choose the size you would take.')
          : 'Coming soon. Choose a size to hear when it lands.';
      }
    }

    // ---- Back in stock, the same Klaviyo client-API calls the live theme's
    // size drawer makes: the Notify Me Request metric, a back-in-stock
    // subscription on the variant, and the list subscription. ----
    const notifyPanel = root.querySelector('[data-notify-panel]');
    if (notifyPanel) {
      const KLAVIYO_COMPANY = 'YgJzQa';
      const KLAVIYO_LIST = 'TARW9Y';
      const sizeGrids = root.querySelectorAll('.guillo-pdp__sizes');
      const sizeLabel = notifyPanel.querySelector('[data-notify-size-label]');
      const emailInput = notifyPanel.querySelector('[data-notify-email]');
      const phoneInput = notifyPanel.querySelector('[data-notify-phone]');
      const submit = notifyPanel.querySelector('[data-notify-submit]');
      const msg = notifyPanel.querySelector('[data-notify-msg]');
      const tabs = notifyPanel.querySelectorAll('[data-notify-tab]');
      let channel = 'email';
      let variantId = '';

      const setMsg = (text, ok) => {
        msg.textContent = text;
        msg.className = 'guillo-pdp__notify-msg ' + (ok ? 'is-ok' : 'is-err');
      };
      const setChannel = (ch) => {
        channel = ch;
        tabs.forEach((t) => t.classList.toggle('is-active', t.dataset.notifyTab === ch));
        emailInput.hidden = ch !== 'email';
        phoneInput.hidden = ch !== 'sms';
        setMsg('', true);
        (ch === 'email' ? emailInput : phoneInput).focus();
      };
      tabs.forEach((t) => t.addEventListener('click', () => setChannel(t.dataset.notifyTab)));

      // The add-to-bag button stands in for the size buttons when every size
      // is gone: it opens the form on the first size, and Back to sizes
      // switches to another.
      root.querySelectorAll('[data-atc]').forEach((b) => {
        b.addEventListener('click', (e) => {
          if (b.dataset.notifyAll !== 'true') return;
          e.preventDefault();
          const first = root.querySelector('[data-notify-open]');
          if (first) first.click();
        });
      });

      root.querySelectorAll('[data-notify-open]').forEach((btn) => {
        btn.addEventListener('click', () => {
          variantId = btn.dataset.notifyVariant || '';
          sizeLabel.textContent = btn.dataset.notifySize || '';
          emailInput.value = '';
          phoneInput.value = '';
          notifyPanel.hidden = false;
          sizeGrids.forEach((g) => (g.hidden = true));
          setChannel('email');
          notifyPanel.scrollIntoView({ block: 'nearest' });
        });
      });

      const closeBtn = notifyPanel.querySelector('[data-notify-close]');
      if (closeBtn) {
        closeBtn.addEventListener('click', () => {
          notifyPanel.hidden = true;
          sizeGrids.forEach((g) => (g.hidden = false));
        });
      }

      submit.addEventListener('click', () => {
        const profile = {};
        if (channel === 'email') {
          const email = (emailInput.value || '').trim();
          const at = email.indexOf('@');
          const dot = email.lastIndexOf('.');
          if (at < 1 || dot < at + 2 || dot >= email.length - 1) {
            setMsg('Please enter a valid email address.', false);
            return;
          }
          profile.email = email;
        } else {
          let phone = (phoneInput.value || '').replace(/[^0-9+]/g, '');
          if (phone.charAt(0) !== '+') {
            if (phone.charAt(0) === '0') phone = '+61' + phone.slice(1);
            else if (phone.slice(0, 2) === '61') phone = '+' + phone;
          }
          if (!/^\+[0-9]{8,15}$/.test(phone)) {
            setMsg('Please enter a valid mobile number.', false);
            return;
          }
          profile.phone_number = phone;
        }

        const headers = { 'Content-Type': 'application/json', revision: '2024-10-15' };
        const d = notifyPanel.dataset;
        const size = sizeLabel.textContent.trim();
        submit.disabled = true;
        const restore = submit.textContent;
        submit.textContent = 'Sending…';

        fetch('https://a.klaviyo.com/client/events/?company_id=' + KLAVIYO_COMPANY, {
          method: 'POST',
          headers,
          body: JSON.stringify({ data: { type: 'event', attributes: {
            properties: {
              Product: d.productTitle || '', Size: size, 'Variant ID': variantId,
              'Product URL': d.productUrl || '', 'Product Image': d.productImage || '',
              Price: d.productPrice || '', Channel: channel
            },
            metric: { data: { type: 'metric', attributes: { name: 'Notify Me Request' } } },
            profile: { data: { type: 'profile', attributes: profile } }
          } } })
        }).catch(() => {});

        if (variantId) {
          fetch('https://a.klaviyo.com/client/back-in-stock-subscriptions/?company_id=' + KLAVIYO_COMPANY, {
            method: 'POST',
            headers,
            body: JSON.stringify({ data: { type: 'back-in-stock-subscription', attributes: {
              profile: { data: { type: 'profile', attributes: profile } },
              channels: [channel === 'email' ? 'EMAIL' : 'SMS']
            }, relationships: { variant: { data: {
              type: 'catalog-variant', id: '$shopify:::$default:::' + variantId
            } } } } })
          }).catch(() => {});
        }

        fetch('https://a.klaviyo.com/client/subscriptions/?company_id=' + KLAVIYO_COMPANY, {
          method: 'POST',
          headers,
          body: JSON.stringify({ data: { type: 'subscription', attributes: {
            custom_source: 'Back in stock - product page',
            profile: { data: { type: 'profile', attributes: Object.assign({}, profile, { properties: {
              'Requested product': d.productTitle || '', 'Requested size': size,
              'Requested product URL': d.productUrl || '', 'Requested price': d.productPrice || ''
            } }) } }
          }, relationships: { list: { data: { type: 'list', id: KLAVIYO_LIST } } } } })
        })
          .then((r) => {
            if (r.ok || r.status === 202) {
              setMsg(channel === 'email'
                ? 'Thanks — we’ll email you when it’s back in stock.'
                : 'Thanks — we’ll text you when it’s back in stock.', true);
              emailInput.value = '';
              phoneInput.value = '';
            } else {
              setMsg('Sorry, something went wrong. Please try again.', false);
            }
          })
          .catch(() => setMsg('Sorry, something went wrong. Please try again.', false))
          .then(() => {
            submit.disabled = false;
            submit.textContent = restore;
          });
      });
    }

    // Two lines, then Read more - but only where it actually overflows.
    const descWrap = root.querySelector('[data-desc]');
    if (descWrap) {
      const descText = descWrap.querySelector('[data-desc-text]');
      const descToggle = descWrap.querySelector('[data-desc-toggle]');
      const measure = () => {
        descWrap.classList.remove('is-clamped');
        const line = parseFloat(getComputedStyle(descText).lineHeight) || 24;
        const overflows = descText.scrollHeight > line * 2 + 1;
        descWrap.classList.toggle('is-clamped', overflows);
        descToggle.hidden = !overflows;
        descToggle.textContent = 'Read more';
      };
      descToggle.addEventListener('click', () => {
        const clamped = descWrap.classList.toggle('is-clamped');
        descToggle.textContent = clamped ? 'Read more' : 'Read less';
      });
      measure();
      window.addEventListener('resize', measure);
    }

    // "Size guide" opens the ported Find Your Size modal.
    const guideOpener = root.querySelector('[data-open-size-guide]');
    if (guideOpener) {
      guideOpener.addEventListener('click', () => {
        const trigger = root.querySelector('.guillo-pdp__sizeguide [data-gfys-open]');
        if (trigger) trigger.click();
      });
    }

    const tabs = root.querySelector('[data-tabs]');
    if (tabs) {
      const btns = [...tabs.querySelectorAll('[data-tab-btn]')];
      const panels = [...tabs.querySelectorAll('[data-tab-panel]')];
      const setOpen = (index) => {
        btns.forEach((b) => {
          const on = b.dataset.tabBtn === String(index);
          b.classList.toggle('is-open', on);
          b.setAttribute('aria-expanded', on);
          b.querySelector('.guillo-pdp__tab-mark').textContent = on ? '−' : '+';
        });
        panels.forEach((p) => (p.hidden = p.dataset.tabPanel !== String(index)));
      };
      btns.forEach((b) =>
        b.addEventListener('click', () => {
          setOpen(b.classList.contains('is-open') ? null : b.dataset.tabBtn);
        })
      );
      {% if section.settings.open_first_tab %}setOpen(0);{% endif %}
    }

    // Mobile gallery: track the snapped frame and light the matching dash.
    const gallery = root.querySelector('[data-gallery]');
    const progress = root.querySelector('[data-gallery-progress-fill]');
    if (gallery && progress) {
      const frames = gallery.querySelectorAll('.guillo-pdp__frame');
      const count = frames.length || 1;
      const setProgress = (index) => {
        progress.style.transform = 'translateX(' + index * 100 + '%)';
      };
      let ticking = false;
      const slideTo = (i, smooth) => {
        const w = gallery.clientWidth || 1;
        const idx = Math.max(0, Math.min(count - 1, i));
        const target = idx * w;
        const prev = gallery.style.scrollBehavior;
        gallery.style.scrollBehavior = smooth ? 'smooth' : 'auto';
        gallery.scrollLeft = target;
        gallery.style.scrollBehavior = prev;
        setProgress(idx);
        if (smooth) {
          setTimeout(() => {
            if (Math.abs(gallery.scrollLeft - target) > 4) {
              gallery.style.scrollBehavior = 'auto';
              gallery.scrollLeft = target;
              gallery.style.scrollBehavior = prev;
            }
          }, 300);
        }
      };

      // Drag / swipe. Native overflow scrolling was not reliably picking up
      // the gesture on device, so the pointer drag is handled here. Move and
      // release are tracked on the window: pointer capture on the element
      // fires a pointerleave that would end the drag halfway through.
      let dragging = false;
      let startX = 0;
      let startScroll = 0;

      const onMove = (e) => {
        if (!dragging) return;
        gallery.scrollLeft = startScroll - (e.clientX - startX);
      };

      const endDrag = (e) => {
        if (!dragging) return;
        dragging = false;
        window.removeEventListener('pointermove', onMove);
        window.removeEventListener('pointerup', endDrag);
        window.removeEventListener('pointercancel', endDrag);
        gallery.classList.remove('is-dragging');
        const w = gallery.clientWidth || 1;
        const from = Math.round(startScroll / w);
        const delta = gallery.scrollLeft - startScroll;
        // a decisive flick moves one slide; anything smaller returns
        const step = Math.abs(delta) > w * 0.15 ? (delta > 0 ? 1 : -1) : 0;
        // position while snapping is still off, or mandatory snap yanks it
        // back to the nearest point before the new slide is applied
        slideTo(from + step, false);
        gallery.style.scrollSnapType = '';
      };

      gallery.addEventListener('pointerdown', (e) => {
        if (document.body.classList.contains('guillo-capri-page') && window.innerWidth >= 990) return;
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        dragging = true;
        startX = e.clientX;
        startScroll = gallery.scrollLeft;
        gallery.classList.add('is-dragging');
        gallery.style.scrollSnapType = 'none';
        gallery.style.scrollBehavior = 'auto';
        window.addEventListener('pointermove', onMove);
        window.addEventListener('pointerup', endDrag);
        window.addEventListener('pointercancel', endDrag);
      });

      gallery.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            ticking = false;
            const width = gallery.clientWidth;
            if (!width) return;
            setProgress(Math.round(gallery.scrollLeft / width));
          });
        },
        { passive: true }
      );
    }

    // Video tile: centre icon plays, clicking the video pauses. No native
    // controls, so the icon reappears whenever playback stops.
    const videoTile = root.querySelector('[data-video-tile]');
    if (videoTile) {
      const playBtn = videoTile.querySelector('[data-video-play]');
      const media = videoTile.querySelector('video');
      if (playBtn && media) {
        media.removeAttribute('controls');
        const showIcon = (show) => {
          playBtn.hidden = !show;
        };
        playBtn.addEventListener('click', () => {
          media.play().catch(() => showIcon(true));
        });
        media.addEventListener('click', () => {
          if (media.paused) media.play().catch(() => {});
          else media.pause();
        });
        media.addEventListener('play', () => showIcon(false));
        media.addEventListener('pause', () => showIcon(true));
        media.addEventListener('ended', () => showIcon(true));
      }
    }

    const sticky = root.querySelector('[data-sticky-atc]');
    if (sticky) {
      let shown = false;
      window.addEventListener(
        'scroll',
        () => {
          const mainBuy = root.querySelector('.guillo-pdp__panel [data-atc]');
          const on = (root.classList.contains('guillo-pdp--stone') || document.body.classList.contains('guillo-capri-page')) && mainBuy ? mainBuy.getBoundingClientRect().bottom < (document.querySelector('#header-component')?.getBoundingClientRect().bottom || 80) : window.scrollY > 640;
          if (on !== shown) {
            shown = on;
            sticky.hidden = !on;
          }
        },
        { passive: true }
      );
    }
  })();
</script>

{% stylesheet %}
  .guillo-pdp { background: var(--g-paper); }
  .guillo-pdp__crumb-wrap {
    padding-block: 22px 0;
    max-width: 1500px;
    margin-inline: auto;
  }
  .guillo-pdp__layout {
    display: grid;
    grid-template-columns: 1fr 440px;
    gap: 52px;
    padding: 30px 40px 0 0;
    align-items: start;
  }
  .guillo-pdp__gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
  }
  .guillo-pdp__frame {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--g-canvas);
  }
  .guillo-pdp__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 16%;
    display: block;
  }
  .guillo-pdp__note {
    position: absolute;
    left: 14px;
    bottom: 14px;
    background: rgb(255 255 255 / 0.9);
    color: var(--g-ink);
    font: 500 10px/1 var(--g-sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 7px 10px;
  }
  .guillo-pdp__panel {
    position: sticky;
    top: 110px;
    padding-block: 56px;
  }
  .guillo-pdp__titlerow {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 14px;
  }
  .guillo-pdp__title {
    font: 400 24px/1.2 var(--g-serif);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0;
  }
  .guillo-pdp__style {
    display: block;
    margin-top: 7px;
    font: 300 13px/1.2 var(--g-sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--g-bronze);
  }
  .guillo-pdp__price {
    font: 400 17px/1 var(--g-sans);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .guillo-pdp__rating {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .guillo-pdp__stars {
    font: 400 12px/1 var(--g-sans);
    letter-spacing: 0.3em;
    color: var(--g-ink);
  }
  .guillo-pdp__rating-note {
    font: 300 12px/1 var(--g-sans);
    color: var(--g-muted);
  }
  .guillo-pdp__desc-wrap { margin-bottom: 12px; }
  .guillo-pdp__desc {
    font: 300 14px/1.7 var(--g-sans);
    color: #464A50;
    margin: 0;
  }
  /* Horizon sets p { display: flow-root }, which beats a plain class here and
     silently kills the clamp - the box height has to win on specificity. */
  .guillo-pdp .guillo-pdp__desc-wrap.is-clamped .guillo-pdp__desc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .guillo-pdp__desc-more {
    background: none;
    border: 0;
    padding: 0;
    margin-top: 6px;
    cursor: pointer;
    font: 400 12px/1 var(--g-sans);
    color: var(--g-ink);
    border-bottom: 1px solid var(--g-ink);
  }
  .guillo-pdp__desc-more[hidden] { display: none; }
  .guillo-pdp__desc-more:hover { color: var(--g-bronze); border-bottom-color: var(--g-bronze); }
  .guillo-pdp__desc a {
    color: var(--g-ink);
    border-bottom: 1px solid var(--g-ink);
    text-decoration: none;
  }
  .guillo-pdp__rule {
    margin-bottom: 26px;
    border-bottom: 1px solid var(--g-line);
    padding-bottom: 2px;
  }
  .guillo-pdp__field { margin-bottom: 26px; }
  .guillo-pdp__field-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }
  .guillo-pdp__field-label {
    display: block;
    font: 400 13px/1 var(--g-sans);
    color: var(--g-ink);
    margin-bottom: 14px;
  }
  .guillo-pdp__field-label span { color: var(--g-muted); }
  /* Guillo Fit sits beside the size guide on the size row. */
  .guillo-pdp__size-links { display: inline-flex; align-items: center; gap: 16px; }
  .guillo-pdp__fit-link { display: inline-flex; align-items: center; gap: 6px; }
  .guillo-pdp__fit-link[hidden] { display: none !important; }
  .guillo-pdp__fit-pick {
    margin: 0 0 6px;
    font: 500 11px/1.4 var(--g-sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--g-bronze);
  }
  .guillo-pdp__size-guide {
    font: 500 11px/1 var(--g-sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--g-ink);
    border-bottom: 1px solid var(--g-ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .guillo-pdp__colours {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 4px;
  }
  .guillo-pdp__colours::-webkit-scrollbar { display: none; }
  .guillo-pdp__colour { flex: 0 0 auto; }
  .guillo-pdp__colour { text-decoration: none; }
  .guillo-pdp__colour--soon {
    cursor: default;
    pointer-events: none;
  }
  .guillo-pdp__colour--soon .guillo-pdp__colour-frame { opacity: 0.45; }
  .guillo-pdp__colour--soon .guillo-pdp__colour-name { color: var(--g-whisper); }
  .guillo-pdp__colour-soon {
