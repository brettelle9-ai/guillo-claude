    border-top-color: var(--g-ink);
  }
  .guillo-pdp__info:hover .guillo-pdp__info-bubble,
  .guillo-pdp__info:focus-within .guillo-pdp__info-bubble,
  .guillo-pdp__info-dot[aria-expanded='true'] + .guillo-pdp__info-bubble {
    opacity: 1;
    visibility: visible;
  }
  .guillo-pdp__size span:hover { border-color: var(--g-ink); }
  .guillo-pdp__size input:checked + span {
    background: var(--g-ink);
    color: var(--g-off);
    border-color: var(--g-ink);
  }
  /* Sold out reads as available-to-ask, not struck through: the size is
     still a live control that opens the back-in-stock form. */
  button.guillo-pdp__size {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .guillo-pdp__size--gone span {
    color: #8E9096;
    border-style: dashed;
    border-color: #CFD1D5;
    background: transparent;
  }
  .guillo-pdp__size--gone:hover span {
    border-color: var(--g-ink);
    color: var(--g-ink);
  }
  .guillo-pdp__notify {
    margin-top: 14px;
    padding: 22px;
    background: var(--g-off);
    border: 1px solid var(--g-line);
  }
  .guillo-pdp__notify-back {
    background: none;
    border: 0;
    padding: 0;
    margin: 0 0 16px;
    cursor: pointer;
    font: 500 10px/1 var(--g-sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--g-whisper);
  }
  .guillo-pdp__notify-back:hover { color: var(--g-ink); }
  .guillo-pdp__notify-title {
    font: 500 16px/1.4 var(--g-serif);
    color: var(--g-ink);
    margin: 0 0 6px;
  }
  .guillo-pdp__notify-sub {
    font: 300 13px/1.6 var(--g-sans);
    color: var(--g-muted);
    margin: 0 0 18px;
  }
  .guillo-pdp__notify-tabs {
    display: flex;
    gap: 24px;
    border-bottom: 1px solid var(--g-line);
    margin-bottom: 16px;
  }
  .guillo-pdp__notify-tab {
    position: relative;
    background: none;
    border: 0;
    padding: 0 0 10px;
    cursor: pointer;
    font: 400 13px/1 var(--g-sans);
    color: var(--g-whisper);
  }
  .guillo-pdp__notify-tab.is-active { color: var(--g-ink); }
  .guillo-pdp__notify-tab.is-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--g-ink);
  }
  .guillo-pdp__notify-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .guillo-pdp__notify-input {
    height: 50px;
    padding: 0 16px;
    border: 1px solid #CFD1D5;
    background: var(--g-paper);
    font: 300 14px/1 var(--g-sans);
    color: var(--g-ink);
  }
  .guillo-pdp__notify-input:focus {
    outline: none;
    border-color: var(--g-ink);
  }
  .guillo-pdp__notify-submit {
    height: 50px;
    border: 0;
    cursor: pointer;
    background: var(--g-ink);
    color: var(--g-off);
    font: 500 11px/1 var(--g-sans);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .guillo-pdp__notify-submit[disabled] { opacity: 0.5; cursor: default; }
  .guillo-pdp__notify-msg {
    font: 300 13px/1.5 var(--g-sans);
    margin: 12px 0 0;
    min-height: 1em;
  }
  .guillo-pdp__notify-msg.is-ok { color: #2F7D5F; }
  .guillo-pdp__notify-msg.is-err { color: #B3402F; }
  .guillo-pdp__size-hint {
    font: 300 11px/1.6 var(--g-sans);
    color: var(--g-faint);
    margin: 11px 0 24px;
  }
  .guillo-pdp__atc {
    width: 100%;
    height: 56px;
    background: var(--g-ink);
    color: var(--g-off);
    border: 0;
