    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .guillo-pdp__atc:hover:not(:disabled) { background: var(--g-ink-2); }
  .guillo-pdp__atc:disabled {
    cursor: default;
    opacity: 0.85;
  }
  .guillo-pdp__video {
    position: relative;
    margin-bottom: 30px;
  }
  .guillo-pdp__video-frame {
    position: relative;
    aspect-ratio: var(--video-ratio, 1 / 1);
    overflow: hidden;
    background: var(--g-canvas);
  }
  /* Focal point for the tile: the poster, the video and the still all crop
     to the same point. */
  .guillo-pdp__video-media,
  .guillo-pdp__video-frame video,
  .guillo-pdp__video-frame img,
  .guillo-pdp__video-player video {
    object-position: var(--video-pos, center center);
    object-fit: var(--video-fit, cover);
  }
  .guillo-pdp__video-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .guillo-pdp__video-player video { width: 100%; height: 100%; object-fit: cover; }
  .guillo-pdp__video-frame video.guillo-pdp__video-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    cursor: pointer;
  }
  .guillo-pdp__video-play[hidden] { display: none; }
  .guillo-pdp__video-play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 62px;
    height: 62px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .guillo-pdp__video-play:hover {
    background: #fff;
    transform: translate(-50%, -50%) scale(1.06);
  }
  .guillo-pdp__video-play span {
    width: 0;
    height: 0;
    margin-left: 4px;
    border-left: 12px solid var(--g-ink);
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
  }
  /* The ported pair builder brings its own 22px top margin, which left the
     button floating. Tightened here rather than in the snippet, so that file
     stays a straight copy of the live one. */
  .guillo-pdp .gpb { margin-top: 10px; }
  .guillo-pdp__trust {
    text-align: center;
    font: 500 10px/1 var(--g-sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--g-muted);
    padding: 16px 0 30px;
  }
  .guillo-pdp__features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px 16px;
    padding-bottom: 30px;
  }
  .guillo-pdp__feature {
    display: flex;
    align-items: center;
    gap: 11px;
    font: 500 10px/1.35 var(--g-sans);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--g-ink);
  }
  .guillo-pdp__feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 19px;
    height: 19px;
    color: var(--g-ink);
    flex-shrink: 0;
  }
  .guillo-pdp__feature-dot {
    width: 7px;
    height: 7px;
    border: 1px solid var(--g-ink);
    transform: rotate(45deg);
  }
  button.guillo-pdp__size-guide {
    background: none;
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--g-ink);
    cursor: pointer;
  }
  /* The guide ships its own inline trigger; the Size row link opens it instead. */
  .guillo-pdp__sizeguide .gfys-trigger { display: none !important; }

  .guillo-pdp__tabbar {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--g-line);
  }
  .guillo-pdp__tab-btn {
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    padding: 0 0 12px;
    cursor: pointer;
    white-space: nowrap;
    font: 400 13px/1 var(--g-sans);
    color: var(--g-whisper);
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .guillo-pdp__tab-btn:hover { color: var(--g-ink); }
  .guillo-pdp__tab-btn.is-open {
    color: var(--g-ink);
    border-color: var(--g-ink);
  }
  .guillo-pdp__tab-mark {
    font: 300 15px/1 var(--g-sans);
    color: #A0A3A9;
  }
  .guillo-pdp__tab-btn.is-open .guillo-pdp__tab-mark { color: var(--g-ink); }
  .guillo-pdp__tab-panel {
    padding-top: 26px;
    font: 300 14px/1.8 var(--g-sans);
    color: #464A50;
    animation: g-fade 0.24s both;
  }
  .guillo-pdp__tab-panel p { margin: 0 0 15px; }
  .guillo-pdp__tab-panel ul {
    list-style: none;
    margin: 0 0 15px;
    padding: 0;
    border-top: 1px solid var(--g-line);
  }
  .guillo-pdp__tab-panel li {
    padding: 9px 0;
    border-bottom: 1px solid var(--g-line);
  }
  .guillo-pdp__tab-panel a {
    color: var(--g-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .guillo-pdp__sticky {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9;
    background: rgb(255 255 255 / 0.97);
    backdrop-filter: blur(16px);
    border-top: 1px solid var(--g-line-mid);
    animation: g-slide-up 0.3s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .guillo-pdp__sticky-inner {
    padding: 12px 40px;
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .guillo-pdp__sticky-thumb {
    width: 54px;
    height: 66px;
    object-fit: cover;
    object-position: center 16%;
    background: var(--g-canvas);
  }
  .guillo-pdp__sticky-copy { flex: 1; }
  .guillo-pdp__sticky-title { font: 400 14px/1.3 var(--g-sans); }
  .guillo-pdp__sticky-price {
    font: 300 12px/1 var(--g-sans);
    color: var(--g-faint);
    margin-top: 4px;
  }
  .guillo-pdp__atc--sticky {
    width: auto;
    height: 48px;
    padding: 0 40px;
  }
  .guillo-pdp__gallery-wrap { display: contents; }
  .guillo-pdp__progress { display: none; }

  @media screen and (max-width: 989px) {
    /* Mobile follows the design's phone layout: title, rating and price sit
       above a full-bleed swipe gallery, then the rest of the buy panel. The
       panel becomes `display: contents` so its children can be reordered
       around the gallery without duplicating the heading in the markup. */
    .guillo-pdp__layout {
      display: flex;
      flex-direction: column;
      /* Reset the desktop grid's `align-items: start`, which would otherwise
         shrink every column-flex child to its content width. */
      align-items: stretch;
      gap: 0;
      padding: 0;
    }
    .guillo-pdp__crumb-wrap { padding-block: 14px 0; }

    .guillo-pdp__gallery-wrap {
      display: block;
      position: relative;
      order: 3;
    }
    .guillo-pdp__panel {
      display: contents;
      position: static;
      padding: 0;
    }
    .guillo-pdp__panel > * {
      order: 4;
      padding-inline: 20px;
    }
    .guillo-pdp__titlerow {
      order: 1;
      padding: 20px 20px 11px;
      margin-bottom: 0;
      align-items: center;
    }
    .guillo-pdp__title { font-size: 17px; }
    .guillo-pdp__price { font-size: 13px; }
    .guillo-pdp__rating {
      order: 2;
      padding: 0 20px 22px;
      margin-bottom: 0;
    }
    .guillo-pdp__desc { padding-top: 22px; }

    /* One image per screen, swipeable */
    .guillo-pdp__gallery {
      display: flex;
      gap: 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      /* vertical page scroll stays native; horizontal is handled in JS */
      touch-action: pan-y;
      cursor: grab;
      -ms-overflow-style: none;
      overscroll-behavior-x: contain;
    }
    .guillo-pdp__gallery::-webkit-scrollbar { display: none; }
    .guillo-pdp__frame {
      flex: 0 0 100%;
      scroll-snap-align: start;
    }
    .guillo-pdp__gallery.is-dragging { cursor: grabbing; }
    .guillo-pdp__gallery img {
      user-select: none;
      -webkit-user-drag: none;
    }
    .guillo-pdp__progress {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 3px;
      background: rgb(23 24 27 / 0.12);
      overflow: hidden;
    }
    .guillo-pdp__progress-fill {
      display: block;
      height: 100%;
      background: var(--g-ink);
      transform: translateX(0);
      transition: transform 0.25s ease;
    }

    .guillo-pdp__sticky-inner { padding: 10px 16px; }
    .guillo-pdp__sizes { grid-template-columns: repeat(3, 1fr) !important; }
    .guillo-pdp__size span { height: 52px; }
    .guillo-pdp__colour-frame { width: 80px; height: 80px; }
    /* More colourways than fit the screen scroll rather than clip */
    .guillo-pdp__colours {
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 4px;
    }
    .guillo-pdp__colours::-webkit-scrollbar { display: none; }
    .guillo-pdp__colour { flex: 0 0 auto; }
    /* Centred on a phone as a block rather than per cell: the columns
       shrink to their content and the pair is centred, so the icons stay
       aligned down each column instead of stepping in and out. */
    .guillo-pdp__features {
      padding-inline: 20px;
      grid-template-columns: repeat(2, minmax(0, max-content));
      justify-content: center;
      column-gap: 34px;
    }
    /* Centres both rows of tabs, including the one that wraps. */
    .guillo-pdp__tabbar { justify-content: center; }
    .guillo-pdp__video {
      margin-inline: 20px;
      padding-inline: 0;
    }
  }

  /* Availability band: quiet, bronze-keyed, sits above the title so the state
     of the product is the first thing read. */
  .guillo-pdp__avail {
    border-top: 1px solid var(--g-line);
    border-bottom: 1px solid var(--g-line);
    padding-block: 14px 15px;
    margin: 0 0 20px;
  }
  .guillo-pdp__avail-eyebrow {
    font: 500 9px/1 var(--g-sans);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--g-bronze);
    margin: 0 0 9px;
  }
  .guillo-pdp__avail-line {
    font: 400 17px/1.35 var(--g-serif);
    color: var(--g-ink);
    margin: 0;
  }
  .guillo-pdp__avail-note {
    font: 300 13px/1.6 var(--g-sans);
    color: var(--g-muted);
    margin: 7px 0 0;
  }
  .guillo-pdp__avail-reward {
    font: 400 12px/1.5 var(--g-sans);
    letter-spacing: 0.04em;
    color: var(--g-ink);
    margin: 10px 0 0;
    padding-top: 10px;
    border-top: 1px solid var(--g-line);
  }
  @media screen and (max-width: 749px) {
    .guillo-pdp__avail { margin-bottom: 16px; }
    .guillo-pdp__avail-line { font-size: 16px; }
  }

  /* Sparse galleries, desktop only (the phone gallery is a swipe scroller).
     Two images stay side by side and fill the column, as the normal grid does.
     One image sizes its column to the photograph at full screen height and
     brings the buy panel beside it, so there is no dead band in between. */
  @media screen and (min-width: 990px) {
    .guillo-pdp__layout--single {
      --pdp-hero-h: clamp(560px, calc(100svh - 150px), 1080px);
      grid-template-columns: calc(var(--pdp-hero-h) * 0.8) 440px;
      justify-content: center;
      gap: 72px;
      padding-left: 40px;
    }
    .guillo-pdp__gallery--single {
      grid-template-columns: 1fr;
      position: sticky;
      top: 88px;
    }
    .guillo-pdp__gallery--single .guillo-pdp__frame {
      aspect-ratio: auto;
      height: var(--pdp-hero-h);
    }
  }

  .guillo-pdp__avail-ships {
    font: 500 13px/1.5 var(--g-sans);
    letter-spacing: 0.02em;
    color: var(--g-ink);
    margin: 9px 0 0;
  }

  /* Leg length: one joined switch on the same line as its label, lighter than
     the size boxes below it so it reads as a secondary choice. */
  .guillo-pdp__leg {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .guillo-pdp__leg .guillo-pdp__field-label { margin: 0; }
  .guillo-pdp__leg-switch {
    display: inline-grid;
    grid-auto-flow: column;
    grid-auto-columns: 64px;
    border: 1px solid var(--g-line);
  }
  .guillo-pdp__leg-opt {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 34px;
    font: 500 11px/1 var(--g-sans);
    letter-spacing: 0.14em;
    color: var(--g-muted);
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .guillo-pdp__leg-opt + .guillo-pdp__leg-opt { border-left: 1px solid var(--g-line); }
  a.guillo-pdp__leg-opt:hover { color: var(--g-ink); background: var(--g-off); }
  .guillo-pdp__leg-opt.is-current {
    background: var(--g-ink);
    color: #fff;
  }

  /* The band already closes with a hairline; when nothing sits between it and
     the options divider (no reviews yet, description off) skip the second one. */
  .guillo-pdp__avail + .guillo-pdp__rule { display: none; }

  /* =====================================================================
     Stone Luxe Chino conversion test. Every selector is prefixed with
     .guillo-pdp--stone, which only renders on that one product, so nothing
     here can reach another page. Uses the existing tokens and type scale.
     ===================================================================== */
  .guillo-pdp--stone .gstone-lead { margin: 0 0 22px; }
  .guillo-pdp--stone .gstone-lead__head {
    font: 400 13px/1.5 var(--g-sans);
    letter-spacing: 0.02em;
    color: var(--g-ink);
    margin: 0 0 3px;
  }
  .guillo-pdp--stone .gstone-lead__sub {
    font: 300 13px/1.6 var(--g-sans);
    color: var(--g-muted);
    margin: 0;
    max-width: 46ch;
  }
  /* Stone test: stacked accordion rows in the column. */
  .guillo-pdp--stone .gstone-acc {
    display: block;
    margin-top: 26px;
    border-top: 1px solid var(--g-line);
  }
  .guillo-pdp--stone .gstone-acc__item { border-bottom: 1px solid var(--g-line); }
  .guillo-pdp--stone .gstone-acc__btn,
  .guillo-pdp--stone .gstone-acc__btn.is-open {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    margin: 0;
    padding: 16px 0;
    border-bottom: 0;
    white-space: normal;
    text-align: left;
    font: 400 13px/1.3 var(--g-sans);
    letter-spacing: 0.02em;
    color: var(--g-ink);
  }
  .guillo-pdp--stone .gstone-acc__panel {
    padding: 0 0 22px;
    font: 300 14px/1.6 var(--g-sans);
    max-width: 60ch;
  }
  .guillo-pdp--stone .gstone-acc__panel p { margin: 0 0 12px; }
  .guillo-pdp--stone .gstone-acc__panel p:last-child { margin-bottom: 0; }
  .guillo-pdp--stone .gstone-acc__panel ul { margin: 4px 0 14px; }
  .guillo-pdp--stone .gstone-acc__panel li { padding: 8px 0; }

  /* Stone: the rating under the title is an anchor to the reviews section.
     Looks like the rating it was; underlines on hover so it reads as a link. */
  .guillo-pdp--stone .guillo-pdp__rating--link { text-decoration: none; color: inherit; }
  .guillo-pdp--stone .guillo-pdp__rating--link .guillo-pdp__rating-note { border-bottom: 1px solid transparent; transition: border-color 0.15s ease; }
  .guillo-pdp--stone .guillo-pdp__rating--link:hover .guillo-pdp__rating-note,
  .guillo-pdp--stone .guillo-pdp__rating--link:focus-visible .guillo-pdp__rating-note { border-bottom-color: var(--g-ink); }
  .guillo-pdp--stone .guillo-pdp__rating--link:focus-visible { outline: 1px solid var(--g-ink); outline-offset: 4px; }
  /* The jump animates only for people who have not asked for less motion. */
  @media (prefers-reduced-motion: no-preference) {
    html:has(.guillo-pdp--stone) { scroll-behavior: smooth; }
  }

  /* Stone: the outfit builder stays, but as one more quiet row under the
     button rather than a boxed offer. Hierarchy only; nothing functional. */
  .guillo-pdp--stone .gob { border: 0; border-top: 1px solid var(--g-line); border-bottom: 1px solid var(--g-line); margin: 24px 0 0; }
  .guillo-pdp--stone .gob__toggle { padding: 15px 0; gap: 12px; }
  .guillo-pdp--stone .gob__plus { width: auto; order: 3; font-size: 15px; color: #A0A3A9; }
  .guillo-pdp--stone .gob.is-open .gob__plus { color: var(--g-ink); }
  .guillo-pdp--stone .gob__toggle-label { font: 400 13px/1.3 var(--g-sans); letter-spacing: 0.02em; text-transform: none; }
  .guillo-pdp--stone .gob__deal { font: 300 12px/1.3 var(--g-sans); letter-spacing: 0.02em; text-transform: none; color: var(--g-faint); margin-right: 10px; }
  .guillo-pdp--stone .gob__body { padding: 0 0 20px; border-top: 0; }
{% endstylesheet %}


{%- if stone_test -%}
  <script>
    /* Stone test only: cycles the verified quotes above the video. Pauses on
       hover and for anyone who asks for reduced motion. No library. */
    (function () {
      var box = document.querySelector('[data-gstone-voices]');
      if (!box) return;
      var slides = [].slice.call(box.querySelectorAll('[data-gstone-voice]'));
      var dots = [].slice.call(box.querySelectorAll('[data-gstone-dot]'));
      if (slides.length < 2) return;
      var i = 0, timer = null;
      var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function show(n) {
        i = (n + slides.length) % slides.length;
        slides.forEach(function (s, x) {
          s.classList.toggle('is-on', x === i);
          if (x === i) { s.removeAttribute('aria-hidden'); } else { s.setAttribute('aria-hidden', 'true'); }
        });
        dots.forEach(function (d, x) {
          d.classList.toggle('is-on', x === i);
          d.setAttribute('aria-selected', x === i ? 'true' : 'false');
        });
      }
      function play() { if (!still) { stop(); timer = setInterval(function () { show(i + 1); }, 6000); } }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      dots.forEach(function (d) {
        d.addEventListener('click', function () { show(parseInt(d.dataset.gstoneDot, 10)); play(); });
      });
      box.addEventListener('mouseenter', stop);
      box.addEventListener('mouseleave', play);
      play();
    })();
  </script>
{%- endif -%}

