    border-top-color: var(--g-ink);
  }
  .guillo-pdp__size--pre:hover .guillo-pdp__size-tip,
  .guillo-pdp__size--pre:focus-within .guillo-pdp__size-tip,
  .guillo-pdp__size--pre:focus .guillo-pdp__size-tip {
    opacity: 1;
