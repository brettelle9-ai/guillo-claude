  .guillo-pdp__size-tag--pre { color: var(--g-bronze); }
  .guillo-pdp__size input:checked + span .guillo-pdp__size-tag { color: inherit; }
  /* The pre-order sizes explain themselves on hover and on keyboard focus,
     so there is no separate info icon to find. */
  .guillo-pdp__size--pre { position: relative; }
  .guillo-pdp__size-tip {
    position: absolute;
