{% comment %}
  Black utility bar above the header: one message at a time, sliding across,
  at every width. Showing them all in a row ran them off the edge of the bar
  on desktop, so the rotation that was once a phone-only behaviour is now how
  the bar works everywhere.

  Each message can carry a shorter mobile wording, the way the live store's
  gheader_announcement_m* settings do, so a phone shows the same promise in
  fewer words rather than dropping it.

  Messages are country-aware, like the live gscene-header: a message can be
  limited to certain countries or hidden from them, so GB sees its own
  delivery and duties lines and never the AUD ones. Codes are ISO-2 and
  resolved from Shopify Markets via localization.country.iso_code.

  A message can also carry an optional link. When one is set the message
  renders as an anchor rather than a span, keeping the same
  guillo-announce__msg class so the rotation still drives it.
{% endcomment %}

<div class="guillo-announce">
  {%- liquid
    assign cc = localization.country.iso_code | default: ''
    assign shown = ''
    for block in section.blocks
      assign ok = true
      if block.settings.only_countries != blank
        assign only = block.settings.only_countries | upcase | replace: ' ', '' | split: ','
        unless only contains cc
          assign ok = false
        endunless
      endif
      if block.settings.not_countries != blank
        assign nope = block.settings.not_countries | upcase | replace: ' ', '' | split: ','
        if nope contains cc
          assign ok = false
        endif
      endif
      if ok
        # comma-delimited on BOTH sides: `contains` is substring matching on a
        # string, so a bare id lets msg1 match inside msg10.
        assign shown = shown | append: ',' | append: block.id | append: ','
      endif
    endfor
  -%}
  <button type="button" class="guillo-announce__nav" data-ann-prev aria-label="Previous announcement">
    <span aria-hidden="true">&#8249;</span>
  </button>
  <div class="guillo-announce__messages" data-ann-track>
    {%- for block in section.blocks -%}
      {%- capture block_key -%},{{ block.id }},{%- endcapture -%}
      {%- unless shown contains block_key -%}{%- continue -%}{%- endunless -%}
      {%- capture msg_body -%}
        {%- if block.settings.text_mobile != blank -%}
          <span class="guillo-announce__long">{{ block.settings.text }}</span>
          <span class="guillo-announce__short">{{ block.settings.text_mobile }}</span>
        {%- else -%}
          {{- block.settings.text -}}
        {%- endif -%}
      {%- endcapture -%}
      {%- if block.settings.url != blank -%}
        <a
          class="guillo-announce__msg guillo-announce__msg--link{% if block.settings.accent %} guillo-announce__msg--accent{% endif %}"
          href="{{ block.settings.url }}"
          {{ block.shopify_attributes }}
        >{{ msg_body }}</a>
      {%- else -%}
        <span
          class="guillo-announce__msg{% if block.settings.accent %} guillo-announce__msg--accent{% endif %}"
          {{ block.shopify_attributes }}
        >{{ msg_body }}</span>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <button type="button" class="guillo-announce__nav" data-ann-next aria-label="Next announcement">
    <span aria-hidden="true">&#8250;</span>
  </button>
</div>

{% stylesheet %}
  .guillo-announce {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    height: 32px;
    padding: 0 8px;
    background: #111b20;
    border-bottom: 0;
    color: #ECEDEB;
    font: 500 10px/1 var(--g-sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* One message at a time at every width. The message travels across the bar
     rather than blinking over: the one leaving slides out the way it is
     going, the next comes in behind it. */
  .guillo-announce__messages {
    position: relative;
    flex: 1;
    height: 32px;
    overflow: hidden;
  }
  .guillo-announce__msg {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-inline: 4px;
    white-space: normal;
    opacity: 0;
    transform: translateX(24px);
    transition: opacity 0.75s ease, transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }
  .guillo-announce__msg.is-leaving { opacity: 0; transform: translateX(-24px); }
  .guillo-announce--back .guillo-announce__msg { transform: translateX(-24px); }
  .guillo-announce--back .guillo-announce__msg.is-leaving { transform: translateX(24px); }
  .guillo-announce__msg.is-current {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .guillo-announce__short { display: none; }

  /* A linked message keeps the bar's type and colour and underlines the words
     themselves, not the full width of the bar. The colour reset has to come
     before the accent rule below, or it cancels the bronze. */
  .guillo-announce__msg--link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .guillo-announce__msg--link:hover { text-decoration-thickness: 2px; }
  .guillo-announce__msg--accent { color: #ECEDEB; }

  /* Nothing sits beside anything now, so the pipes have no job. */
  .guillo-announce__sep { display: none; }

  .guillo-announce__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 26px;
    height: 32px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: 300 17px/1 var(--g-sans);
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 0.25s ease;
  }
  .guillo-announce__nav:hover,
  .guillo-announce__nav:active { opacity: 1; }

  @media screen and (max-width: 989px) {
    .guillo-announce { padding: 0 6px; }
    .guillo-announce__long { display: none; }
    .guillo-announce__short { display: inline; }
  }
  @media (prefers-reduced-motion: reduce) {
    .guillo-announce__msg { transition: none; }
  }
{% endstylesheet %}

<script>
  (() => {
    const track = document.querySelector('[data-ann-track]');
    if (!track) return;
    const msgs = [...track.querySelectorAll('.guillo-announce__msg')];
    if (msgs.length < 2) {
      msgs.forEach((m) => m.classList.add('is-current'));
      return;
    }

    const bar = track.closest('.guillo-announce');
    const seconds = {{ section.settings.rotate_seconds | default: 6 }};
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');

    let i = 0;
    let timer = null;

    const show = (n, back) => {
      const from = i;
      i = (n + msgs.length) % msgs.length;
      if (bar) bar.classList.toggle('guillo-announce--back', !!back);
      msgs.forEach((m, x) => {
        m.classList.toggle('is-current', x === i);
        m.classList.toggle('is-leaving', x === from && from !== i);
      });
    };

    const stop = () => { if (timer) { clearInterval(timer); timer = null; } };
    const start = () => {
      stop();
      // Auto-advance while the tab is visible and the visitor has not asked
      // for less motion. The arrows always work either way.
      if (still.matches || document.hidden) return;
      timer = setInterval(() => show(i + 1), seconds * 1000);
    };

    show(0);
    start();

    const step = (n, back) => { show(n, back); start(); };
    const prev = document.querySelector('[data-ann-prev]');
    const next = document.querySelector('[data-ann-next]');
    if (prev) prev.addEventListener('click', () => step(i - 1, true));
    if (next) next.addEventListener('click', () => step(i + 1));

    // Pausing while it is being read or interacted with.
    if (bar) {
      bar.addEventListener('mouseenter', stop);
      bar.addEventListener('mouseleave', start);
      bar.addEventListener('focusin', stop);
      bar.addEventListener('focusout', start);
      bar.addEventListener('touchstart', stop, { passive: true });
    }
    document.addEventListener('visibilitychange', start);

    let x0 = null;
    track.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    track.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) step(dx < 0 ? i + 1 : i - 1, dx > 0);
      else start();
      x0 = null;
    }, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Guillo announcement",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "range",
      "id": "rotate_seconds",
      "label": "Seconds per message",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6,
      "unit": "s",
      "info": "How long each message rests before the next slides in."
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Same-day dispatch before 4pm"
        },
        {
          "type": "text",
          "id": "text_mobile",
          "label": "Short text (mobile)",
          "info": "Optional shorter wording for phones."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "info": "Optional. Makes this message clickable."
        },
        {
          "type": "checkbox",
          "id": "accent",
          "label": "Bronze accent",
          "default": false
        },
        {
          "type": "text",
          "id": "only_countries",
          "label": "Show only in",
          "info": "ISO country codes, comma separated, e.g. GB or GB, IE. Leave blank to show everywhere."
        },
        {
          "type": "text",
          "id": "not_countries",
          "label": "Hide in",
          "info": "ISO country codes to hide this message from, e.g. GB, SG."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Guillo announcement",
      "category": "Guillo",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "Same-day dispatch before 4pm"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "15% off three or more",
            "accent": true
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Packs without creasing"
          }
        }
      ]
    }
  ]
}
{% endschema %}
