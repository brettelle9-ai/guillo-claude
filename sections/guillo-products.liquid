{% comment %}
  Product row: eyebrow + serif heading + optional "View all" link, then
  Guillo product cards.

  Two modes. Add "Product" blocks to curate an exact, ordered selection
  (signature pieces, chosen deliberately); leave the blocks off and it falls
  back to the first N products of a chosen collection, which is how this
  section behaved before curation was added.

  The grid column count follows the number of cards, so a curated row of
  three does not sit in a four-column grid with a hole in it.
{% endcomment %}

{%- liquid
  # Count the blocks that actually name a product. `concat` only joins arrays,
  # so the products are not collected into one: the render loop below walks the
  # blocks directly and skips the empty ones.
  assign picked_count = 0
  for block in section.blocks
    if block.settings.product != blank
      assign picked_count = picked_count | plus: 1
    endif
  endfor

  assign use_blocks = false
  if picked_count > 0
    assign use_blocks = true
  endif

  if use_blocks
    assign card_count = picked_count
  else
    assign card_count = section.settings.products_to_show
  endif

  # Cards are wide when there are few of them, so the image sizes hint has to
  # follow the real column count rather than assume a quarter of the viewport.
  assign col_pct = 100 | divided_by: card_count
  assign card_sizes = '(min-width: 990px) ' | append: col_pct | append: 'vw, 50vw'
-%}

<section class="guillo-products g-pad" style="--g-products-cols: {{ card_count | at_most: 4 }};">
  <div class="g-container">
    <div class="g-section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="g-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.collection != blank -%}
        <a href="{{ section.settings.collection.url }}" class="g-link">{{ section.settings.link_label | default: 'View all' }}</a>
      {%- endif -%}
    </div>

    <div class="guillo-products__grid">
      {%- liquid
        if use_blocks
          for block in section.blocks
            if block.settings.product != blank
              render 'guillo-product-card', product: block.settings.product, show_quick: section.settings.show_quick_add, sizes: card_sizes
            endif
          endfor
        elsif section.settings.collection != blank
          for product in section.settings.collection.products limit: section.settings.products_to_show
            render 'guillo-product-card', product: product, show_quick: section.settings.show_quick_add, sizes: card_sizes
          endfor
        else
          for i in (1..card_count)
            echo 'product-apparel-1' | placeholder_svg_tag: 'guillo-products__placeholder'
          endfor
        endif
      -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .guillo-products {
    padding-block: 98px 96px;
    background: var(--g-paper);
  }
  .guillo-products__grid {
    display: grid;
    grid-template-columns: repeat(var(--g-products-cols, 4), 1fr);
    gap: 36px;
  }
  /* Editorial card treatment, scoped to this row only. The shared .g-card
     keeps its elevated look everywhere else; here the image sits flat on the
     page with the information set beneath it like a caption. */
  .guillo-products__grid .g-card {
    background: transparent;
    box-shadow: none;
    transition: none;
  }
  .guillo-products__grid .g-card:hover { transform: none; box-shadow: none; }
  .guillo-products__grid .g-card__media {
    aspect-ratio: 4 / 5;
    background: var(--g-grey);
  }
  .guillo-products__grid .g-card__img { object-position: center 12%; }
  .guillo-products__grid .g-card__info {
    display: flex;
    flex-direction: column;
    padding: 18px 0 0;
  }
  .guillo-products__grid .g-card__row {
    order: 1;
    align-items: baseline;
    gap: 16px;
  }
  .guillo-products__grid .g-card__title {
    font: 500 17px/1.25 var(--g-serif);
    letter-spacing: 0;
    text-transform: none;
    max-width: none;
  }
  .guillo-products__grid .g-card__price {
    font: 300 13px/1.25 var(--g-sans);
    color: var(--g-muted);
  }
  .guillo-products__grid .g-card__style {
    order: 2;
    margin-top: 6px;
    font: 400 10px/1.3 var(--g-sans);
    letter-spacing: 0.18em;
    color: var(--g-bronze);
  }
  .guillo-products__grid .g-card__rating {
    order: 3;
    margin: 12px 0 0;
    font: 300 11px/1 var(--g-sans);
    color: var(--g-faint);
  }
  .guillo-products__grid .g-card__dots { order: 4; padding-top: 12px; }
  .guillo-products__placeholder {
    aspect-ratio: 4 / 5;
    width: 100%;
    background: var(--g-canvas);
  }
  @media screen and (max-width: 989px) {
    .guillo-products { padding-block: 64px 60px; }
    .guillo-products__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 28px 16px;
    }
    .guillo-products__grid .g-card__info { padding-top: 14px; }
    .guillo-products__grid .g-card__title { font-size: 15px; }
    .guillo-products__grid .g-card__price { font-size: 12px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Guillo product row",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Best sellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The pieces that earn their place in the bag." },
    { "type": "header", "content": "Curated selection" },
    { "type": "paragraph", "content": "Add Product blocks to choose the exact pieces and their order. With no Product blocks the row falls back to the collection below." },
    { "type": "header", "content": "Fallback and link" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Used for the \"View all\" link, and as the product source when no Product blocks are added." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "range", "id": "products_to_show", "label": "Products to show (fallback only)", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_quick_add", "label": "Show quick add on hover", "default": true }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "presets": [
    { "name": "Guillo product row", "category": "Guillo" }
  ]
}
{% endschema %}
