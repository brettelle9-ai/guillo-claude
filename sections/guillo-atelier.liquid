{{ 'guillo-atelier.css' | asset_url | stylesheet_tag }}
<guillo-atelier class="ga">
  <section class="ga-gallery" aria-labelledby="ga-selection-{{ section.id }}">
    <header class="ga-heading ga-reveal"><div><h2 id="ga-selection-{{ section.id }}">The collections</h2></div></header>
    <div class="ga-gallery__grid">
      {%- for block in section.blocks -%}
        {% render 'guillo-category-card', block: block %}
      {%- endfor -%}
    </div>

  </section>
  {%- assign signature = section.settings.signature_product -%}
  {%- if signature != blank -%}
  <section class="ga-signature" aria-labelledby="ga-signore-{{ section.id }}">
    <div class="ga-signature__stage">
      <div class="ga-signature__word" aria-hidden="true">SIGNORE</div>
      <div class="ga-signature__copy">
        <p class="ga-kicker">The Guillo cut</p>
        <h2 id="ga-signore-{{ section.id }}">The Signore.</h2>
        <div class="ga-signature__chapters">
          <div class="ga-signature__chapter is-current" data-chapter="0">
            <h3>The classic cut.</h3><p>A little more room through the leg, with a tailored silhouette.</p>
          </div>
          <div class="ga-signature__chapter" data-chapter="1">
            <h3>Side-tab adjustment.</h3><p>Adjust the waist at the sides. Keep the front clean.</p>
          </div>
          <div class="ga-signature__chapter" data-chapter="2">
            <h3>The full silhouette.</h3><p>Pair with a fitted shirt or an open-collar polo.</p>
          </div>
        </div>
        <div class="ga-signature__shopping"><a class="ga-link" href="{{ signature.url }}">Shop the Signore <span aria-hidden="true">↗</span></a><span class="ga-signature__price">{{ signature.price | money }} <span>/ {{ section.settings.signature_colour | escape }}</span></span></div>
        <p class="ga-signature__guide">Scroll through the details <span aria-hidden="true">↓</span></p>
      </div>
      <div class="ga-signature__visual">
        <div class="ga-signature__photos">
          {%- for img in signature.images limit: 3 -%}
            <div class="ga-signature__frame{% if forloop.first %} is-current{% endif %}" data-view="{{ forloop.index0 }}">
              {{ img | image_url: width: 1200 | image_tag: widths: '480, 750, 1000, 1200', sizes: '(min-width: 990px) 45vw, 100vw', loading: 'lazy', alt: img.alt }}
            </div>
          {%- endfor -%}
        </div>
        <div class="ga-view-controls" hidden><span>Explore the cut</span><div>
          {%- for img in signature.images limit: 3 -%}
            <button type="button" data-view-button="{{ forloop.index0 }}" aria-label="Signore view {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{{ img | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', width: 52, height: 64 }}</button>
          {%- endfor -%}
        </div></div>
    </div>
  </section>
  {%- endif -%}
  <section class="ga-day" aria-labelledby="ga-day-{{ section.id }}">
    <div class="ga-day__scene ga-reveal ga-drift">
      <img src="{{ 'guillo-off-duty.jpg' | asset_url }}" alt="Pale blue fitted tee with white trousers and a leather weekend bag" width="900" height="1600" loading="lazy">
      <video muted playsinline loop preload="none" data-src="{{ 'guillo-off-duty.mp4' | asset_url }}" aria-hidden="true" tabindex="-1"></video>
      <button type="button" class="ga-film-control" aria-label="Pause outfit film" hidden>Pause film <span aria-hidden="true">Ⅱ</span></button>
      <span class="ga-day__stamp">The off-duty edit / Guillo</span>
    </div>
    <div class="ga-day__copy ga-reveal">
      <p class="ga-kicker">The off-duty edit</p>
      <h2 id="ga-day-{{ section.id }}">No fixed<br>itinerary.</h2>
      <p>Pale blue. White trousers. One bag.<br>Leave the rest behind.</p>
      <div class="ga-day__detail"><img src="{{ 'guillo-villa-step.jpg' | asset_url }}" alt="Guillo pale blue tee and white trousers worn on the villa steps" width="900" height="1600" loading="lazy"><p>Pale blue &amp; white<br><span>A lighter way to dress.</span></p></div>
      <div class="ga-day__links"><a class="ga-link" href="{{ routes.collections_url }}/t-shirts">Explore the tees ↗</a><a class="ga-link" href="{{ routes.collections_url }}/pants">Find your trousers ↗</a></div>
    </div>
  </section>
  <section class="ga-fit ga-reveal" aria-labelledby="ga-fit-{{ section.id }}">
    <p class="ga-kicker">The Guillo difference</p><h2 id="ga-fit-{{ section.id }}">Fitted shirts.<br>Considered trousers.</h2>
    <div class="ga-fit__notes"><p><span>Shirts</span>Fitted through chest and arms.</p><p><span>Luxe</span>Slim through the leg.</p><p><span>Signore</span>Classic fit. Side-tab waist.</p></div>
    <a class="ga-link" href="/pages/fit-guide">Find your Guillo fit <span aria-hidden="true">↗</span></a>
  </section>
</guillo-atelier>
<script src="{{ 'guillo-atelier.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Guillo editorial wardrobe",
  "settings": [
    {
      "type": "product",
      "id": "signature_product",
      "label": "Signore feature product"
    },
    {
      "type": "text",
      "id": "signature_colour",
      "label": "Feature colour",
      "default": "Latte"
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "category",
      "name": "Collection image",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Category name"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product image source"
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Fallback image asset"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guillo editorial wardrobe",
      "category": "Guillo"
    }
  ]
}
{% endschema %}
