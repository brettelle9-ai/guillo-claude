{{ 'guillo-atelier.css' | asset_url | stylesheet_tag }}
<guillo-atelier class="ga">
  <div class="ga-intro ga-reveal">
    <p class="ga-kicker">The Guillo wardrobe</p>
    <h2>Character in the cut.<br><em>Confidence in the wearing.</em></h2>
    <p>Mediterranean ease. A closer fit. Pieces chosen for the way you want to show up.</p>
  </div>
  <nav class="ga-categories" aria-label="Explore the Guillo wardrobe">
    <a href="{{ routes.collections_url }}/shirts"><span>01</span> Shirts <span aria-hidden="true">↗</span></a>
    <a href="{{ routes.collections_url }}/chinos"><span>02</span> Chinos <span aria-hidden="true">↗</span></a>
    <a href="{{ routes.collections_url }}/polos"><span>03</span> Polos <span aria-hidden="true">↗</span></a>
    <a href="{{ routes.collections_url }}/t-shirts"><span>04</span> Tees <span aria-hidden="true">↗</span></a>
  </nav>
  <section class="ga-gallery" aria-labelledby="ga-selection-{{ section.id }}">
    <header class="ga-heading ga-reveal"><div><p class="ga-kicker">Selected for a reason</p><h2 id="ga-selection-{{ section.id }}">The signature pieces.</h2></div><a class="ga-link" href="{{ section.settings.collection.url }}">Explore the collection <span aria-hidden="true">↗</span></a></header>
    <div class="ga-gallery__grid">
      {%- for block in section.blocks -%}
        {% render 'guillo-gallery-card', block: block, index: forloop.index %}
      {%- endfor -%}
    </div>
    <p class="ga-gallery__foot">A considered wardrobe. An unmistakable point of view.</p>
  </section>
  {%- assign signature = section.settings.signature_product -%}
  {%- if signature != blank -%}
  <section class="ga-signature" aria-labelledby="ga-signore-{{ section.id }}">
    <div class="ga-signature__word" aria-hidden="true">SIGNORE</div>
    <div class="ga-signature__copy ga-reveal">
      <p class="ga-kicker">In focus / The Signore</p>
      <h2 id="ga-signore-{{ section.id }}">A different<br>kind of <em>formal.</em></h2>
      <p>A clean front. A little more ease through the leg. The Signore brings character to the everyday trouser.</p>
      <a class="ga-link" href="{{ signature.url }}">Discover the Signore <span aria-hidden="true">↗</span></a>
      <span class="ga-signature__price">{{ signature.price | money }} <span>/ {{ section.settings.signature_colour | escape }}</span></span>
    </div>
    <div class="ga-signature__visual ga-reveal">
      <div class="ga-signature__photos">
        {%- for img in signature.images limit: 3 -%}
          <div class="ga-signature__frame{% if forloop.first %} is-current{% endif %}" data-view="{{ forloop.index0 }}">
            {{ img | image_url: width: 1200 | image_tag: widths: '480, 750, 1000, 1200', sizes: '(min-width: 990px) 45vw, 100vw', loading: 'lazy', alt: img.alt }}
          </div>
        {%- endfor -%}
      </div>
      <div class="ga-view-controls" hidden><span>Explore the piece</span><div>
        {%- for img in signature.images limit: 3 -%}
          <button type="button" data-view-button="{{ forloop.index0 }}" aria-label="Signore view {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">0{{ forloop.index }}</button>
        {%- endfor -%}
      </div></div>
    </div>
  </section>
  {%- endif -%}
  <section class="ga-day" aria-labelledby="ga-day-{{ section.id }}">
    <div class="ga-day__scene ga-reveal">
      <img src="{{ 'guillo-off-duty.jpg' | asset_url }}" alt="Pale blue fitted tee with white trousers and a leather weekend bag" width="900" height="1600" loading="lazy">
      <video muted playsinline loop preload="none" data-src="{{ 'guillo-off-duty.mp4' | asset_url }}" aria-hidden="true" tabindex="-1"></video>
      <button type="button" class="ga-film-control" aria-label="Pause outfit film" hidden>Pause film <span aria-hidden="true">Ⅱ</span></button>
      <span class="ga-day__stamp">The off-duty edit / Guillo</span>
    </div>
    <div class="ga-day__copy ga-reveal">
      <p class="ga-kicker">Life, on your terms</p>
      <h2 id="ga-day-{{ section.id }}">No fixed<br><em>itinerary.</em></h2>
      <p>Early coffee. A long lunch. A few days away.<br>A wardrobe that goes with you.</p>
      <div class="ga-day__detail"><img src="{{ 'guillo-villa-step.jpg' | asset_url }}" alt="Guillo pale blue tee and white trousers worn on the villa steps" width="900" height="1600" loading="lazy"><p>01 / Pale blue &amp; chalk<br><span>A lighter way to dress.</span></p></div>
      <div class="ga-day__links"><a class="ga-link" href="{{ routes.collections_url }}/t-shirts">Explore the tees ↗</a><a class="ga-link" href="{{ routes.collections_url }}/pants">Find your trousers ↗</a></div>
    </div>
  </section>
  <section class="ga-fit ga-reveal" aria-labelledby="ga-fit-{{ section.id }}">
    <p class="ga-kicker">The Guillo difference</p><h2 id="ga-fit-{{ section.id }}">The fit changes<br><em>the feeling.</em></h2>
    <div class="ga-fit__notes"><p><span>01 / Shape</span>Cut to follow the body.</p><p><span>02 / Balance</span>Room where you need it.</p><p><span>03 / Character</span>Details that make the piece.</p></div>
    <a class="ga-link" href="/pages/fit-guide">Find your Guillo fit <span aria-hidden="true">↗</span></a>
  </section>
</guillo-atelier>
<script src="{{ 'guillo-atelier.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Guillo editorial wardrobe",
  "settings": [
    {"type":"collection","id":"collection","label":"Full collection"},
    {"type":"product","id":"signature_product","label":"Signore feature product"},
    {"type":"text","id":"signature_colour","label":"Feature colour","default":"Latte"}
  ],
  "max_blocks":4,
  "blocks":[{"type":"piece","name":"Signature piece","settings":[
    {"type":"product","id":"product","label":"Product"},
    {"type":"text","id":"note","label":"Small heading"},
    {"type":"text","id":"colour","label":"Colour or style"},
    {"type":"text","id":"description","label":"Caption"}
  ]}],
  "presets":[{"name":"Guillo editorial wardrobe","category":"Guillo"}]
}
{% endschema %}
