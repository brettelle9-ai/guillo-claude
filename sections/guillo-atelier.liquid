{{ 'guillo-atelier.css' | asset_url | stylesheet_tag }}
{%- assign signature = section.settings.signature_product -%}
<guillo-atelier class="ga">
  {%- assign trust_reviews = shop.metafields.judgeme.reviews_grid.value -%}
  <section class="ga-trust" aria-label="Guillo customer care">
    <div class="ga-trust__track">
      {%- for repeat in (1..2) -%}
      <div class="ga-trust__group"{% if repeat == 2 %} aria-hidden="true"{% endif %}>
        {%- if trust_reviews.number_of_reviews > 0 -%}<span>Rated {{ trust_reviews.average_rating }}/5 · {{ trust_reviews.number_of_reviews }} customer reviews</span>{%- endif -%}
        <span>{{ section.settings.trust_returns | escape }}</span>
        <span>{{ section.settings.trust_shipping | escape }}</span>
      </div>
      {%- endfor -%}
    </div>
  </section>

  <section class="ga-gallery" aria-label="Shop by category">
    <div class="ga-gallery__grid">{%- for block in section.blocks -%}{% render 'guillo-category-card', block: block %}{%- endfor -%}</div>
  </section>
  <section class="ga-banner ga-scene" aria-labelledby="ga-banner-{{ section.id }}">
    <img class="ga-banner__image" src="{{ 'guillo-shirt-campaign-wide.jpg' | asset_url }}" width="1920" height="1080" loading="lazy" alt="Guillo fitted blue shirt at the villa colonnade">
    <div class="ga-banner__copy"><p class="ga-kicker">Guillo shirts</p><h2 id="ga-banner-{{ section.id }}">The shirt collection.</h2><a class="ga-banner__link" href="{{ collections['shirts'].url | default: '/collections/shirts' }}">Shop shirts</a></div>
  </section>
  {%- if signature != blank -%}
  <section class="ga-signature" aria-labelledby="ga-signore-{{ section.id }}">
    <div class="ga-signature__stage">
      <div class="ga-signature__copy"><p class="ga-kicker">The Guillo cut</p><h2 id="ga-signore-{{ section.id }}">The Signore.</h2>
        <div class="ga-signature__chapters">
          <div class="ga-signature__chapter is-current" data-chapter="0"><h3>The silhouette.</h3><p>A classic cut with a little more room through the leg.</p></div>
          <div class="ga-signature__chapter" data-chapter="1"><h3>The waist.</h3><p>Adjust the side tabs. Keep the front clean.</p></div>
          <div class="ga-signature__chapter" data-chapter="2"><h3>The complete line.</h3><p>Defined at the waist. Considered all the way down.</p></div>
        </div>
        <div class="ga-signature__shopping"><a class="ga-link" href="{{ signature.url }}">Shop the Signore <span aria-hidden="true">↗</span></a><span>{{ signature.price | money }} / Latte</span></div>
        <p class="ga-signature__guide">Scroll to explore <span aria-hidden="true">↓</span></p>
      </div>
      <div class="ga-signature__visual"><div class="ga-signature__photos">
        {%- for img in signature.images limit: 3 -%}
        <div class="ga-signature__frame{% if forloop.first %} ga-signature__frame--film is-current{% endif %}" data-view="{{ forloop.index0 }}">
          {%- if forloop.first -%}
            <img src="{{ 'guillo-signore-raised-foot.jpg' | asset_url }}" width="720" height="1280" loading="lazy" alt="Signore trousers worn with one foot raised beside the pool">
            <video data-signore-film data-src="{{ 'guillo-signore-raised-foot.mp4' | asset_url }}" muted loop playsinline preload="none" tabindex="-1" aria-hidden="true"></video>
          {%- else -%}
            {{ img | image_url: width: 1200 | image_tag: widths: '480, 750, 1000, 1200', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: 'The Signore in Latte' }}
          {%- endif -%}
        </div>
        {%- endfor -%}
      </div><div class="ga-signature__steps" aria-label="Explore the Signore views"><button type="button" data-view-button="0" aria-pressed="true">Silhouette</button><button type="button" data-view-button="1" aria-pressed="false">Waist</button><button type="button" data-view-button="2" aria-pressed="false">Full view</button></div></div>
    </div>
  </section>{%- endif -%}
</guillo-atelier>
<script src="{{ 'guillo-atelier.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Guillo editorial wardrobe",
  "settings": [
    {"type":"text","id":"trust_returns","label":"Trust banner returns message","default":"44-day free returns & exchanges · AU & NZ"},
    {"type":"text","id":"trust_shipping","label":"Trust banner shipping message","default":"Free express shipping over $200"},
    {
      "type": "product",
      "id": "signature_product",
      "label": "Signore feature product"
    },
    {
      "type": "text",
      "id": "signature_colour",
      "label": "Feature colour",
      "default": "Latte"
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "category",
      "name": "Collection image",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Category name"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product image source"
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Fallback image asset"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guillo editorial wardrobe",
      "category": "Guillo"
    }
  ]
}
{% endschema %}
