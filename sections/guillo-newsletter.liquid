{% comment %}
  White newsletter section with a working customer
  email signup form.
{% endcomment %}

<section class="guillo-newsletter g-pad" aria-labelledby="GuilloNewsletterHeading-{{ section.id }}">
  <div class="guillo-newsletter__inner">
    <div class="guillo-newsletter__copy">
      {%- if section.settings.eyebrow != blank -%}<span class="g-eyebrow guillo-newsletter__eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2 id="GuilloNewsletterHeading-{{ section.id }}" class="guillo-newsletter__heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="guillo-newsletter__text">{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    {% form 'customer', class: 'guillo-newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="guillo-newsletter__success" role="status">Thanks. You are on the list.</p>
      {%- else -%}
        <label for="GuilloNewsletterEmail-{{ section.id }}" class="guillo-newsletter__label">Email address</label>
        <div class="guillo-newsletter__row">
          <input id="GuilloNewsletterEmail-{{ section.id }}" type="email" name="contact[email]" class="guillo-newsletter__input" placeholder="Your email address" required autocomplete="email" {% if form.errors %}aria-invalid="true" aria-describedby="GuilloNewsletterError-{{ section.id }}"{% endif %}>
          <button type="submit" class="guillo-newsletter__submit">{{ section.settings.button_label | default: 'Join the list' | escape }} <span aria-hidden="true">↗</span></button>
        </div>
        {%- if form.errors -%}<p class="guillo-newsletter__error" id="GuilloNewsletterError-{{ section.id }}" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
      {%- endif -%}
    {% endform %}
  </div>
</section>
{% stylesheet %}
  .guillo-newsletter{padding-block:65px;background:#fff;color:#111212;border-top:1px solid #dedfe1}
  .guillo-newsletter__inner{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:8vw;max-width:1280px;margin-inline:auto;text-align:left}
  .guillo-newsletter__eyebrow{display:block;color:#555c60;font-size:10px;letter-spacing:.16em;margin-bottom:16px}
  .guillo-newsletter__heading{font:400 clamp(30px,3vw,44px)/1.15 var(--g-sans);letter-spacing:-.035em;color:#111212;margin:0 0 18px}
  .guillo-newsletter__text{font:400 14px/1.7 var(--g-sans);color:#4c545b;margin:0;max-width:440px}
  .guillo-newsletter__form{width:100%;margin:0}
  .guillo-newsletter__label{display:block;font:400 12px/1.4 var(--g-sans);color:#111212;margin-bottom:10px}
  .guillo-newsletter__row{display:flex;gap:10px;align-items:stretch}
  input.guillo-newsletter__input{box-sizing:border-box;min-width:0;width:100%;flex:1;min-height:56px;height:56px;padding:0 16px;background:#fff!important;border:1px solid #7e878d;box-shadow:none!important;color:#111212;font:400 14px/1 var(--g-sans);border-radius:0}
  input.guillo-newsletter__input::placeholder{color:#616b73;opacity:1}
  input.guillo-newsletter__input:focus-visible{outline:2px solid #1c5271;outline-offset:3px}
  .guillo-newsletter__submit{display:flex;align-items:center;justify-content:center;gap:18px;min-width:125px;min-height:56px;padding:0 18px;background:#111212;color:#fff;border:1px solid #111212;font:400 10px/1.3 var(--g-sans);letter-spacing:.08em;text-transform:uppercase;cursor:pointer;transition:background .25s}
  .guillo-newsletter__submit:hover{background:#233e4b}.guillo-newsletter__submit:focus-visible{outline:2px solid #1c5271;outline-offset:3px}.guillo-newsletter__submit span{font-size:19px}
  .guillo-newsletter__success,.guillo-newsletter__error{font:400 14px/1.6 var(--g-sans);color:#111212;margin:12px 0 0}.guillo-newsletter__error{color:#9c2222}
  @media(max-width:749px){.guillo-newsletter{padding-block:45px}.guillo-newsletter__inner{grid-template-columns:1fr;gap:28px}.guillo-newsletter__heading{font-size:32px;margin-bottom:15px}.guillo-newsletter__text{font-size:14px}.guillo-newsletter__submit{min-width:112px;padding-inline:12px;gap:10px}}
{% endstylesheet %}

{% schema %}
{
  "name": "Guillo newsletter",
    "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The list" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "First look at the drop, before it goes public." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Restocks, new colourways and the occasional fit note. Nothing else." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join" }
  ],
  "presets": [
    { "name": "Guillo newsletter", "category": "Guillo" }
  ]
}
{% endschema %}
