      "label": "Side paragraph",
      "default": "Wrinkle-resistant twill that comes out of a case looking like it came off a hanger. Pack two chinos and a shirt and the whole trip is covered."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Wide image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Wide image alt text"
