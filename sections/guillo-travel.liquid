{% comment %}
  "Made to travel" editorial: heading row with side paragraph, a cinematic
  21/9 image with a caption chip, then three destination story columns.
{% endcomment %}

<section class="guillo-travel">
  <div class="guillo-travel__inner">
    <div class="guillo-travel__head g-pad">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="g-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="guillo-travel__heading">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.text != blank -%}
        <p class="guillo-travel__intro">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    {%- comment -%}
      With a link set the whole image is the target and the chip is styled as
      the button inside it - one anchor rather than a link inside a link,
      which is invalid and would swallow the outer click.
    {%- endcomment -%}
    {%- capture wide_inner -%}
      {% render 'guillo-img',
        image: section.settings.image,
        fallback: section.settings.fallback_asset,
        alt: section.settings.image_alt,
        class: 'guillo-travel__wide-img',
        sizes: '100vw',
        position: section.settings.image_position,
        placeholder: 'Wide establishing shot, no model'
      %}
      {%- if section.settings.image_label != blank -%}
        <span class="guillo-travel__chip{% if section.settings.image_link != blank %} guillo-travel__chip--button{% endif %}">
          {{- section.settings.image_label -}}
          {%- if section.settings.image_link != blank -%}
            <span class="guillo-travel__chip-arrow" aria-hidden="true">&#8594;</span>
          {%- endif -%}
        </span>
      {%- endif -%}
    {%- endcapture -%}
    {%- if section.settings.image_link != blank -%}
      <a class="guillo-travel__wide guillo-travel__wide--link" href="{{ section.settings.image_link }}">
        {{ wide_inner }}
      </a>
    {%- else -%}
      <div class="guillo-travel__wide">{{ wide_inner }}</div>
    {%- endif -%}

    <div class="guillo-travel__cols">
      {%- for block in section.blocks -%}
        <div class="guillo-travel__col" {{ block.shopify_attributes }}>
          <div class="guillo-travel__col-media">
            {% render 'guillo-img',
              image: block.settings.image,
              fallback: block.settings.fallback_asset,
              alt: block.settings.title,
              class: 'guillo-travel__col-img',
              sizes: '(min-width: 750px) 33vw, 100vw',
              position: block.settings.image_position,
              placeholder: block.settings.slot_brief
            %}
          </div>
          <div class="guillo-travel__col-body">
            <div class="guillo-travel__place">{{ block.settings.place }}</div>
            <div class="guillo-travel__title">{{ block.settings.title }}</div>
            <p class="guillo-travel__copy">{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .guillo-travel__wide--link {
    display: block;
    text-decoration: none;
    cursor: pointer;
  }
  .guillo-travel__chip--button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--g-paper);
    color: var(--g-ink);
    transition: background 0.2s ease, color 0.2s ease;
  }
  .guillo-travel__chip-arrow { transition: transform 0.2s ease; }
  .guillo-travel__wide--link:hover .guillo-travel__chip--button {
    background: var(--g-ink);
    color: var(--g-off);
  }
  .guillo-travel__wide--link:hover .guillo-travel__chip-arrow { transform: translateX(3px); }
  .guillo-travel__wide--link:focus-visible { outline: 2px solid var(--g-ink); outline-offset: 3px; }
  /* Full bleed: only the heading block keeps a gutter, the media runs to the
     screen edges, and captions are inset so no text sits on the edge. */
  .guillo-travel__inner { max-width: none; }
  .guillo-travel__col-body { padding-inline: 20px; }
  .guillo-travel {
    padding-block: 104px 96px;
    background: var(--g-grey);
  }
  .guillo-travel__head {
    display: grid;
    grid-template-columns: 1fr 380px;
    align-items: end;
    gap: 60px;
    margin-bottom: 48px;
  }
  .guillo-travel__head .g-eyebrow {
    display: block;
    margin-bottom: 18px;
  }
  .guillo-travel__heading {
    font: 500 clamp(32px, 3.4vw, 52px)/1.04 var(--g-serif);
    letter-spacing: -0.004em;
    margin: 0;
    max-width: 820px;
  }
  .guillo-travel__intro {
    font: 300 16px/1.75 var(--g-sans);
    color: var(--g-muted);
    margin: 0;
  }
  .guillo-travel__wide {
    position: relative;
    aspect-ratio: 21 / 9;
    background: #E4E5E9;
    margin-bottom: 2px;
    overflow: hidden;
  }
  .guillo-travel__wide-img,
  .guillo-travel__wide svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .guillo-travel__chip {
    position: absolute;
    left: 44px;
    bottom: 40px;
    background: rgb(23 24 27 / 0.82);
    color: #fff;
    font: 400 13px/1.5 var(--g-serif);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 12px 18px;
  }
  .guillo-travel__cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
  }
  .guillo-travel__col-media {
    position: relative;
    aspect-ratio: 4 / 5;
    background: #E4E5E9;
    overflow: hidden;
  }
  .guillo-travel__col-img,
  .guillo-travel__col-media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .guillo-travel__col-body { padding: 20px 4px 0; }
  .guillo-travel__place {
    font: 500 10px/1 var(--g-sans);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--g-bronze);
    margin-bottom: 12px;
  }
  .guillo-travel__title {
    font: 500 21px/1.25 var(--g-serif);
    margin-bottom: 10px;
  }
  .guillo-travel__copy {
    font: 300 14px/1.75 var(--g-sans);
    color: var(--g-muted);
    margin: 0;
  }
  @media screen and (max-width: 989px) {
    .guillo-travel { padding-block: 64px 56px; }
    .guillo-travel__head {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 30px;
    }
    .guillo-travel__cols { grid-template-columns: 1fr; gap: 34px; }
    .guillo-travel__chip { left: 20px; bottom: 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Guillo travel editorial",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Made to travel"
    },
    {
