        },
        {
          "type": "text",
          "id": "place",
          "label": "Place",
          "default": "Positano"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Lunch that runs into evening"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "The Bone chino with the Amalfi shirt. Light enough for the heat, clean enough for the table."
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Guillo travel editorial",
      "category": "Guillo",
      "blocks": [
        {
          "type": "story",
          "settings": {
            "place": "Positano",
            "title": "Lunch that runs into evening",
            "text": "The Bone chino with the Amalfi shirt. Light enough for the heat, clean enough for the table."
          }
