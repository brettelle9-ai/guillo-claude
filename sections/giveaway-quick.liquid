{%- render 'giveaway-head' -%}
<section class="gv gv-quick" id="quick-enter" data-gv-quick>
  <div class="gv-quick__inner">
    <div class="gv-quick__copy">
      <div class="gv-script">{{ section.settings.script }}</div>
      <p>{{ section.settings.text }}</p>
    </div>
    <form class="gv-quick__form" data-gv-quick-form novalidate>
      <input name="first_name" autocomplete="given-name" placeholder="First name" aria-label="First name">
      <input name="email" type="email" autocomplete="email" placeholder="Email" aria-label="Email">
      <button type="submit">{{ section.settings.button }}</button>
    </form>
    <div class="gv-quick__err" data-gv-quick-err hidden></div>
    <p class="gv-quick__fine">{{ section.settings.fine }}</p>
  </div>
</section>
{%- if section.settings.sticky -%}
<a class="gv-sticky" href="#enter" data-gv-sticky aria-hidden="true">
  <span>{{ section.settings.sticky_left }}</span><b>{{ section.settings.sticky_button }}</b>
</a>
{%- endif -%}
<style>
/* Hide sitewide popups on the giveaway page so nothing competes with entering */
{%- if section.settings.hide_popups -%}
.om-holder,[id^="om-holder"],[id^="om-overlay"]{display:none!important}
{%- endif -%}
#quick-enter{background:#F6F1E7;color:#1F1C19;padding:34px 24px 30px;border-bottom:1px solid #E3DACC}
#quick-enter .gv-quick__inner{max-width:980px;margin:0 auto;display:grid;grid-template-columns:1fr 1.6fr;gap:10px 40px;align-items:center}
#quick-enter .gv-script{font-size:40px;line-height:1;color:#8A6A45}
#quick-enter .gv-quick__copy p{margin:6px 0 0;font-family:var(--gv-serif);font-size:19px;line-height:1.35;color:#5E5347}
#quick-enter .gv-quick__form{display:grid;grid-template-columns:1fr 1.4fr auto;gap:10px}
#quick-enter input{height:52px;border:1px solid rgba(110,94,76,.45);background:#FBF7F0;padding:0 16px;font-family:'Jost',sans-serif;font-size:15px;color:#1F1C19;border-radius:0;outline:none;width:100%;box-sizing:border-box;-webkit-appearance:none}
#quick-enter input:focus{border-color:#8A6A45}
#quick-enter button{height:52px;padding:0 26px;background:#1F1C19;color:#FBF7F0;border:0;font-family:'Jost',sans-serif;font-size:11px;letter-spacing:.24em;text-transform:uppercase;cursor:pointer;white-space:nowrap}
#quick-enter button:disabled{opacity:.6}
#quick-enter .gv-quick__err{grid-column:2;color:#9A4B2E;font-family:'Jost',sans-serif;font-size:13px}
#quick-enter .gv-quick__fine{grid-column:2;margin:0;font-family:'Jost',sans-serif;font-size:11px;letter-spacing:.04em;color:#8C7D6B}
.gv-sticky{position:fixed;left:12px;right:12px;bottom:12px;z-index:60;display:none;align-items:center;justify-content:space-between;gap:12px;padding:10px 10px 10px 18px;background:#1F1C19;color:#FBF7F0!important;text-decoration:none!important;box-shadow:0 10px 30px rgba(0,0,0,.25);transform:translateY(140%);transition:transform .35s ease}
.gv-sticky span{font-family:var(--gv-serif,'Cormorant Garamond',serif);font-size:17px;line-height:1.1}
.gv-sticky b{background:#FBF7F0;color:#1F1C19;font-family:'Jost',sans-serif;font-weight:500;font-size:10px;letter-spacing:.22em;text-transform:uppercase;padding:12px 14px;white-space:nowrap}
.gv-sticky.is-on{transform:translateY(0)}
@media (max-width:820px){
  #quick-enter{padding:28px 18px 24px}
  #quick-enter .gv-quick__inner{grid-template-columns:1fr;text-align:center}
  #quick-enter .gv-quick__form{grid-template-columns:1fr}
  #quick-enter .gv-quick__err,#quick-enter .gv-quick__fine{grid-column:1}
  #quick-enter .gv-script{font-size:36px}
  #quick-enter .gv-quick__copy p{font-size:17px}
  .gv-sticky{display:flex}
}
</style>
<script>
(function(){
  var q = document.querySelector('[data-gv-quick]'); if (!q || q.__gv) return; q.__gv = true;
  var KEY = 'gvSummerDraw2026';
  var form = q.querySelector('[data-gv-quick-form]'), err = q.querySelector('[data-gv-quick-err]'), btn = form.querySelector('button');
  var sticky = document.querySelector('[data-gv-sticky]');
  function entered(){ try { var s = JSON.parse(localStorage.getItem(KEY) || 'null'); return !!(s && s.email); } catch(e){ return false; } }
  function hideAll(){ q.style.display = 'none'; if (sticky) sticky.style.display = 'none'; }
  if (entered()) hideAll();
  form.addEventListener('input', function(){ err.hidden = true; });
  form.addEventListener('submit', function(e){
    e.preventDefault();
    var name = form.first_name.value.trim(), email = form.email.value.trim();
    if (!name) { err.textContent = 'Add your first name.'; err.hidden = false; return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { err.textContent = 'That email does not look quite right.'; err.hidden = false; return; }
    var main = document.querySelector('[data-gv-form]');
    if (!main) return;
    main.first_name.value = name; main.email.value = email;
    btn.disabled = true;
    var done = document.querySelector('[data-gv-done]');
    var mo = new MutationObserver(function(){ if (!done.hidden) { mo.disconnect(); hideAll(); document.getElementById('enter').scrollIntoView({behavior:'smooth', block:'start'}); } });
    if (done) mo.observe(done, { attributes: true, attributeFilter: ['hidden'] });
    var mainErr = document.querySelector('[data-gv-error]');
    var eo = mainErr && new MutationObserver(function(){ if (!mainErr.hidden) { btn.disabled = false; err.textContent = mainErr.textContent; err.hidden = false; } });
    if (eo) eo.observe(mainErr, { attributes: true, attributeFilter: ['hidden'], childList: true });
    if (main.requestSubmit) main.requestSubmit(); else main.dispatchEvent(new Event('submit', { cancelable: true }));
  });
  if (sticky) {
    var heroOut = false, enterIn = false, quickIn = false;
    function vis(el){ if (!el) return false; var r = el.getBoundingClientRect(); return r.bottom > 0 && r.top < innerHeight; }
    function upd(){ var enter = document.getElementById('enter'), hero = document.querySelector('.gv-hero'); heroOut = hero ? hero.getBoundingClientRect().bottom < 0 : true; enterIn = vis(enter); quickIn = q.style.display !== 'none' && vis(q); sticky.classList.toggle('is-on', heroOut && !enterIn && !quickIn && !entered()); }
    addEventListener('scroll', upd, { passive: true }); addEventListener('resize', upd); addEventListener('load', upd); upd();
  }
})();
</script>
{% schema %}
{
  "name": "Giveaway: quick entry",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "script", "label": "Script line", "default": "enter in seconds" },
    { "type": "text", "id": "text", "label": "Text", "default": "Your name and email puts you in the draw, and your $20 off is yours straight away." },
    { "type": "text", "id": "button", "label": "Button", "default": "Enter the draw" },
    { "type": "text", "id": "fine", "label": "Fine print", "default": "Australian residents 18 and over. One entry per person. Full terms below." },
    { "type": "checkbox", "id": "sticky", "label": "Show sticky enter bar on mobile", "default": true },
    { "type": "text", "id": "sticky_left", "label": "Sticky bar text", "default": "Win the summer wardrobe" },
    { "type": "text", "id": "sticky_button", "label": "Sticky bar button", "default": "Enter" },
    { "type": "checkbox", "id": "hide_popups", "label": "Hide sitewide popups on this page", "default": true }
  ],
  "presets": [{ "name": "Giveaway: quick entry" }]
}
{% endschema %}
