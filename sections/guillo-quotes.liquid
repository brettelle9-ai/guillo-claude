{% comment %}
  Customer quote strip, led by the store's own Judge.me rating.

  Every quote is a real Judge.me review from the shop-level
  judgeme.reviews_grid metafield. There are no hand-typed fallbacks. The
  selection aims for one review each on fit, appearance and service, then
  fills with the best rated; duplicates are dropped, since Judge.me's own
  data repeats some.
{% endcomment %}

{%- liquid
  assign grid = shop.metafields.judgeme.reviews_grid.value
  assign store_rating = grid.average_rating
  assign store_count = grid.number_of_reviews
  assign to_show = section.settings.quotes_to_show | default: 3
  assign min_rating = section.settings.min_rating | default: 4

  # Pool every review Judge.me publishes to the shop metafield: store
  # reviews first (about Guillo as a whole), then featured, then the rest.
  assign pool = '' | split: ''
  if grid.store_reviews.reviews != blank
    assign pool = pool | concat: grid.store_reviews.reviews
  endif
  if grid.featured_reviews.reviews != blank
    assign pool = pool | concat: grid.featured_reviews.reviews
  endif
  if grid.all_reviews.reviews != blank
    assign pool = pool | concat: grid.all_reviews.reviews
  endif

  # Aim for one review per theme so the strip reads as fit, looks and
  # service rather than three variations on one point. Themes are matched
  # on words in the review text (editable in the section settings); a theme
  # with no match simply gives its slot to the next best-rated review.
  # Nothing here invents a review: every card is a real Judge.me entry.
  assign theme_lists = section.settings.theme_fit | append: '|' | append: section.settings.theme_look | append: '|' | append: section.settings.theme_service | split: '|'
  assign picks = ''
  assign seen = ''

  for theme in theme_lists
    assign words = theme | downcase | split: ','
    for r in pool
      assign body = r.body_html | default: r.body | strip_html | strip
      if body == blank or r.rating < min_rating
        continue
      endif
      capture key
        echo ',' | append: body | truncate: 40, '' | handleize | append: ','
      endcapture
      if seen contains key
        continue
      endif
      assign body_dc = body | downcase
      if body_dc contains 'payday' or body_dc contains 'not widely known' or body_dc contains 'fabric' or body_dc contains 'stretch' or body_dc contains 'material'
        continue
      endif
      assign hit = false
      for w in words
        assign ws = w | strip
        if ws != blank and body_dc contains ws
          assign hit = true
          break
        endif
      endfor
      if hit
        assign seen = seen | append: key
        assign picks = picks | append: forloop.index0 | append: ','
        break
      endif
    endfor
  endfor

  # Fill any remaining slots, best rated first, skipping repeats.
  assign picked_count = picks | split: ',' | size
  if picked_count < to_show
    for star in (min_rating..5) reversed
      for r in pool
        if picked_count >= to_show
          break
        endif
        if r.rating != star
          continue
        endif
        assign body = r.body_html | default: r.body | strip_html | strip
        if body == blank
          continue
        endif
        assign body_dc = body | downcase
        if body_dc contains 'fabric' or body_dc contains 'stretch' or body_dc contains 'material' or body_dc contains 'payday' or body_dc contains 'not widely known'
          continue
        endif
        capture key
          echo ',' | append: body | truncate: 40, '' | handleize | append: ','
        endcapture
        if seen contains key
          continue
        endif
        assign seen = seen | append: key
        assign picks = picks | append: forloop.index0 | append: ','
        assign picked_count = picked_count | plus: 1
      endfor
    endfor
  endif
  assign pick_list = picks | split: ','
-%}

<section class="guillo-quotes g-pad">
  <div class="g-container">
    {%- if store_count != blank and store_count > 0 -%}
      <div class="guillo-quotes__lead">
        <span class="guillo-quotes__lead-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span class="guillo-quotes__lead-score">{{ store_rating }}</span>
        <span class="guillo-quotes__lead-count">from {{ store_count }} reviews</span>
      </div>
    {%- endif -%}

    <div class="guillo-quotes__grid">
      {%- assign shown = 0 -%}
      {%- for pick in pick_list -%}
        {%- if shown >= to_show or pick == blank -%}{%- break -%}{%- endif -%}
        {%- assign idx = pick | plus: 0 -%}
        {%- assign r = pool[idx] -%}
        {%- assign body = r.body_html | default: r.body | strip_html | strip -%}
        {%- assign shown = shown | plus: 1 -%}
        <div class="guillo-quotes__cell">
          <div class="guillo-quotes__stars" aria-label="{{ r.rating }} star review">
            {%- for i in (1..5) -%}{%- if i <= r.rating -%}&#9733;{%- else -%}&#9734;{%- endif -%}{%- endfor -%}
          </div>
          {%- if r.title != blank -%}
            <div class="guillo-quotes__title">{{ r.title }}</div>
          {%- endif -%}
          <p class="guillo-quotes__quote">{{ body }}</p>
          <div class="guillo-quotes__who">
            {{ r.reviewer_name }}{% if r.verified_buyer %} &middot; Verified purchase{% endif %}
          </div>
        </div>
      {%- endfor -%}
    </div>
    <a class="g-link guillo-quotes__all" href="/pages/testimonials">Read customer reviews ↗</a>
  </div>
</section>

{% stylesheet %}
  .guillo-quotes__lead {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 12px;
    padding-bottom: 42px;
  }
  .guillo-quotes__lead-stars {
    font: 400 13px/1 var(--g-sans);
    letter-spacing: 0.3em;
    color: var(--g-ink);
  }
  .guillo-quotes__lead-score { font: 500 30px/1 var(--g-serif); color: var(--g-ink); }
  .guillo-quotes__lead-count {
    font: 300 12px/1 var(--g-sans);
    letter-spacing: 0.06em;
    color: var(--g-whisper);
  }
  .guillo-quotes__title {
    font: 500 14px/1.4 var(--g-serif);
    color: var(--g-ink);
    margin-bottom: 8px;
  }
  .guillo-quotes {
    padding-block: 92px;
    background: var(--g-paper);
    border-top: 1px solid var(--g-line);
  }
  .guillo-quotes__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--g-line);
  }
  .guillo-quotes__cell {
    background: var(--g-paper);
    padding: 6px 54px 10px;
  }
  .guillo-quotes__cell:first-child { padding-left: 0; }
  .guillo-quotes__cell:last-child { padding-right: 0; }
  .guillo-quotes__stars {
    font: 400 12px/1 var(--g-sans);
    letter-spacing: 0.3em;
    color: var(--g-ink);
    margin-bottom: 26px;
  }
  .guillo-quotes__quote {
    font: 300 15px/1.8 var(--g-sans);
    color: #5C6067;
    margin: 0 0 28px;
  }
  .guillo-quotes__who {
    font: 500 10px/1 var(--g-sans);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--g-faint);
  }
  @media screen and (max-width: 989px) {
    .guillo-quotes { padding-block: 56px; }
    .guillo-quotes__grid { grid-template-columns: 1fr; }
    .guillo-quotes__cell { padding: 32px 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Guillo quote strip",
  "settings": [
    { "type": "range", "id": "quotes_to_show", "label": "Reviews to show", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "min_rating", "label": "Minimum star rating", "min": 3, "max": 5, "step": 1, "default": 4 },
    { "type": "header", "content": "Balance" },
    { "type": "paragraph", "content": "The strip tries to show one review per theme, matched on these words in the review text. Comma separated. Only genuine Judge.me reviews are ever shown." },
    { "type": "text", "id": "theme_fit", "label": "Product and fit words", "default": "fit, fits, fitted, size, waist, thigh, leg, stretch, comfortable, comfy, cut, tailored, fabric, material" },
    { "type": "text", "id": "theme_look", "label": "Appearance words", "default": "look, looks, compliment, style, stylish, smart, sharp, design, colour, color, handsome, classy" },
    { "type": "text", "id": "theme_service", "label": "Service and delivery words", "default": "service, delivery, shipping, arrived, fast, quick, speedy, support, exchange, return, refund, website, easy, customer, communication, helpful" }
  ],
  "presets": [
    { "name": "Guillo quote strip", "category": "Guillo" }
  ]
}
{% endschema %}
