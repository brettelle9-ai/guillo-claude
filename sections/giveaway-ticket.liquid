{%- render 'giveaway-head' -%}
{%- if section.settings.map_image != blank -%}{%- capture gv_map -%}--gv-map:url({{ section.settings.map_image | image_url: width: 2400 }});background-image:var(--gv-map);background-position:{{ section.settings.map_position }}{%- endcapture -%}{%- endif -%}
<section class="gv gv-ticket" id="enter" style="--gv-palm-op:{{ section.settings.palm_opacity | divided_by: 100.0 }}">
  <div class="gv-ticket__wrap" style="{{ gv_map }}" data-gv-ticket
       data-list="{{ section.settings.klaviyo_list_id | escape }}"
       data-company="{{ section.settings.klaviyo_company_id | escape }}"
       data-code="{{ section.settings.code | escape }}">
    <div class="gv-ticket__main">
      {%- if section.settings.show_palms -%}<img class="gv-ticket__palm gv-ticket__palm--l" src="{{ 'giveaway-palm.svg' | asset_url }}" alt="" aria-hidden="true">{%- endif -%}
      <div class="gv-ticket__frame">
        <div class="gv-ticket__top"><span>Admit one</span><span>Nº <span data-gv-no>00000</span></span></div>

        <div data-gv-form-wrap>
          <div class="gv-ticket__title">
            <div class="gv-script">{{ section.settings.script }}</div>
            <h2>{{ section.settings.heading }}</h2>
          </div>
          <div class="gv-ticket__strip">
            <div><span class="gv-label">{{ section.settings.cell1_label }}</span><span class="gv-serif">{{ section.settings.cell1_value }}</span></div>
            <div><span class="gv-label">{{ section.settings.cell2_label }}</span><span class="gv-serif">{{ section.settings.cell2_value }}</span></div>
            <div><span class="gv-label">{{ section.settings.cell3_label }}</span><span class="gv-serif">{{ section.settings.cell3_value }}</span></div>
          </div>
          <form class="gv-form" data-gv-form novalidate>
            <div class="gv-form__fields">
              <label><span>First name</span><input name="first_name" autocomplete="given-name" placeholder="Sam"></label>
              <label><span>Email</span><input name="email" type="email" autocomplete="email" placeholder="sam@email.com"></label>
            </div>
            <div class="gv-form__error" data-gv-error hidden></div>
            <button class="gv-form__submit" type="submit">{{ section.settings.button }}</button>
            <p class="gv-form__fine">{{ section.settings.fine }}</p>
          </form>
        </div>

        <div class="gv-done" data-gv-done hidden>
          <div class="gv-script">you're in</div>
          <h2><span data-gv-name></span>, here's your $20.</h2>
          <p>$20 off any order over $70, until Sunday 1 November. We've sent it to <span data-gv-email></span> too. Win on Monday 2 November and anything you bought during the giveaway is refunded.</p>
          <div class="gv-done__code"><strong>{{ section.settings.code }}</strong><button type="button" data-gv-copy>Copy</button></div>
          <a class="gv-btn" href="/discount/{{ section.settings.code | url_encode }}?redirect={{ section.settings.spend_path | default: '/collections' | url_encode }}">{{ section.settings.spend_label }}</a>
        </div>

        <div class="gv-closed" data-gv-closed hidden>
          <div class="gv-script">entries have closed</div>
          <p>{{ section.settings.closed_text }}</p>
        </div>
      </div>
    </div>
    <div class="gv-ticket__stub">
      <span class="gv-ticket__notch" style="top:-20px"></span>
      <span class="gv-ticket__notch" style="bottom:-20px"></span>
      {%- if section.settings.show_palms -%}<img class="gv-ticket__palm gv-ticket__palm--r" src="{{ 'giveaway-palm.svg' | asset_url }}" alt="" aria-hidden="true">{%- endif -%}
      <div>
        <span class="gv-label">Everyone who enters</span>
        <div class="gv-big">$20</div>
        <div class="gv-script">off any order over $70</div>
      </div>
      <div class="gv-ticket__codebox">
        <span class="gv-label">Your code</span>
        <div class="gv-ticket__code is-locked" data-gv-stubcode>{{ section.settings.code }}</div>
        <div class="gv-ticket__hint" data-gv-hint>Revealed when you enter</div>
        <div class="gv-ticket__count" data-gv-countdown></div>
      </div>
      <div class="gv-stamp" data-gv-stamp hidden>Entered</div>
    </div>
  </div>
</section>
<style>
/* Cream map ticket */
#enter{background:#fff}
#enter .gv-ticket__wrap{position:relative;background-color:#FBF7F0;background-size:cover;background-repeat:no-repeat;filter:drop-shadow(0 30px 50px rgba(60,45,30,.18))}
#enter .gv-ticket__wrap:before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse 60% 70% at 38% 55%,rgba(251,247,240,.72) 0%,rgba(251,247,240,.35) 55%,rgba(251,247,240,0) 85%);pointer-events:none}
#enter .gv-ticket__main,#enter .gv-ticket__stub{position:relative;background:transparent!important;color:#2B2622;overflow:hidden}
#enter .gv-ticket__frame{position:relative;z-index:1;border-color:rgba(110,94,76,.5);outline-color:rgba(110,94,76,.22)}
#enter .gv-ticket__top{color:#6E5E4C;border-bottom-color:rgba(110,94,76,.3)}
#enter .gv-ticket__title .gv-script,#enter .gv-done .gv-script,#enter .gv-closed .gv-script{color:#8A6A45}
#enter .gv-ticket__title h2,#enter .gv-done h2{color:#1F1C19}
#enter .gv-ticket__strip{border-color:rgba(110,94,76,.3)}
#enter .gv-ticket__strip>div+div{border-left-color:rgba(110,94,76,.25)}
#enter .gv-ticket__strip .gv-label,#enter .gv-form label span,#enter .gv-ticket__stub .gv-label{color:#8C7D6B}
#enter .gv-ticket__strip .gv-serif{color:#2B2622}
#enter .gv-form input{color:#1F1C19;border-bottom-color:rgba(110,94,76,.55)}
#enter .gv-form input:focus{border-bottom-color:#8A6A45}
#enter .gv-form input::placeholder{color:#A99B88}
#enter .gv-form__submit{background:#1F1C19;color:#FBF7F0}
#enter .gv-form__submit:hover{background:#000}
#enter .gv-form__fine{color:#8C7D6B}
#enter .gv-form__error{color:#9A4B2E}
#enter .gv-done p,#enter .gv-closed p{color:#5E5347}
#enter .gv-done__code strong{border-color:rgba(110,94,76,.6);color:#1F1C19}
#enter .gv-done__code button{border-color:rgba(110,94,76,.5);color:#2B2622}
#enter .gv-done__code button:hover{border-color:#2B2622}
#enter .gv-done .gv-btn{background:#1F1C19;border-color:#1F1C19;color:#FBF7F0!important}
#enter .gv-done .gv-btn:hover{background:#000;border-color:#000}
#enter .gv-ticket__stub{border-left-color:rgba(110,94,76,.45)!important}
#enter .gv-ticket__stub .gv-big{color:#1F1C19}
#enter .gv-ticket__stub .gv-script{color:#8A6A45}
#enter .gv-ticket__codebox{border-top-color:rgba(110,94,76,.3)}
#enter .gv-ticket__code{color:#1F1C19}
#enter .gv-ticket__hint{color:#8A6A45}
#enter .gv-ticket__count{color:#8C7D6B}
#enter .gv-stamp{border-color:#8A6A45;color:#8A6A45;z-index:2}
#enter .gv-ticket__stub>div{position:relative;z-index:1}
#enter .gv-ticket__notch{background:#fff;z-index:2}
#enter .gv-ticket__palm{position:absolute;bottom:-4px;height:min(62%,440px);width:auto;opacity:var(--gv-palm-op,.4);pointer-events:none;z-index:0}
#enter .gv-ticket__palm--l{left:-40px}
#enter .gv-ticket__palm--r{right:-60px;transform:scaleX(-1);height:min(55%,360px)}
@media (max-width:960px){#enter .gv-ticket__stub{border-top-color:rgba(110,94,76,.45)!important}}
@media (max-width:760px){
#enter{padding:56px 12px}
#enter .gv-ticket__wrap{background-image:none!important}
#enter .gv-ticket__wrap:before{display:none}
#enter .gv-ticket__main{padding:8px;background-image:var(--gv-map)!important;background-size:240% auto!important;background-position:30% 0!important;background-repeat:no-repeat!important}
#enter .gv-ticket__main:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(251,247,240,.15) 0%,rgba(251,247,240,.55) 34%,rgba(251,247,240,.92) 58%,#FBF7F0 80%);pointer-events:none;z-index:0}
#enter .gv-ticket__stub{background-image:var(--gv-map)!important;background-size:240% auto!important;background-position:78% 100%!important;background-repeat:no-repeat!important;padding:36px 26px 40px}
#enter .gv-ticket__stub:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(251,247,240,.2) 0%,rgba(251,247,240,.6) 45%,rgba(251,247,240,.9) 75%);pointer-events:none;z-index:0}
#enter .gv-ticket__frame{padding:26px 18px 30px}
#enter .gv-ticket__top span{letter-spacing:.24em}
#enter .gv-ticket__title{padding:26px 0 22px}
#enter .gv-ticket__title h2{font-size:48px}
#enter .gv-ticket__strip>div{padding:14px 4px}
#enter .gv-ticket__strip .gv-label{font-size:8px;letter-spacing:.18em;margin-bottom:8px}
#enter .gv-ticket__strip .gv-serif{font-size:15px;line-height:1.2}
#enter .gv-form__fields{gap:22px;margin-bottom:28px}
#enter .gv-form__submit{height:58px;letter-spacing:.22em}
#enter .gv-ticket__palm{height:200px;z-index:1;opacity:calc(var(--gv-palm-op,.4) * .8)}
#enter .gv-ticket__palm--l{left:-56px}
#enter .gv-ticket__palm--r{height:180px;right:-50px}
#enter .gv-stamp{top:auto;bottom:28px;right:20px}
}
</style>
<script>
(function(){
  var t = document.querySelector('[data-gv-ticket]');
  if (!t || t.__gv) return; t.__gv = true;
  var $ = function(s){ return t.querySelector(s); };
  var code = t.getAttribute('data-code') || 'ESTATE20';
  var KEY = 'gvSummerDraw2026';
  $('[data-gv-no]').textContent = String(Math.floor(10000 + Math.random() * 89999));

  function showDone(name, email){
    $('[data-gv-form-wrap]').hidden = true;
    $('[data-gv-name]').textContent = name;
    $('[data-gv-email]').textContent = email;
    $('[data-gv-done]').hidden = false;
    $('[data-gv-stubcode]').classList.remove('is-locked'); $('[data-gv-hint]').hidden = true;
    $('[data-gv-stamp]').hidden = false;
  }
  try { var saved = JSON.parse(localStorage.getItem(KEY) || 'null'); if (saved && saved.email) showDone(saved.name, saved.email); } catch(e) {}

  function checkClosed(){
    var close = window.__gvClose || new Date('2026-11-01T23:59:00+10:00').getTime();
    if (Date.now() >= close && $('[data-gv-done]').hidden) { $('[data-gv-form-wrap]').hidden = true; $('[data-gv-closed]').hidden = false; }
  }
  checkClosed(); setInterval(checkClosed, 30000);

  var form = $('[data-gv-form]'), err = $('[data-gv-error]'), btn = form.querySelector('button');
  function fail(msg){ err.textContent = msg; err.hidden = false; }
  form.addEventListener('input', function(){ err.hidden = true; });
  form.addEventListener('submit', function(e){
    e.preventDefault();
    var name = form.first_name.value.trim(), email = form.email.value.trim().toLowerCase();
    if (!name) return fail('Add your first name.');
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return fail('That email does not look quite right.');
    var first = name.split(' ')[0];
    btn.disabled = true;
    var company = t.getAttribute('data-company'), list = t.getAttribute('data-list');
    var headers = { 'content-type': 'application/vnd.api+json', 'revision': '2024-10-15' };
    var sub = fetch('https://a.klaviyo.com/client/subscriptions?company_id=' + encodeURIComponent(company), {
      method: 'POST', headers: headers,
      body: JSON.stringify({ data: { type: 'subscription', attributes: {
        custom_source: 'Summer Draw 2026 page',
        profile: { data: { type: 'profile', attributes: { email: email, first_name: first, properties: { 'Summer Draw 2026': true, 'Summer Draw Ticket': $('[data-gv-no]').textContent } } } }
      }, relationships: { list: { data: { type: 'list', id: list } } } } })
    });
    var ev = fetch('https://a.klaviyo.com/client/events?company_id=' + encodeURIComponent(company), {
      method: 'POST', headers: headers,
      body: JSON.stringify({ data: { type: 'event', attributes: {
        properties: { Ticket: $('[data-gv-no]').textContent, Code: code },
        metric: { data: { type: 'metric', attributes: { name: 'Entered Summer Draw' } } },
        profile: { data: { type: 'profile', attributes: { email: email, first_name: first } } }
      } } })
    });
    Promise.all([sub, ev]).then(function(r){
      if (!r[0].ok && r[0].status !== 202) throw new Error('sub');
      try { localStorage.setItem(KEY, JSON.stringify({ name: first, email: email })); } catch(e) {}
      showDone(first, email);
    }).catch(function(){
      btn.disabled = false;
      fail('Something went wrong on our side. Please try again in a moment.');
    });
  });

  t.addEventListener('click', function(e){
    var b = e.target.closest('[data-gv-copy]'); if (!b) return;
    try { navigator.clipboard.writeText(code); } catch(x) {}
    b.textContent = 'Copied'; setTimeout(function(){ b.textContent = 'Copy'; }, 2000);
  });
})();
</script>
{% schema %}
{
  "name": "Giveaway: ticket",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "script", "label": "Script line", "default": "your ticket to" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Summer Draw" },
    { "type": "text", "id": "cell1_label", "label": "Cell 1 label", "default": "Eleven pieces" },
    { "type": "text", "id": "cell1_value", "label": "Cell 1 value", "default": "Around $1,500" },
    { "type": "text", "id": "cell2_label", "label": "Cell 2 label", "default": "Entries close" },
    { "type": "text", "id": "cell2_value", "label": "Cell 2 value", "default": "Sunday 1 November" },
    { "type": "text", "id": "cell3_label", "label": "Cell 3 label", "default": "The draw" },
    { "type": "text", "id": "cell3_value", "label": "Cell 3 value", "default": "Monday 2 November" },
    { "type": "text", "id": "button", "label": "Button", "default": "Enter and get $20 off" },
    { "type": "textarea", "id": "fine", "label": "Fine print", "default": "Australian residents 18 and over. One ticket per person. Entering adds you to Guillo emails, and you can unsubscribe any time. Full terms below." },
    { "type": "text", "id": "code", "label": "Discount code", "default": "ESTATE20" },
    { "type": "text", "id": "spend_label", "label": "Button after entry", "default": "Use your $20" },
    { "type": "text", "id": "spend_path", "label": "Button after entry goes to", "default": "/collections", "info": "The code is applied automatically on the way." },
    { "type": "url", "id": "spend_url", "label": "Old link (not used)" },
    { "type": "textarea", "id": "closed_text", "label": "Closed message", "default": "Thank you to everyone who entered. The winner is drawn on Monday 2 November and will hear from us by email." },
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "map_image", "label": "Map background" },
    { "type": "text", "id": "map_position", "label": "Map focus", "default": "50% 50%" },
    { "type": "checkbox", "id": "show_palms", "label": "Show palm illustrations", "default": true },
    { "type": "range", "id": "palm_opacity", "label": "Palm strength", "min": 10, "max": 100, "step": 5, "unit": "%", "default": 40 },
    { "type": "header", "content": "Klaviyo" },
    { "type": "text", "id": "klaviyo_company_id", "label": "Klaviyo public key", "default": "YgJzQa" },
    { "type": "text", "id": "klaviyo_list_id", "label": "Klaviyo list ID", "default": "Txqz9w", "info": "List: Summer Draw 2026 - Entrants" }
  ],
  "presets": [{ "name": "Giveaway: ticket" }]
}
{% endschema %}
