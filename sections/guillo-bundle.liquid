{% comment %}
  "Build the three" split: full-bleed image beside a dark panel with
  numbered steps and a CTA. Steps are blocks.
{% endcomment %}

<section class="guillo-bundle{% if section.settings.flip %} guillo-bundle--flip{% endif %}" style="--bundle-ratio: {{ section.settings.image_ratio | default: '4 / 5' }}">
  <div class="guillo-bundle__media">
    {% render 'guillo-img',
      image: section.settings.image,
      fallback: 'guillo-bone-pool.jpg',
      alt: section.settings.image_alt,
      class: 'guillo-bundle__img',
      sizes: '(min-width: 750px) 50vw, 100vw',
      position: section.settings.image_position
    %}
  </div>
  <div class="guillo-bundle__panel">
    {%- if section.settings.eyebrow != blank -%}
      <span class="guillo-bundle__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h2 class="guillo-bundle__heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="guillo-bundle__text">{{ section.settings.text }}</p>
    {%- endif -%}
    <div class="guillo-bundle__steps">
      {%- for block in section.blocks -%}
        <div class="guillo-bundle__step" {{ block.shopify_attributes }}>
          <span class="guillo-bundle__num">{{ forloop.index | prepend: '0' }}</span>
          <div>
            <div class="guillo-bundle__step-title">{{ block.settings.title }}</div>
            <div class="guillo-bundle__step-text">{{ block.settings.text }}</div>
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_link }}" class="g-btn g-btn--light guillo-bundle__cta">
        {{- section.settings.cta_label -}}
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .guillo-bundle {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--g-ink);
    color: var(--g-off);
  }
  .guillo-bundle--flip .guillo-bundle__media { order: 2; }
  /* The media column takes a shape rather than a fixed height, so a portrait
     photograph is not cropped top and bottom to fill a landscape box. */
  .guillo-bundle__media {
    position: relative;
    aspect-ratio: var(--bundle-ratio, 4 / 5);
    min-height: 520px;
  }
  .guillo-bundle__img,
  .guillo-bundle__media svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .guillo-bundle__panel {
    padding: 96px 88px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .guillo-bundle__eyebrow {
    font: 500 10px/1 var(--g-sans);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--g-faint);
    margin-bottom: 22px;
  }
  .guillo-bundle__heading {
    font: 500 clamp(34px, 3.6vw, 54px)/1.04 var(--g-serif);
    letter-spacing: -0.004em;
    margin: 0 0 20px;
    color: #fff;
  }
  .guillo-bundle__text {
    font: 300 16px/1.7 var(--g-sans);
    color: var(--g-dark-body);
    margin: 0 0 40px;
    max-width: 460px;
  }
  .guillo-bundle__steps {
    display: flex;
    flex-direction: column;
    margin-bottom: 40px;
    border-top: 1px solid var(--g-dark-line);
  }
  .guillo-bundle__step {
    display: flex;
    gap: 22px;
    padding: 20px 0;
    border-bottom: 1px solid var(--g-dark-line);
  }
  .guillo-bundle__num {
    font: 400 12px/1 var(--g-sans);
    letter-spacing: 0.1em;
    color: #75777D;
    padding-top: 3px;
  }
  .guillo-bundle__step-title {
    font: 400 16px/1.4 var(--g-sans);
    color: var(--g-off);
    margin-bottom: 5px;
  }
  .guillo-bundle__step-text {
    font: 300 13px/1.6 var(--g-sans);
    color: var(--g-faint);
  }
  .guillo-bundle__cta { align-self: flex-start; }
  @media screen and (max-width: 989px) {
    .guillo-bundle { grid-template-columns: 1fr; }
    .guillo-bundle--flip .guillo-bundle__media { order: 0; }
    .guillo-bundle__media { min-height: 68vw; }
    .guillo-bundle__panel { padding: 56px 24px 64px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Guillo bundle story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Man in a black pinstripe Milano shirt and bone Luxe Chino"
    },
    {
      "type": "text",
      "id": "image_position",
      "label": "Image focal point",
      "default": "center 24%"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "default": "4 / 5",
      "info": "Portrait shapes keep a standing figure in frame instead of cropping the head and feet.",
      "options": [
        {
          "value": "4 / 5",
          "label": "Portrait 4:5"
        },
        {
          "value": "3 / 4",
          "label": "Portrait 3:4"
        },
        {
          "value": "2 / 3",
          "label": "Portrait 2:3"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "3 / 2",
          "label": "Landscape 3:2"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "flip",
      "label": "Image on the right",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Build the three"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Three pieces is a week of dressing solved."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Two chinos and a shirt covers a working week or a week away without a single decision. Take any three and 15% comes off at checkout."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Start with the chinos"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pick your two chinos"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Chocolate and Olive is the pairing most men come back for."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Guillo bundle story",
      "category": "Guillo",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Pick your two chinos",
            "text": "Chocolate and Olive is the pairing most men come back for."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Add a shirt or a polo",
            "text": "White Amalfi works over every colourway in the range."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "15% comes off automatically",
            "text": "No code. Applied in the bag the moment the third piece lands."
          }
        }
      ]
    }
  ]
}
{% endschema %}

