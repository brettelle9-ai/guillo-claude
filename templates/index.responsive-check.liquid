{% layout none %}
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Guillo responsive draft preview</title><style>body{margin:0;background:#e8e8e6;font:13px Arial,sans-serif;color:#222}header{height:54px;display:flex;justify-content:center;align-items:center;gap:10px}button{background:#fff;border:1px solid #ccc;border-radius:3px;padding:8px 14px;cursor:pointer}button[aria-pressed=true]{background:#222;color:#fff}iframe{display:block;width:390px;max-width:100%;height:844px;border:0;background:#fff;margin:0 auto 30px;box-shadow:0 5px 30px #0002}p{text-align:center;font-size:11px;color:#777}</style></head><body><header><button type="button" data-width="390" aria-pressed="true">Mobile · 390px</button><button type="button" data-width="768" aria-pressed="false">Tablet · 768px</button><button type="button" data-width="1280" aria-pressed="false">Desktop · 1280px</button></header><iframe title="Guillo homepage at selected screen width" allow="autoplay"></iframe><p>Draft preview · scroll inside the page to review every section</p><script>fetch('/?pb=0').then(response=>response.text()).then(html=>{document.querySelector('iframe').srcdoc=html;});document.querySelectorAll('button[data-width]').forEach(button=>button.addEventListener('click',()=>{document.querySelector('iframe').style.width=button.dataset.width+'px';document.querySelectorAll('button').forEach(other=>other.setAttribute('aria-pressed',String(other===button)));}));</script></body></html>
